<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Blog | Admin</title>
  <meta name="robots" content="noindex, nofollow">
  <link rel="stylesheet" href="/css/tailwind.css" />
  <style>
    body { font-family: system-ui, -apple-system, sans-serif; }
  </style>
</head>
<body class="bg-gray-50 text-gray-900 antialiased">
<%- include('partials/nav', { pageTitle: 'Edit Blog', user }) %>

  <main class="min-h-screen">
    <div class="max-w-5xl mx-auto p-3 sm:p-6">
      <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between sm:flex-wrap">
        <div>
          <h1 class="text-3xl font-bold text-gray-900">Edit Blog</h1>
          <p class="text-sm text-gray-500 mt-1">Update your blog post content and metadata.</p>
        </div>
        <a href="/admin/blogs" class="text-gray-600 hover:text-gray-900 flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          Back to List
        </a>
      </div>

      <form id="editBlogForm" action="/admin/blogs/edit/<%= blog._id %>" method="POST" enctype="multipart/form-data" class="space-y-6">
        <div id="formMessage" class="hidden rounded-lg p-4"></div>

        <section class="bg-white rounded-xl shadow-sm border border-gray-200 p-3 sm:p-6 space-y-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
            Blog Details
          </h3>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2" for="title">Title</label>
            <input id="title" name="title" required value="<%= blog.title %>" class="w-full rounded-lg border border-gray-300 px-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition" />
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2" for="slug">Slug</label>
            <input id="slug" name="slug" required value="<%= blog.slug %>" class="w-full rounded-lg border border-gray-300 px-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition" />
            <p class="mt-1 text-xs text-gray-500">Unique slug for the blog URL.</p>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2" for="excerpt">Excerpt</label>
            <textarea id="excerpt" name="excerpt" rows="4" class="w-full rounded-lg border border-gray-300 px-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition resize-none"><%= blog.excerpt %></textarea>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2" for="layout">Page Layout</label>
            <select id="layout" name="layout" class="w-full rounded-lg border border-gray-300 px-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition bg-white">
              <option value="feature" <%= (blog.layout || 'feature') === 'feature' ? 'selected' : '' %>>Featured hero layout</option>
              <option value="standard" <%= blog.layout === 'standard' ? 'selected' : '' %>>Standard article layout</option>
              <option value="magazine" <%= blog.layout === 'magazine' ? 'selected' : '' %>>Magazine style layout</option>
            </select>
            <p class="mt-1 text-xs text-gray-500">Featured uses the visual hero, standard keeps it simple, and magazine is editorial.</p>
          </div>
        </section>

        <section class="bg-white rounded-xl shadow-sm border border-gray-200 p-3 sm:p-6 space-y-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            Cover Image
          </h3>

          <% if (blog.coverImage) { %>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Current Cover Image</label>
              <img src="<%= blog.coverImage %>" alt="Current blog cover" class="h-48 w-full rounded-lg object-cover border border-gray-200" />
            </div>
          <% } %>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2" for="coverImageFile">Replace Cover Image</label>
            <div class="rounded-lg border-2 border-dashed border-gray-300 p-4 sm:p-6">
              <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <div>
                  <p class="text-sm font-medium text-gray-700">Upload a new cover image</p>
                  <p class="text-sm text-gray-500">PNG, JPG, or WEBP. This will replace the current image.</p>
                </div>
                <label for="coverImageFile" class="inline-flex cursor-pointer items-center justify-center rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-medium text-white hover:bg-blue-700 transition">
                  Choose image
                </label>
              </div>

              <input id="coverImageFile" name="coverImageFile" type="file" accept="image/*" class="sr-only" />
              <div id="coverImageName" class="mt-3 text-sm text-gray-500">No file selected</div>
            </div>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2" for="coverImage">Or use an image URL</label>
            <input id="coverImage" name="coverImage" value="<%= blog.coverImage %>" class="w-full rounded-lg border border-gray-300 px-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition" />
          </div>
        </section>

        <section class="bg-white rounded-xl shadow-sm border border-gray-200 p-3 sm:p-6 space-y-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16h8M8 12h8M8 8h8"/>
            </svg>
            Blog Content
          </h3>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2" for="inlineImageFile">Insert image into content</label>
            <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between sm:flex-wrap">
              <button id="insertImageBtn" type="button" class="inline-flex items-center justify-center rounded-lg bg-gray-200 px-4 py-2.5 text-gray-700 hover:bg-gray-300 transition">Upload & insert image</button>
              <div id="inlineImageName" class="text-sm text-gray-500">No file selected</div>
            </div>
            <input id="inlineImageFile" name="inlineImageFile" type="file" accept="image/*" class="sr-only" />
            <p class="mt-1 text-xs text-gray-500">Uploads will be processed and inserted as an <code>&lt;img&gt;</code> tag into the content.</p>
          </div>

          <div>
            <div class="flex items-center justify-between mb-2">
              <label class="block text-sm font-medium text-gray-700" for="content">Content</label>
              <button type="button" id="assistBtn"
                class="px-3 py-1 text-xs font-medium text-blue-600 hover:text-blue-700 hover:bg-blue-50 rounded-lg transition flex items-center gap-1"
                onclick="generateBlogDraft()">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                </svg>
                AI Assist
              </button>
            </div>
            <textarea id="content" name="content" rows="12" required class="w-full rounded-lg border border-gray-300 px-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition resize-none"><%= blog.content %></textarea>
          </div>
        </section>

        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 bg-white rounded-xl shadow-sm border border-gray-200 p-3 sm:p-6">
          <a href="/admin/blogs" class="w-full sm:w-auto px-6 py-2.5 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition font-medium text-center">
            Cancel
          </a>

          <button type="submit" class="w-full sm:w-auto inline-flex items-center justify-center rounded-lg bg-blue-600 px-8 py-2.5 text-white hover:bg-blue-700 transition shadow-sm font-medium">
            Save Changes
          </button>
        </div>
      </form>
    </div>
  </main>
  <script>
    const form = document.getElementById('editBlogForm');
    const formMessage = document.getElementById('formMessage');
    const titleInput = document.getElementById('title');
    const slugInput = document.getElementById('slug');
    const coverInput = document.getElementById('coverImageFile');
    const coverName = document.getElementById('coverImageName');
    const inlineImageInput = document.getElementById('inlineImageFile');
    const inlineImageBtn = document.getElementById('insertImageBtn');
    const inlineImageName = document.getElementById('inlineImageName');
    const contentTextarea = document.getElementById('content');
    const assistBtn = document.getElementById('assistBtn');
    const insertImageBtnDefaultHtml = inlineImageBtn ? inlineImageBtn.innerHTML : '';
    let slugEditedManually = false;

    function toSlug(value) {
      return (value || '')
        .toLowerCase()
        .trim()
        .replace(/[^a-z0-9\s-]/g, '')
        .replace(/\s+/g, '-')
        .replace(/-+/g, '-');
    }

    // Show message
    function showMessage(message, type) {
      formMessage.textContent = message;
      formMessage.className = `rounded-lg p-4 mb-6 ${type === 'success' ? 'bg-green-50 text-green-800 border border-green-200' : 'bg-red-50 text-red-800 border border-red-200'}`;
      formMessage.classList.remove('hidden');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // Form submission with feedback
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const submitBtn = form.querySelector('button[type="submit"]');
      const originalText = submitBtn.textContent;
      submitBtn.disabled = true;
      submitBtn.textContent = 'Saving...';

      try {
        const formData = new FormData(form);
        const response = await fetch(form.action, {
          method: 'POST',
          body: formData
        });

        if (!response.ok) {
          const errorText = await response.text();
          showMessage(`Error: ${errorText}`, 'error');
          return;
        }

        showMessage('Blog post saved successfully! Redirecting...', 'success');
        setTimeout(() => {
          window.location.href = '/admin/blogs';
        }, 1500);
      } catch (err) {
        showMessage(`Error saving blog: ${err.message}`, 'error');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = originalText;
      }
    });

    if (coverInput && coverName) {
      coverInput.addEventListener('change', () => {
        coverName.textContent = coverInput.files?.[0] ? coverInput.files[0].name : 'No file selected';
      });
    }

    if (slugInput && titleInput) {
      slugInput.addEventListener('input', () => {
        slugEditedManually = slugInput.value.trim().length > 0;
      });

      titleInput.addEventListener('input', () => {
        if (slugEditedManually) return;
        slugInput.value = toSlug(titleInput.value);
      });

      slugInput.addEventListener('blur', () => {
        slugInput.value = toSlug(slugInput.value);
      });
    }

    if (inlineImageBtn && inlineImageInput && inlineImageName && contentTextarea) {
      inlineImageBtn.addEventListener('click', () => inlineImageInput.click());

      inlineImageInput.addEventListener('change', async () => {
        const file = inlineImageInput.files?.[0];
        inlineImageName.textContent = file ? file.name : 'No file selected';
        if (!file) return;

        const formData = new FormData();
        formData.append('image', file);
        formData.append('blogId', '<%= blog._id %>');

        inlineImageBtn.disabled = true;
        inlineImageBtn.textContent = 'Uploading...';

        try {
          const response = await fetch('/admin/blogs/upload-image', {
            method: 'POST',
            body: formData
          });
          const data = await response.json();
          if (!response.ok) {
            throw new Error(data.error || 'Upload failed');
          }
          const imageUrl = data.url;
          const imgTag = `<img src="${imageUrl}" alt="Blog image" />`;
          const startPos = contentTextarea.selectionStart || 0;
          const endPos = contentTextarea.selectionEnd || 0;
          const before = contentTextarea.value.substring(0, startPos);
          const after = contentTextarea.value.substring(endPos);
          contentTextarea.value = `${before}${imgTag}${after}`;
          contentTextarea.focus();
          contentTextarea.selectionStart = contentTextarea.selectionEnd = before.length + imgTag.length;
          showMessage('Image inserted successfully!', 'success');
        } catch (err) {
          console.error(err);
          showMessage(`Image upload failed: ${err.message}`, 'error');
        } finally {
          inlineImageBtn.disabled = false;
          inlineImageBtn.innerHTML = insertImageBtnDefaultHtml;
        }
      });
    }

    async function generateBlogDraft() {
      const title = document.getElementById('title').value.trim();
      const excerpt = document.getElementById('excerpt').value.trim();
      const topic = document.getElementById('content').value.trim();

      if (!title && !excerpt && !topic) {
        alert('Please add a title, excerpt, or some content context before using AI Assist.');
        return;
      }

      if (!assistBtn) return;
      assistBtn.disabled = true;
      assistBtn.innerHTML = '<svg class="w-4 h-4 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg> Generating...';

      try {
        const response = await fetch('/admin/blogs/ai-assist', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title, excerpt, topic })
        });

        const data = await response.json();
        if (!response.ok) throw new Error(data.error || 'Generation failed');

        if (data.content) {
          contentTextarea.value = data.content;
          contentTextarea.focus();
          showMessage('AI draft generated. Review and save when ready.', 'success');
        }
      } catch (err) {
        showMessage(err.message || 'AI generation failed.', 'error');
      } finally {
        assistBtn.disabled = false;
        assistBtn.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg> AI Assist';
      }
    }
  </script>
</body>
</html>
