<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Manage Blogs | Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">
  <div class="max-w-5xl mx-auto py-10">
    <h1 class="text-2xl font-bold mb-6">Manage Blogs</h1>

    <a href="/admin/blogs/new" class="inline-block bg-blue-600 text-white px-4 py-2 rounded-lg mb-6">+ New Blog</a>

    <div class="bg-white shadow rounded-lg overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-2 text-left text-sm font-medium text-gray-500">Title</th>
            <th class="px-4 py-2 text-left text-sm font-medium text-gray-500">Slug</th>
            <th class="px-4 py-2 text-right text-sm font-medium text-gray-500">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% blogs.forEach(blog => { %>
            <tr>
              <td class="px-4 py-2"><%= blog.title %></td>
              <td class="px-4 py-2 text-gray-500"><%= blog.slug %></td>
              <td class="px-4 py-2 text-right space-x-2">
                <a href="/admin/blogs/edit/<%= blog._id %>" class="text-blue-600 hover:underline">Edit</a>
                <form action="/admin/blogs/delete/<%= blog._id %>" method="POST" class="inline">
                  <button type="submit" class="text-red-600 hover:underline">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</body>
</html>
