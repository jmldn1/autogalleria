<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || "Admin Dashboard" %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="bg-gray-100 font-sans text-gray-800 flex">

  <!-- Sidebar -->
  <aside class="w-64 bg-white border-r h-screen fixed flex flex-col">
    <div class="p-6 text-center font-bold text-xl text-blue-600 border-b">Admin Panel</div>
    <nav class="flex-1 px-4 py-6 space-y-2">
      <a href="/admin/dashboard" class="block px-4 py-2 rounded-lg hover:bg-blue-50 hover:text-blue-600">Dashboard</a>
      <a href="/admin/landing" class="block px-4 py-2 rounded-lg hover:bg-blue-50 hover:text-blue-600">Landing Pages</a>
      <a href="/admin/cars" class="block px-4 py-2 rounded-lg hover:bg-blue-50 hover:text-blue-600">Cars</a>
      <a href="/admin/blogs" class="block px-4 py-2 rounded-lg hover:bg-blue-50 hover:text-blue-600">Blog</a>
      <a href="/admin/settings" class="block px-4 py-2 rounded-lg hover:bg-blue-50 hover:text-blue-600">Settings</a>
      <a href="/logout" class="block px-4 py-2 rounded-lg hover:bg-red-50 hover:text-red-600">Logout</a>
    </nav>
  </aside>

  <!-- Main content -->
  <div class="flex-1 ml-64 min-h-screen flex flex-col">
    
    <!-- Top bar -->
    <header class="bg-white border-b p-4 flex justify-between items-center shadow-sm">
      <h1 class="text-xl font-bold"><%= pageTitle || "Dashboard" %></h1>
      <div class="flex items-center space-x-4">
        <span class="text-gray-600">Admin</span>
        <img src="/images/avatar.png" alt="Avatar" class="h-8 w-8 rounded-full">
      </div>
    </header>

    <!-- Page content -->
    <main class="flex-1 p-6">
      <%- body %>
    </main>
  </div>

</body>
</html>
