<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= landing._id ? `Edit ${landing.make || ''} ${landing.model || ''}` : 'Add New Landing' %> | Admin
  </title>
  <meta name="robots" content="noindex, nofollow">
  <link rel="stylesheet" href="/css/tailwind.css" />
  <style>
    body { font-family: system-ui, -apple-system, sans-serif; }
  </style>
</head>
<body class="flex min-h-screen flex-col bg-gray-50 text-gray-900 antialiased">

<%- include('partials/nav', { pageTitle: landing._id ? 'Edit Landing' : 'New Landing', user }) %>

  <!-- Page Content -->
  <main class="flex-1">
    <div class="max-w-5xl mx-auto p-3 sm:p-6">

      <div class="mb-6 flex items-center justify-between">
        <h2 class="text-3xl font-bold text-gray-900"><%= landing._id ? 'Edit Landing Page' : 'Add New Landing Page' %></h2>
        <a href="/admin/landings" class="text-gray-600 hover:text-gray-900 flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          Back to List
        </a>
      </div>

      <% const landingAction = landing._id ? '/admin/landing/' + landing.id : '/admin/landing'; %>
      <form action="<%= landingAction %>" method="POST" enctype="multipart/form-data" class="space-y-6">

        <!-- Basic Information Section -->
        <section class="bg-white rounded-xl shadow-sm border border-gray-200 p-3 sm:p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            Basic Information
          </h3>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Make *</label>
              <input id="make" type="text" name="make" value="<%= landing.make || '' %>" required
                     class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition"
                     placeholder="e.g., BMW">
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Model *</label>
              <input id="model" type="text" name="model" value="<%= landing.model || '' %>" required
                     class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition"
                     placeholder="e.g., 3 Series">
            </div>

            <div class="md:col-span-2">
              <label class="block text-sm font-medium text-gray-700 mb-2">Slug *</label>
              <input id="slug" type="text" name="slug" value="<%= landing.slug || '' %>" required
                     class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition"
                     placeholder="auto-generated-from-make-model">
              <p class="text-xs text-gray-500 mt-1">Auto-updates from Make and Model unless you edit it manually.</p>
            </div>
          </div>
        </section>

        <!-- Hero Image Section -->
        <section class="bg-white rounded-xl shadow-sm border border-gray-200 p-3 sm:p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            Hero Image
          </h3>

          <div class="space-y-4">
            <% if (landing.imageManifest && landing.imageManifest.sources && landing.imageManifest.sources.jpg) { %>
              <div>
                <p class="text-sm font-medium text-gray-700 mb-3">Current Image</p>
                <img src="<%= landing.imageManifest.sources.jpg[0].url %>" alt="Current Hero Image" class="w-full max-w-xs h-32 object-cover rounded-lg border-2 border-gray-200">
              </div>
            <% } else if (landing.imagePath) { %>
              <div>
                <p class="text-sm font-medium text-gray-700 mb-3">Current Image</p>
                <img src="<%= landing.imagePath %>.jpg" alt="Current Hero Image" class="w-full max-w-xs h-32 object-cover rounded-lg border-2 border-gray-200">
              </div>
            <% } %>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-3">
                <%= landing.imagePath || landing.imageManifest ? 'Replace Image' : 'Upload Image' %>
              </label>
              <div class="border-2 border-dashed border-gray-300 rounded-lg p-8 text-center hover:border-blue-400 transition cursor-pointer"
                   onclick="document.getElementById('heroImageInput').click()">
                <svg class="w-12 h-12 text-gray-400 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                </svg>
                <p class="text-sm text-gray-600 mb-1">Click to upload an image or drag and drop</p>
                <p class="text-xs text-gray-500">PNG, JPG, WEBP up to 10MB</p>
              </div>

              <input type="file" id="heroImageInput" name="image" accept="image/*"
                     class="hidden"
                     onchange="previewHeroImage(this)">

              <div id="heroImagePreview" class="mt-4"></div>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Hero Image Alt Text</label>
              <input type="text" name="heroAltText" value="<%= landing.heroAltText || '' %>"
                     class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition"
                     placeholder="Photo of {{make}} {{model}}">
              <p class="text-xs text-gray-500 mt-1">Describe the hero image for accessibility and search relevance.</p>
            </div>
          </div>
        </section>

        <!-- Description & AI Copy Section -->
        <section class="bg-white rounded-xl shadow-sm border border-gray-200 p-3 sm:p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"/>
            </svg>
            Description & Body Copy
          </h3>

          <div class="space-y-6">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Meta Description</label>
              <textarea name="description" id="descriptionInput" rows="3"
                        class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition resize-none"
                        placeholder="Short SEO summary for this landing page"><%= landing.description || '' %></textarea>
            </div>

            <div class="flex items-center justify-between">
              <p id="generateError" class="hidden text-sm text-red-600"></p>
              <p id="generateStatus" class="hidden text-sm text-green-600">AI content generated successfully.</p>
              <button type="button" id="generateBtn"
                      class="px-3 py-1 text-xs font-medium text-blue-600 hover:text-blue-700 hover:bg-blue-50 rounded-lg transition flex items-center gap-1 ml-auto disabled:opacity-50 disabled:cursor-not-allowed">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                </svg>
                <span id="generateBtnText">AI Assist</span>
              </button>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Overview</label>
              <textarea name="overview" id="field-overview" rows="3"
                        class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition resize-none"><%= landing.overview || '' %></textarea>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Value Factors</label>
              <textarea name="valueFactors" id="field-valueFactors" rows="3"
                        class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition resize-none"><%= landing.valueFactors || '' %></textarea>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Selling Tips</label>
              <textarea name="sellingTips" id="field-sellingTips" rows="3"
                        class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition resize-none"><%= landing.sellingTips || '' %></textarea>
            </div>

            <div class="pt-2 border-t border-gray-100">
              <p class="text-sm font-medium text-gray-700 mb-1">Model-Specific FAQ Answers</p>
              <p class="text-xs text-gray-500 mb-4">Leave blank to use the generic answer for these questions.</p>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">"How quickly can I sell my <%= landing.make || 'this' %> <%= landing.model || 'car' %>?"</label>
              <textarea name="faqQuickSale" id="field-faqQuickSale" rows="2"
                        class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition resize-none"><%= landing.faqQuickSale || '' %></textarea>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">"Do you buy non UK registration <%= landing.make || 'this' %> <%= landing.model || 'car' %>?"</label>
              <textarea name="faqNonUk" id="field-faqNonUk" rows="2"
                        class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition resize-none"><%= landing.faqNonUk || '' %></textarea>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">"Do you buy non-running <%= landing.make || 'this' %> cars?"</label>
              <textarea name="faqNonRunning" id="field-faqNonRunning" rows="2"
                        class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition resize-none"><%= landing.faqNonRunning || '' %></textarea>
            </div>
          </div>
        </section>

        <!-- Action Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 bg-white rounded-xl shadow-sm border border-gray-200 p-3 sm:p-6">
          <a href="/admin/landings" class="w-full sm:w-auto px-6 py-2.5 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition font-medium text-center">
            Cancel
          </a>
          <button type="submit"
                  class="w-full sm:w-auto px-8 py-2.5 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition shadow-sm font-medium flex items-center justify-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            Save Landing Page
          </button>
        </div>
      </form>
    </div>
  </main>
  <%- include('partials/footer') %>

<script>
  const makeInput = document.getElementById('make');
  const modelInput = document.getElementById('model');
  const slugInput = document.getElementById('slug');
  let slugEditedManually = false;

  function toSlug(value) {
    return (value || '')
      .toLowerCase()
      .trim()
      .replace(/[^a-z0-9\s-]/g, '')
      .replace(/\s+/g, '-')
      .replace(/-+/g, '-');
  }

  function buildLandingSlugFromFields() {
    return toSlug([
      makeInput?.value || '',
      modelInput?.value || ''
    ].filter(Boolean).join(' '));
  }

  function isLikelyAutoGeneratedSlug(existingSlug, generatedBase) {
    if (!existingSlug || !generatedBase) return !existingSlug;
    return existingSlug === generatedBase || existingSlug.startsWith(`${generatedBase}-`);
  }

  if (slugInput && makeInput && modelInput) {
    const initialGenerated = buildLandingSlugFromFields();
    const initialSlug = (slugInput.value || '').trim();
    slugEditedManually = initialSlug.length > 0 && !isLikelyAutoGeneratedSlug(initialSlug, initialGenerated);

    if (!initialSlug && initialGenerated) {
      slugInput.value = initialGenerated;
    }

    slugInput.addEventListener('input', () => {
      const generated = buildLandingSlugFromFields();
      const current = (slugInput.value || '').trim();
      slugEditedManually = current.length > 0 && current !== generated;
    });

    slugInput.addEventListener('blur', () => {
      slugInput.value = toSlug(slugInput.value);
    });

    [makeInput, modelInput].forEach((field) => {
      field.addEventListener('input', () => {
        if (slugEditedManually) return;
        slugInput.value = buildLandingSlugFromFields();
      });
    });
  }

  function previewHeroImage(input) {
    const preview = document.getElementById('heroImagePreview');
    preview.innerHTML = '';

    if (input.files && input.files[0]) {
      const reader = new FileReader();
      reader.onload = function (e) {
        preview.innerHTML = `
          <p class="text-sm font-medium text-gray-700 mb-2">New Image Preview</p>
          <img src="${e.target.result}" class="w-full max-w-xs h-32 object-cover rounded-lg border-2 border-green-200">
        `;
      };
      reader.readAsDataURL(input.files[0]);
    }
  }

  const generateBtn = document.getElementById('generateBtn');
  const generateBtnText = document.getElementById('generateBtnText');
  const generateError = document.getElementById('generateError');
  const generateStatus = document.getElementById('generateStatus');

  generateBtn.addEventListener('click', async () => {
    const make = makeInput.value.trim();
    const model = modelInput.value.trim();

    generateError.classList.add('hidden');
    generateStatus.classList.add('hidden');

    if (!make || !model) {
      generateError.textContent = 'Enter make and model first.';
      generateError.classList.remove('hidden');
      return;
    }

    generateBtn.disabled = true;
    generateBtnText.textContent = 'Generating…';

    const controller = new AbortController();
    const clientTimeout = setTimeout(() => controller.abort(), 25000);

    try {
      const res = await fetch('/admin/landing/generate-copy', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ make, model }),
        signal: controller.signal
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Generation failed');

      document.getElementById('field-overview').value = data.overview || '';
      document.getElementById('field-valueFactors').value = data.valueFactors || '';
      document.getElementById('field-sellingTips').value = data.sellingTips || '';
      document.getElementById('field-faqQuickSale').value = data.faqQuickSale || '';
      document.getElementById('field-faqNonUk').value = data.faqNonUk || '';
      document.getElementById('field-faqNonRunning').value = data.faqNonRunning || '';

      const descField = document.getElementById('descriptionInput');
      if (!descField.value.trim() && data.metaDescription) {
        descField.value = data.metaDescription;
      }

      generateStatus.textContent = 'AI content filled successfully. Save to persist it.';
      generateStatus.classList.remove('hidden');
    } catch (err) {
      generateError.textContent = err.name === 'AbortError' ? 'AI request timed out. Please try again.' : err.message;
      generateError.classList.remove('hidden');
    } finally {
      clearTimeout(clientTimeout);
      generateBtn.disabled = false;
      generateBtnText.textContent = 'AI Assist';
    }
  });
</script>
</body>
</html>
