<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Manage Landings | Auto Galleria</title>
  <link href="/css/tailwind.css" rel="stylesheet">
</head>

<body class="bg-gray-100 text-gray-800">
  <main class="max-w-7xl mx-auto p-6">
    <div class="mx-auto max-w-7xl">
      <%- include('partials/nav', { pageTitle: 'Landings', user }) %>
    </div>
    <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h1 class="text-2xl font-bold">Manage Landings</h1>
        <p class="mt-1 text-sm text-gray-500">Create and update landing pages for your sales funnels.</p>
      </div>
      <a href="/admin/landing/new"
         class="inline-flex items-center justify-center rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-blue-700">
        + Add New Landing
      </a>
    </div>

    <% if (landings.length === 0) { %>
      <div class="rounded-lg border border-dashed border-gray-300 bg-white p-8 text-center text-gray-500">
        No landings found.
      </div>
    <% } else { %>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
        <% landings.forEach(landing => { %>
          <div
            onclick="window.location='/admin/landing/<%= landing._id %>/edit'"
            class="flex flex-col rounded-lg bg-white p-4 shadow transition hover:shadow-lg cursor-pointer"
          >
            <div class="mb-4">
              <% const sources = landing.imageManifest?.sources; %>
              <% const avifSrcset = sources?.avif?.map(src => `${src.url} ${src.w}w`).join(', '); %>
              <% const webpSrcset = sources?.webp?.map(src => `${src.url} ${src.w}w`).join(', '); %>
              <% const jpgSrcset = sources?.jpg?.map(src => `${src.url} ${src.w}w`).join(', '); %>
              <% const jpgSrc = sources?.jpg?.[sources?.jpg?.length - 1]?.url; %>
              <% if (avifSrcset || webpSrcset || jpgSrcset) { %>
                <picture>
                  <% if (avifSrcset) { %>
                    <source type="image/avif" srcset="<%= avifSrcset %>" sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 25vw">
                  <% } %>
                  <% if (webpSrcset) { %>
                    <source type="image/webp" srcset="<%= webpSrcset %>" sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 25vw">
                  <% } %>
                  <img src="<%= jpgSrc || landing.imagePath + '.jpg' %>"
                       srcset="<%= jpgSrcset %>"
                       sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 25vw"
                       class="h-32 w-full rounded object-cover shadow transition hover:scale-[1.03]"
                       alt="Landing thumbnail">
                </picture>
              <% } else if (landing.imagePath) { %>
                <img src="<%= landing.imagePath %>.jpg"
                     class="h-32 w-full rounded object-cover shadow transition hover:scale-[1.03]"
                     alt="Landing thumbnail">
              <% } else { %>
                <div class="flex h-32 w-full items-center justify-center rounded bg-gray-200 text-gray-500">
                  No Image
                </div>
              <% } %>
            </div>

            <div class="flex-1">
              <div class="flex items-start justify-between gap-2">
                <h3 class="font-semibold text-gray-800">
                  <%= landing.make %> <%= landing.model %>
                </h3>
                <span class="rounded bg-gray-100 px-2 py-1 text-xs text-gray-700" title="Landing reference">
                  Ref <%= landing._id.toString().slice(-4) %>
                </span>
              </div>
              <p class="mt-2 text-sm text-gray-500">Slug: <%= landing.slug %></p>
            </div>

            <div class="mt-4 flex flex-wrap items-center justify-between gap-2 pt-2">
              <div class="flex flex-wrap gap-2">
                <a href="/admin/landing/<%= landing._id %>/edit"
                   onclick="event.stopPropagation()"
                   class="text-blue-600 hover:underline">
                  Edit
                </a>
                <form action="/admin/landing/<%= landing._id %>/delete"
                      method="POST"
                      class="inline"
                      onclick="event.stopPropagation()"
                      onsubmit="event.stopPropagation(); return confirm('Are you sure you want to delete this landing?');">
                  <button type="submit"
                          onclick="event.stopPropagation()"
                          class="bg-transparent p-0 text-red-600 hover:underline border-0 cursor-pointer">
                    Delete
                  </button>
                </form>
              </div>
              <div class="flex items-center gap-2">
                <span class="inline-flex items-center gap-1 rounded-full bg-gray-100 px-2.5 py-1 text-xs font-medium text-gray-700">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7Z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                  </svg>
                  <span><%= landing.views ?? 0 %> views</span>
                </span>
                <a href="/sell-your-<%= landing.slug %>"
                   target="_blank"
                   onclick="event.stopPropagation()"
                   class="rounded bg-blue-600 px-3 py-1 text-sm text-white transition hover:bg-blue-700">
                  View
                </a>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>

    <a href="/admin/dashboard" class="mt-8 inline-flex items-center gap-2 rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-blue-700">
      <span aria-hidden="true">←</span>
      <span>Back to Dashboard</span>
    </a>
  </main>
</body>
</html>