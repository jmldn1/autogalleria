<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Manage Landings | Auto Galleria</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 p-6">

  <h1 class="text-2xl font-bold mb-6">Manage Landings</h1>

  <a href="/admin/landing/new" 
     class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded mb-6 inline-block">
     + Add New Landing
  </a>

  <!-- Desktop table -->
  <div class="hidden md:block overflow-x-auto">
    <table class="min-w-full bg-white shadow rounded">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left">Make</th>
          <th class="px-6 py-3 text-left">Model</th>
          <th class="px-6 py-3 text-left">Slug</th>
          <th class="px-6 py-3 text-left">Image</th>
          <th class="px-6 py-3 text-left">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (landings.length === 0) { %>
          <tr>
            <td colspan="5" class="px-6 py-4 text-center text-gray-500">
              No landings found.
            </td>
          </tr>
        <% } %>
        <% landings.forEach(landing => { %>
          <tr class="hover:bg-gray-100">
            <td class="px-6 py-4"><%= landing.make %></td>
            <td class="px-6 py-4"><%= landing.model %></td>
            <td class="px-6 py-4"><%= landing.slug %></td>
            <td class="px-6 py-4">
              <% if (landing.imageManifest?.sources?.jpg) { %>
                <img src="<%= landing.imageManifest.sources.jpg[0].url %>" 
                     class="w-20 h-12 object-cover rounded shadow" 
                     alt="Landing thumbnail">
              <% } else if (landing.imagePath) { %>
                <img src="<%= landing.imagePath %>.jpg" 
                     class="w-20 h-12 object-cover rounded shadow" 
                     alt="Landing thumbnail">
              <% } else { %>
                -
              <% } %>
            </td>
            <td class="px-6 py-4 space-x-2">
              <a href="/admin/landing/<%= landing._id %>/edit" class="text-blue-600 hover:underline">Edit</a>
              <form action="/admin/landing/<%= landing._id %>/delete" method="POST" class="inline" 
                    onsubmit="return confirm('Are you sure you want to delete this landing?');">
                <button type="submit" class="text-red-600 hover:underline bg-transparent border-0 p-0 m-0 cursor-pointer">
                  Delete
                </button>
              </form>
              <a href="/sell-your-<%= landing.slug %>" target="_blank"
                 class="bg-blue-600 text-white px-3 py-1 rounded hover:bg-blue-700">
                View
              </a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <!-- Mobile cards -->
  <div class="space-y-4 md:hidden">
    <% if (landings.length === 0) { %>
      <div class="text-center text-gray-500">No landings found.</div>
    <% } %>
    <% landings.forEach(landing => { %>
      <div class="bg-white rounded-lg shadow p-4">
        <div class="flex items-center space-x-4">
          <% if (landing.imageManifest?.sources?.jpg) { %>
            <img src="<%= landing.imageManifest.sources.jpg[0].url %>" 
                 class="w-20 h-12 object-cover rounded shadow" 
                 alt="Landing thumbnail">
          <% } else if (landing.imagePath) { %>
            <img src="<%= landing.imagePath %>.jpg" 
                 class="w-20 h-12 object-cover rounded shadow" 
                 alt="Landing thumbnail">
          <% } else { %>
            <div class="w-20 h-12 flex items-center justify-center bg-gray-200 text-gray-500 rounded">No Img</div>
          <% } %>

          <div>
            <h3 class="font-semibold text-gray-800"><%= landing.make %> <%= landing.model %></h3>
            <p class="text-sm text-gray-500">Slug: <%= landing.slug %></p>
          </div>
        </div>

        <div class="mt-4 flex flex-wrap gap-2">
          <a href="/admin/landing/<%= landing._id %>/edit" 
             class="text-blue-600 hover:underline">Edit</a>
          <form action="/admin/landing/<%= landing._id %>/delete" method="POST" class="inline"
                onsubmit="return confirm('Are you sure you want to delete this landing?');">
            <button type="submit" class="text-red-600 hover:underline bg-transparent border-0 p-0 m-0 cursor-pointer">
              Delete
            </button>
          </form>
          <a href="/sell-your-<%= landing.slug %>" target="_blank"
             class="bg-blue-600 text-white px-3 py-1 rounded hover:bg-blue-700">
            View
          </a>
        </div>
      </div>
    <% }) %>
  </div>

</body>
</html>
