<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/seo-head', { title: 'Hero Image Library | Admin', robots: 'noindex, nofollow' }) %>
  <link rel="stylesheet" href="/css/tailwind.css" />
</head>
<body class="flex min-h-screen flex-col bg-gray-50 text-gray-900 antialiased">
  <%- include('partials/nav', { pageTitle: 'Hero Images', user }) %>

  <main class="flex-1">
    <div class="mx-auto max-w-7xl p-3 sm:p-6">
      <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
        <div>
          <h1 class="text-3xl font-bold text-gray-900">Hero image library</h1>
          <p class="mt-1 text-sm text-gray-600">Reusable, responsive images for the showroom homepage.</p>
        </div>
        <a href="/admin/showroom" class="rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 transition hover:bg-gray-50">Showroom settings</a>
      </div>

      <% if (saved) { %>
        <div class="mb-6 rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">Hero image added to the library.</div>
      <% } %>

      <section class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm sm:p-6">
        <h2 class="text-lg font-semibold text-gray-900">Add image</h2>
        <form action="/admin/hero-images" method="POST" enctype="multipart/form-data" class="mt-5 grid gap-4 md:grid-cols-2 lg:grid-cols-4 lg:items-end">
          <div>
            <label for="name" class="mb-2 block text-sm font-medium text-gray-700">Internal name</label>
            <input id="name" name="name" type="text" required class="w-full rounded-lg border border-gray-300 px-3 py-2.5 focus:border-transparent focus:ring-2 focus:ring-blue-500" placeholder="e.g. Autumn arrivals" />
          </div>
          <div>
            <label for="alt" class="mb-2 block text-sm font-medium text-gray-700">Alt text</label>
            <input id="alt" name="alt" type="text" class="w-full rounded-lg border border-gray-300 px-3 py-2.5 focus:border-transparent focus:ring-2 focus:ring-blue-500" placeholder="Describe the image" />
          </div>
          <div>
            <label for="heroImage" class="mb-2 block text-sm font-medium text-gray-700">Image file</label>
            <input id="heroImage" name="heroImage" type="file" required accept="image/jpeg,image/png,image/webp,image/avif" class="block w-full cursor-pointer rounded-lg border border-gray-300 bg-white text-sm text-gray-700 file:mr-3 file:border-0 file:bg-blue-50 file:px-3 file:py-2 file:font-medium file:text-blue-700 hover:file:bg-blue-100" />
          </div>
          <button type="submit" class="rounded-lg bg-blue-600 px-5 py-2.5 font-medium text-white shadow-sm transition hover:bg-blue-700">Add to library</button>
        </form>
      </section>

      <% if (!heroImages.length) { %>
        <div class="mt-6 rounded-xl border border-dashed border-gray-300 bg-white p-10 text-center text-sm text-gray-600">No saved hero images yet.</div>
      <% } else { %>
        <section class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <% heroImages.forEach(heroImage => { %>
            <article class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
              <% if (heroImage.manifest && heroImage.manifest.sources && heroImage.manifest.sources.jpg && heroImage.manifest.sources.jpg.length) { %>
                <img src="<%= heroImage.manifest.sources.jpg[0].url %>" alt="<%= heroImage.alt || heroImage.name %>" class="aspect-video w-full object-cover" loading="lazy" />
              <% } %>
              <div class="p-4">
                <h2 class="font-semibold text-gray-900"><%= heroImage.name %></h2>
                <p class="mt-1 min-h-5 text-sm text-gray-600"><%= heroImage.alt || 'No alt text provided' %></p>
                <form action="/admin/hero-images/<%= heroImage._id %>/delete" method="POST" class="mt-4" onsubmit="return confirm('Remove this saved hero image?');">
                  <button type="submit" class="text-sm font-medium text-red-600 transition hover:text-red-700">Remove image</button>
                </form>
              </div>
            </article>
          <% }) %>
        </section>
      <% } %>
    </div>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
