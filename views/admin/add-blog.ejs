<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Add New Blog | Admin</title>
  <meta name="robots" content="noindex, nofollow">
  <link rel="stylesheet" href="/css/tailwind.css" />
  <style>
    body { font-family: system-ui, -apple-system, sans-serif; }
  </style>
</head>

<body class="bg-gray-50 text-gray-900 antialiased">

<%- include('partials/nav', { pageTitle: 'Add Blog', user }) %>

  <main class="min-h-screen">
    <div class="max-w-5xl mx-auto p-3 sm:p-6">

      <!-- Page Title -->
      <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between sm:flex-wrap">
        <h2 class="text-3xl font-bold text-gray-900">Add New Blog</h2>
        <a href="/admin/blogs" class="text-gray-600 hover:text-gray-900 flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          Back to List
        </a>
      </div>

      <form action="/admin/blogs" method="POST" enctype="multipart/form-data" class="space-y-8">

        <!-- Blog Details -->
        <section class="bg-white rounded-xl shadow-sm border border-gray-200 p-3 sm:p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
            Blog Details
          </h3>

          <div class="space-y-6">

            <!-- Title -->
            <div>
              <label for="title" class="block text-sm font-medium text-gray-700 mb-2">Title</label>
              <input id="title" name="title" required
                class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition"
                placeholder="Blog title">
            </div>

            <!-- Slug -->
            <div>
              <label for="slug" class="block text-sm font-medium text-gray-700 mb-2">Slug</label>
              <input id="slug" name="slug" required
                class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition"
                placeholder="blog-url-slug">
              <p class="text-xs text-gray-500 mt-1">Unique slug for the blog URL, e.g. <code>sell-your-bmw</code></p>
            </div>

            <!-- Excerpt -->
            <div>
              <label for="excerpt" class="block text-sm font-medium text-gray-700 mb-2">Excerpt</label>
              <textarea id="excerpt" name="excerpt" rows="4"
                class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition resize-none"
                placeholder="Short summary for blog listings"></textarea>
            </div>

            <!-- Layout -->
            <div>
              <label for="layout" class="block text-sm font-medium text-gray-700 mb-2">Page Layout</label>
              <select id="layout" name="layout" class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition bg-white">
                <option value="feature" selected>Featured hero layout</option>
                <option value="standard">Standard article layout</option>
                <option value="magazine">Magazine style layout</option>
              </select>
              <p class="text-xs text-gray-500 mt-1">Featured gives you the richer hero treatment; magazine uses a clean editorial article style.</p>
            </div>

          </div>
        </section>

        <!-- Cover Image -->
        <section class="bg-white rounded-xl shadow-sm border border-gray-200 p-3 sm:p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            Cover Image
          </h3>

          <div class="space-y-6">

            <!-- Upload -->
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Upload Cover Image</label>

              <div class="border-2 border-dashed border-gray-300 rounded-lg p-8 text-center hover:border-blue-400 transition cursor-pointer"
                   onclick="document.getElementById('coverImageFile').click()">

                <svg class="w-12 h-12 text-gray-400 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                </svg>

                <p class="text-sm text-gray-600 mb-1">Click to upload image</p>
                <p class="text-xs text-gray-500">PNG, JPG, WEBP</p>
              </div>

              <input id="coverImageFile" name="coverImageFile" type="file" accept="image/*" class="hidden"
                     onchange="document.getElementById('coverImageName').textContent = this.files[0]?.name || 'No file selected'">

              <div id="coverImageName" class="text-sm text-gray-500 mt-2">No file selected</div>
            </div>

            <!-- URL -->
            <div>
              <label for="coverImage" class="block text-sm font-medium text-gray-700 mb-2">Or use an image URL</label>
              <input id="coverImage" name="coverImage"
                class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition"
                placeholder="https://example.com/image.jpg">
            </div>

          </div>
        </section>

        <!-- Content -->
        <section class="bg-white rounded-xl shadow-sm border border-gray-200 p-3 sm:p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16h8M8 12h8M8 8h8"/>
            </svg>
            Blog Content
          </h3>

          <div class="space-y-6">

            <!-- Inline Image Upload -->
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Insert Image</label>

              <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between sm:flex-wrap">
                <button id="insertImageBtn" type="button"
                  class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition">
                  <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v12m6-6H6"/>
                  </svg>
                  Upload & Insert Image
                </button>

                <div id="inlineImageName" class="text-sm text-gray-500">No file selected</div>
              </div>

              <input id="inlineImageFile" name="inlineImageFile" type="file" accept="image/*" class="hidden">
              <p class="text-xs text-gray-500 mt-1">Image will be inserted as an &lt;img&gt; tag</p>
            </div>

            <!-- Content -->
            <div>
              <div class="flex items-center justify-between mb-2">
                <label for="content" class="block text-sm font-medium text-gray-700">Blog Content</label>
                <button type="button" id="assistBtn"
                  class="px-3 py-1 text-xs font-medium text-blue-600 hover:text-blue-700 hover:bg-blue-50 rounded-lg transition flex items-center gap-1"
                  onclick="generateBlogDraft()">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                  </svg>
                  AI Assist
                </button>
              </div>
              <textarea id="content" name="content" rows="12" required
                class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition resize-none"
                placeholder="Blog content HTML or markdown"></textarea>
            </div>

          </div>
        </section>

        <!-- Action Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 bg-white rounded-xl shadow-sm border border-gray-200 p-3 sm:p-6">
          <a href="/admin/blogs"
             class="w-full sm:w-auto px-6 py-2.5 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition font-medium text-center">
            Cancel
          </a>

          <button type="submit"
            class="w-full sm:w-auto px-8 py-2.5 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition shadow-sm font-medium flex items-center justify-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            Save Blog
          </button>
        </div>

      </form>
    </div>
  </main>

  <!-- JS -->
  <script>
    const titleInput = document.getElementById('title');
    const slugInput = document.getElementById('slug');
    const inlineImageBtn = document.getElementById('insertImageBtn');
    const inlineImageInput = document.getElementById('inlineImageFile');
    const inlineImageName = document.getElementById('inlineImageName');
    const contentTextarea = document.getElementById('content');
    const assistBtn = document.getElementById('assistBtn');
    const insertImageBtnDefaultHtml = inlineImageBtn.innerHTML;
    let slugEditedManually = false;

    function toSlug(value) {
      return (value || '')
        .toLowerCase()
        .trim()
        .replace(/[^a-z0-9\s-]/g, '')
        .replace(/\s+/g, '-')
        .replace(/-+/g, '-');
    }

    if (slugInput && titleInput) {
      slugInput.addEventListener('input', () => {
        slugEditedManually = slugInput.value.trim().length > 0;
      });

      titleInput.addEventListener('input', () => {
        if (slugEditedManually) return;
        slugInput.value = toSlug(titleInput.value);
      });

      slugInput.addEventListener('blur', () => {
        slugInput.value = toSlug(slugInput.value);
      });
    }

    inlineImageBtn.addEventListener('click', () => inlineImageInput.click());

    inlineImageInput.addEventListener('change', async () => {
      const file = inlineImageInput.files?.[0];
      inlineImageName.textContent = file ? file.name : 'No file selected';
      if (!file) return;

      const formData = new FormData();
      formData.append('image', file);

      inlineImageBtn.disabled = true;
      inlineImageBtn.textContent = 'Uploading...';

      try {
        const response = await fetch('/admin/blogs/upload-image', { method: 'POST', body: formData });
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || 'Upload failed');

        const imgTag = `<img src="${data.url}" alt="Blog image" />`;
        const start = contentTextarea.selectionStart || 0;
        const end = contentTextarea.selectionEnd || 0;

        contentTextarea.value =
          contentTextarea.value.substring(0, start) +
          imgTag +
          contentTextarea.value.substring(end);

        contentTextarea.focus();
        contentTextarea.selectionStart = contentTextarea.selectionEnd = start + imgTag.length;

      } catch (err) {
        alert(err.message || 'Image upload failed.');
      } finally {
        inlineImageBtn.disabled = false;
        inlineImageBtn.innerHTML = insertImageBtnDefaultHtml;
      }
    });

    async function generateBlogDraft() {
      const title = document.getElementById('title').value.trim();
      const excerpt = document.getElementById('excerpt').value.trim();
      const topic = document.getElementById('content').value.trim();

      if (!title && !excerpt && !topic) {
        alert('Please add a title, excerpt, or some content context before using AI Assist.');
        return;
      }

      assistBtn.disabled = true;
      assistBtn.innerHTML = '<svg class="w-4 h-4 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg> Generating...';

      try {
        const response = await fetch('/admin/blogs/ai-assist', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title, excerpt, topic })
        });
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || 'Generation failed');

        if (data.content) {
          contentTextarea.value = data.content;
          contentTextarea.focus();
        }
      } catch (err) {
        alert(err.message || 'AI generation failed.');
      } finally {
        assistBtn.disabled = false;
        assistBtn.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg> AI Assist';
      }
    }
  </script>

</body>
</html>
