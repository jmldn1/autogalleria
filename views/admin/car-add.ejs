<main class="max-w-5xl mx-auto p-3 sm:p-6">
  <div class="mb-6 flex items-center justify-between">
    <h2 class="text-3xl font-bold text-gray-900"><%= car._id ? 'Edit Car' : 'Add New Car' %></h2>
    <a href="/admin/cars" class="text-gray-600 hover:text-gray-900 flex items-center gap-2">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
      </svg>
      Back to List
    </a>
  </div>

  <form action="<%= action %>" method="POST" enctype="multipart/form-data" class="space-y-6">
    <!-- Hidden field to preserve existing images during edit -->
    <input type="hidden" id="existingImages" name="existingImages" value="<%= car.images ? JSON.stringify(car.images) : '[]' %>"
    
    <!-- Basic Information Section -->
    <section class="bg-white rounded-xl shadow-sm border border-gray-200 p-3 sm:p-6">
      <h3 class="text-lg font-semibold text-gray-900 mb-4 flex items-center gap-2">
        <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        Basic Information
      </h3>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Make *</label>
          <input type="text" name="make" value="<%= car.make || '' %>" required
                 class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition"
                 placeholder="e.g., Toyota">
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Model *</label>
          <input type="text" name="model" value="<%= car.model || '' %>" required
                 class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition"
                 placeholder="e.g., Camry">
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Year *</label>
          <input type="number" name="year" value="<%= car.year || '' %>" required min="1900" max="2026"
                 class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition"
                 placeholder="2024">
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">VIN</label>
          <input type="text" name="vin" value="<%= car.vin || '' %>" maxlength="17"
                 class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition font-mono"
                 placeholder="17-character VIN">
          <p class="text-xs text-gray-500 mt-1">Vehicle Identification Number</p>
        </div>
      </div>
    </section>

    <!-- Pricing & Condition Section -->
    <section class="bg-white rounded-xl shadow-sm border border-gray-200 p-3 sm:p-6">
      <h3 class="text-lg font-semibold text-gray-900 mb-4 flex items-center gap-2">
        <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"/>
        </svg>
        Pricing & Condition
      </h3>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Price (£)</label>
          <div class="relative">
            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-500">£</span>
            <input type="number" name="price" value="<%= car.price || '' %>" step="0.01" min="0"
                   class="w-full border border-gray-300 rounded-lg pl-8 pr-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition"
                   placeholder="25000.00">
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Mileage</label>
          <div class="relative">
            <input type="number" name="mileage" value="<%= car.mileage || '' %>" min="0"
                   class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition"
                   placeholder="50000">
            <span class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-500 text-sm">miles</span>
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Condition</label>
          <input type="text" name="condition" value="<%= car.condition || '' %>"
                 class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition"
                 placeholder="e.g., Excellent, Good, Fair"
                 list="conditionOptions">
          <datalist id="conditionOptions">
            <option value="Excellent">
            <option value="Very Good">
            <option value="Good">
            <option value="Fair">
            <option value="Poor">
          </datalist>
        </div>
      </div>
    </section>

    <!-- Vehicle Specifications Section -->
    <section class="bg-white rounded-xl shadow-sm border border-gray-200 p-3 sm:p-6">
      <h3 class="text-lg font-semibold text-gray-900 mb-4 flex items-center gap-2">
        <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        Vehicle Specifications
      </h3>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Fuel Type</label>
          <input type="text" name="fuelType" value="<%= car.fuelType || '' %>"
                 class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition"
                 placeholder="e.g., Petrol, Diesel, Hybrid"
                 list="fuelOptions">
          <datalist id="fuelOptions">
            <option value="Petrol">
            <option value="Diesel">
            <option value="Hybrid">
            <option value="Electric">
            <option value="LPG">
          </datalist>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Transmission</label>
          <input type="text" name="transmission" value="<%= car.transmission || '' %>"
                 class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition"
                 placeholder="e.g., Manual, Automatic"
                 list="transmissionOptions">
          <datalist id="transmissionOptions">
            <option value="Manual">
            <option value="Automatic">
            <option value="CVT">
            <option value="Semi-Automatic">
          </datalist>
        </div>
      </div>
    </section>

    <!-- Description Section -->
    <section class="bg-white rounded-xl shadow-sm border border-gray-200 p-3 sm:p-6">
      <h3 class="text-lg font-semibold text-gray-900 mb-4 flex items-center gap-2">
        <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"/>
        </svg>
        Description & Media
      </h3>
      
      <div class="space-y-6">
        <div>
          <div class="flex items-center justify-between mb-2">
            <label class="block text-sm font-medium text-gray-700">Description</label>
            <button type="button" id="assistBtn" 
                    class="px-3 py-1 text-xs font-medium text-blue-600 hover:text-blue-700 hover:bg-blue-50 rounded-lg transition flex items-center gap-1"
                    onclick="generateDescription()">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
              </svg>
              AI Assist
            </button>
          </div>
          <textarea name="description" id="descriptionInput" rows="5"
                    class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition resize-none"
                    placeholder="Detailed description of the vehicle, features, history, etc."><%= car.description || '' %></textarea>
          <p class="text-xs text-gray-500 mt-1">Provide a comprehensive description to attract buyers</p>
        </div>

<div>
  <label class="block text-sm font-medium text-gray-700 mb-2">
    YouTube URL
  </label>

  <div class="relative">
    <svg class="w-5 h-5 text-red-600 absolute left-3 top-1/2 -translate-y-1/2"
         fill="currentColor" viewBox="0 0 24 24">
      <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
    </svg>

    <input
      type="url"
      id="youtubeInput"
      name="youtubeUrl"
      value="<%= car.youtubeUrl || '' %>"
      class="w-full border border-gray-300 rounded-lg pl-12 pr-4 py-2.5
             focus:ring-2 focus:ring-blue-500 focus:border-transparent transition"
      placeholder="https://www.youtube.com/watch?v=VIDEO_ID"
      onblur="normaliseYouTubeUrl()"
    >
  </div>

  <p class="text-xs text-gray-500 mt-1">
    Paste any YouTube link — it will be converted automatically
  </p>
</div>
      </div>
    </section>

    <!-- Gallery Images Section -->
    <section class="bg-white rounded-xl shadow-sm border border-gray-200 p-3 sm:p-6">
      <h3 class="text-lg font-semibold text-gray-900 mb-4 flex items-center gap-2">
        <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
        Gallery Images
      </h3>
      
      <div class="space-y-4">
        <!-- Existing Images -->
        <% if (car.images && car.images.length) { %>
          <div data-existing-images>
            <p class="text-sm font-medium text-gray-700 mb-3">Current Images (<%= car.images.length %>)</p>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
              <% car.images.forEach((img, index) => { %>
                <div class="relative group">
                  <img src="<%= img.fallback %>" alt="Gallery Image <%= index + 1 %>" 
                       class="w-full h-32 object-cover rounded-lg border-2 border-gray-200">
                  <button type="button" onclick="removeExistingImage('<%= index %>')"
                          class="absolute top-2 right-2 bg-red-500 text-white rounded-full p-1.5 opacity-0 group-hover:opacity-100 transition">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                  </button>
                  <div class="absolute bottom-2 left-2 bg-black/50 text-white text-xs px-2 py-1 rounded">
                    Image <%= index + 1 %>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>
        <% } %>

        <!-- Upload New Images -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-3">
            <%= car.images && car.images.length ? 'Add More Images' : 'Upload Images' %>
          </label>
          <div class="border-2 border-dashed border-gray-300 rounded-lg p-8 text-center hover:border-blue-400 transition cursor-pointer"
               onclick="document.getElementById('galleryInput').click()">
            <svg class="w-12 h-12 text-gray-400 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
            </svg>
            <p class="text-sm text-gray-600 mb-1">Click to upload images or drag and drop</p>
            <p class="text-xs text-gray-500">PNG, JPG, WEBP up to 10MB each</p>
          </div>
          
          <input type="file" id="galleryInput" name="galleryImages" accept="image/*" multiple
                 class="hidden"
                 onchange="previewNewImages(this)">

          <div id="newImagePreview" class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-4"></div>
        </div>
      </div>
    </section>

    <!-- Action Buttons -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 bg-white rounded-xl shadow-sm border border-gray-200 p-3 sm:p-6">
      <a href="/admin/cars" class="w-full sm:w-auto px-6 py-2.5 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition font-medium text-center">
        Cancel
      </a>
      <button type="submit"
              class="w-full sm:w-auto px-8 py-2.5 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition shadow-sm font-medium flex items-center justify-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
        </svg>
        Save Car
      </button>
    </div>
  </form>
</main>

<script>
  function previewNewImages(input) {
    const preview = document.getElementById('newImagePreview');
    preview.innerHTML = '';
    
    if (input.files && input.files.length > 0) {
      Array.from(input.files).forEach((file, index) => {
        const reader = new FileReader();
        
        reader.onload = function(e) {
          const div = document.createElement('div');
          div.className = 'relative group';
          div.innerHTML = `
            <img src="${e.target.result}" class="w-full h-32 object-cover rounded-lg border-2 border-green-200">
            <button type="button" onclick="removeNewImage(${index})"
                    class="absolute top-2 right-2 bg-red-500 text-white rounded-full p-1.5 opacity-0 group-hover:opacity-100 transition">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
              </svg>
            </button>
            <div class="absolute bottom-2 left-2 bg-green-600 text-white text-xs px-2 py-1 rounded">
              New ${index + 1}
            </div>
          `;
          preview.appendChild(div);
        };
        
        reader.readAsDataURL(file);
      });
    }
  }

  function removeNewImage(index) {
    const input = document.getElementById('galleryInput');
    const dt = new DataTransfer();
    const files = Array.from(input.files);
    
    files.forEach((file, i) => {
      if (i !== index) dt.items.add(file);
    });
    
    input.files = dt.files;
    previewNewImages(input);
  }

  function removeExistingImage(index) {
    const existingImagesInput = document.getElementById('existingImages');
    const images = JSON.parse(existingImagesInput.value || '[]');
    images.splice(index, 1);
    existingImagesInput.value = JSON.stringify(images);
    
    // Re-render the existing images
    const existingImagesContainer = document.querySelector('[data-existing-images]');
    if (existingImagesContainer) {
      location.reload(); // Simple way to refresh the preview
    }
  }
</script>
<script>
function normaliseYouTubeUrl() {
  const input = document.getElementById('youtubeInput');
  let url = input.value.trim();
  if (!url) return;

  try {
    const yt = new URL(url);
    let videoId = '';

    if (yt.hostname.includes('youtube.com') && yt.searchParams.get('v')) {
      videoId = yt.searchParams.get('v');
    } else if (yt.hostname === 'youtu.be') {
      videoId = yt.pathname.slice(1);
    } else if (yt.pathname.includes('/embed/')) {
      videoId = yt.pathname.split('/embed/')[1];
    } else {
      console.warn('Invalid YouTube URL');
      input.value = '';
      return;
    }

    input.value = `https://www.youtube-nocookie.com/embed/${videoId}`;
  } catch (e) {
    console.error('Error parsing YouTube URL:', e);
    input.value = '';
  }
}

async function generateDescription() {
  const btn = document.getElementById('assistBtn');
  const textarea = document.getElementById('descriptionInput');
  
  // Get current car details from form
  const make = document.querySelector('input[name="make"]').value;
  const model = document.querySelector('input[name="model"]').value;
  const year = document.querySelector('input[name="year"]').value;
  const fuelType = document.querySelector('input[name="fuelType"]').value;
  const transmission = document.querySelector('input[name="transmission"]').value;
  const condition = document.querySelector('input[name="condition"]').value;
  const mileage = document.querySelector('input[name="mileage"]').value;

  if (!make || !model || !year) {
    alert('Please fill in Make, Model, and Year before using AI Assist');
    return;
  }

  // Show loading state
  btn.disabled = true;
  btn.innerHTML = '<svg class="w-4 h-4 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg> Generating...';

  try {
    const response = await fetch('/admin/cars/ai-assist', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        make,
        model,
        year,
        fuelType,
        transmission,
        condition,
        mileage
      })
    });

    if (!response.ok) {
      throw new Error(`Error: ${response.statusText}`);
    }

    const data = await response.json();
    if (data.description) {
      textarea.value = data.description;
      textarea.focus();
    } else {
      throw new Error('No description generated');
    }
  } catch (error) {
    console.error('Description generation failed:', error);
    alert('Failed to generate description: ' + error.message);
  } finally {
    // Reset button
    btn.disabled = false;
    btn.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg> AI Assist';
  }
}
</script>
 