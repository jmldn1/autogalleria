<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/seo-head', { title: 'Showroom Settings | Admin', robots: 'noindex, nofollow' }) %>
  <link rel="stylesheet" href="/css/tailwind.css" />
</head>
<body class="flex min-h-screen flex-col bg-gray-50 text-gray-900 antialiased">
  <%- include('partials/nav', { pageTitle: 'Showroom Settings', user }) %>

  <main class="flex-1">
    <div class="mx-auto max-w-5xl p-3 sm:p-6">
      <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
        <div>
          <h1 class="text-3xl font-bold text-gray-900">Showroom homepage</h1>
          <p class="mt-1 text-sm text-gray-600">Choose the hero image and edit the primary homepage message.</p>
        </div>
        <a href="/showroom" target="_blank" rel="noopener" class="rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 transition hover:bg-gray-50">View showroom</a>
      </div>

      <% if (saved) { %>
        <div class="mb-6 rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">Showroom settings saved.</div>
      <% } %>

      <% const selectedHeroImage = heroImages.find(heroImage => String(showroom.heroImageAsset || '') === String(heroImage._id)); %>
      <form action="/admin/showroom" method="POST" enctype="multipart/form-data" class="space-y-6">
        <section class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm sm:p-6">
          <h2 class="text-lg font-semibold text-gray-900">Hero media</h2>
          <p class="mt-1 text-sm text-gray-600">Use a dedicated campaign image or draw from a car already in your inventory.</p>

          <div class="mt-5 grid gap-4 md:grid-cols-2">
            <label class="cursor-pointer rounded-lg border p-4 transition <%= showroom.heroMode !== 'custom-image' ? 'border-blue-500 bg-blue-50' : 'border-gray-200 hover:border-blue-300' %>">
              <div class="flex items-start gap-3">
                <input type="radio" name="heroMode" value="featured-car" <%= showroom.heroMode !== 'custom-image' ? 'checked' : '' %> class="mt-1 h-4 w-4 text-blue-600" />
                <span>
                  <span class="block font-medium text-gray-900">Featured inventory car</span>
                  <span class="mt-1 block text-sm text-gray-600">Uses the selected vehicle's responsive 16:9 hero crops.</span>
                </span>
              </div>
            </label>
            <label class="cursor-pointer rounded-lg border p-4 transition <%= showroom.heroMode === 'custom-image' ? 'border-blue-500 bg-blue-50' : 'border-gray-200 hover:border-blue-300' %>">
              <div class="flex items-start gap-3">
                <input type="radio" name="heroMode" value="custom-image" <%= showroom.heroMode === 'custom-image' ? 'checked' : '' %> class="mt-1 h-4 w-4 text-blue-600" />
                <span>
                  <span class="block font-medium text-gray-900">Custom campaign image</span>
                  <span class="mt-1 block text-sm text-gray-600">Uploads and optimises a dedicated responsive hero image.</span>
                </span>
              </div>
            </label>
          </div>

          <div class="mt-6 grid gap-6 md:grid-cols-2">
            <div>
              <label for="heroCar" class="mb-2 block text-sm font-medium text-gray-700">Featured car</label>
              <select id="heroCar" name="heroCar" class="w-full rounded-lg border border-gray-300 px-3 py-2.5 focus:border-transparent focus:ring-2 focus:ring-blue-500">
                <option value="">Newest eligible car automatically</option>
                <% cars.forEach(car => { %>
                  <option value="<%= car._id %>" <%= String(showroom.heroCar || '') === String(car._id) ? 'selected' : '' %>><%= [car.year, car.make, car.model].filter(Boolean).join(' ') || 'Untitled vehicle' %></option>
                <% }) %>
              </select>
            </div>
            <div>
              <label for="heroImageAsset" class="mb-2 block text-sm font-medium text-gray-700">Saved custom image</label>
              <select id="heroImageAsset" name="heroImageAsset" class="w-full rounded-lg border border-gray-300 px-3 py-2.5 focus:border-transparent focus:ring-2 focus:ring-blue-500">
                <option value="">Choose a saved image</option>
                <% heroImages.forEach(heroImage => { %>
                  <option value="<%= heroImage._id %>" <%= String(showroom.heroImageAsset || '') === String(heroImage._id) ? 'selected' : '' %>><%= heroImage.name %></option>
                <% }) %>
              </select>
              <a href="/admin/hero-images" class="mt-2 inline-block text-sm font-medium text-blue-700 hover:text-blue-800">Manage saved images &rarr;</a>
            </div>
            <div>
              <label for="heroImage" class="mb-2 block text-sm font-medium text-gray-700">Upload a new saved image</label>
              <input id="heroImage" name="heroImage" type="file" accept="image/jpeg,image/png,image/webp,image/avif" class="block w-full cursor-pointer rounded-lg border border-gray-300 bg-white text-sm text-gray-700 file:mr-4 file:border-0 file:bg-blue-50 file:px-4 file:py-2 file:font-medium file:text-blue-700 hover:file:bg-blue-100" />
              <input id="heroImageName" name="heroImageName" type="text" class="mt-3 w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm focus:border-transparent focus:ring-2 focus:ring-blue-500" placeholder="Image name, e.g. Summer collection" />
              <p class="mt-2 text-xs text-gray-500">A new upload is optimised and saved to the image library for reuse.</p>
            </div>
          </div>

          <% if (selectedHeroImage && selectedHeroImage.manifest && selectedHeroImage.manifest.sources && selectedHeroImage.manifest.sources.jpg && selectedHeroImage.manifest.sources.jpg.length) { %>
            <div class="mt-6">
              <p class="mb-2 text-sm font-medium text-gray-700">Selected saved image</p>
              <img src="<%= selectedHeroImage.manifest.sources.jpg[0].url %>" alt="<%= selectedHeroImage.alt || selectedHeroImage.name %>" class="aspect-video w-full max-w-md rounded-lg border border-gray-200 object-cover" />
            </div>
          <% } %>

          <div class="mt-6">
            <label for="heroImageAlt" class="mb-2 block text-sm font-medium text-gray-700">Custom image alt text</label>
            <input id="heroImageAlt" name="heroImageAlt" type="text" value="<%= selectedHeroImage && selectedHeroImage.alt ? selectedHeroImage.alt : (showroom.heroImage && showroom.heroImage.alt ? showroom.heroImage.alt : '') %>" class="w-full rounded-lg border border-gray-300 px-3 py-2.5 focus:border-transparent focus:ring-2 focus:ring-blue-500" placeholder="Describe the custom hero image" />
          </div>
        </section>

        <section class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm sm:p-6">
          <h2 class="text-lg font-semibold text-gray-900">Hero copy and calls to action</h2>
          <div class="mt-5 grid gap-5">
            <div>
              <label for="eyebrow" class="mb-2 block text-sm font-medium text-gray-700">Eyebrow</label>
              <input id="eyebrow" name="eyebrow" type="text" value="<%= showroom.eyebrow || '' %>" class="w-full rounded-lg border border-gray-300 px-3 py-2.5 focus:border-transparent focus:ring-2 focus:ring-blue-500" placeholder="Auto Galleria Showroom" />
            </div>
            <div>
              <label for="heading" class="mb-2 block text-sm font-medium text-gray-700">Heading</label>
              <input id="heading" name="heading" type="text" value="<%= showroom.heading || '' %>" class="w-full rounded-lg border border-gray-300 px-3 py-2.5 focus:border-transparent focus:ring-2 focus:ring-blue-500" placeholder="Quality used cars, ready to drive home." />
            </div>
            <div>
              <label for="description" class="mb-2 block text-sm font-medium text-gray-700">Supporting copy</label>
              <textarea id="description" name="description" rows="4" class="w-full rounded-lg border border-gray-300 px-3 py-2.5 focus:border-transparent focus:ring-2 focus:ring-blue-500" placeholder="A short description below the hero heading."><%= showroom.description || '' %></textarea>
            </div>
            <div class="grid gap-5 md:grid-cols-2">
              <div>
                <label for="primaryCtaLabel" class="mb-2 block text-sm font-medium text-gray-700">Primary CTA label</label>
                <input id="primaryCtaLabel" name="primaryCtaLabel" type="text" value="<%= showroom.primaryCtaLabel || '' %>" class="w-full rounded-lg border border-gray-300 px-3 py-2.5 focus:border-transparent focus:ring-2 focus:ring-blue-500" placeholder="Browse all stock" />
              </div>
              <div>
                <label for="primaryCtaUrl" class="mb-2 block text-sm font-medium text-gray-700">Primary CTA URL</label>
                <input id="primaryCtaUrl" name="primaryCtaUrl" type="text" value="<%= showroom.primaryCtaUrl || '' %>" class="w-full rounded-lg border border-gray-300 px-3 py-2.5 focus:border-transparent focus:ring-2 focus:ring-blue-500" placeholder="/cars" />
              </div>
              <div>
                <label for="secondaryCtaLabel" class="mb-2 block text-sm font-medium text-gray-700">Secondary CTA label</label>
                <input id="secondaryCtaLabel" name="secondaryCtaLabel" type="text" value="<%= showroom.secondaryCtaLabel || '' %>" class="w-full rounded-lg border border-gray-300 px-3 py-2.5 focus:border-transparent focus:ring-2 focus:ring-blue-500" placeholder="Get a free valuation" />
              </div>
              <div>
                <label for="secondaryCtaUrl" class="mb-2 block text-sm font-medium text-gray-700">Secondary CTA URL</label>
                <input id="secondaryCtaUrl" name="secondaryCtaUrl" type="text" value="<%= showroom.secondaryCtaUrl || '' %>" class="w-full rounded-lg border border-gray-300 px-3 py-2.5 focus:border-transparent focus:ring-2 focus:ring-blue-500" placeholder="/sell-your-car" />
              </div>
            </div>
          </div>
        </section>

        <div class="flex justify-end">
          <button type="submit" class="rounded-lg bg-blue-600 px-6 py-2.5 font-medium text-white shadow-sm transition hover:bg-blue-700">Save showroom settings</button>
        </div>
      </form>
    </div>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
