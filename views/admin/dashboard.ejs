<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard | Auto Galleria</title>
  <link rel="stylesheet" href="/css/tailwind.css" />
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="flex min-h-screen flex-col bg-gray-100 text-gray-800">

<%- include('partials/nav', { pageTitle: 'Dashboard', user }) %>

<!-- MAIN DASHBOARD -->
<main class="flex-1 mx-auto w-full max-w-7xl p-6 space-y-8">

  <!-- Dashboard Title -->
  <h2 class="text-2xl font-bold">Dashboard</h2>

  <!-- Top Admin Cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    <!-- Landings -->
    <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm hover:shadow-lg transition">
      <h3 class="font-semibold text-lg mb-2">Landings</h3>
      <p class="text-gray-600 mb-4">Manage landing pages.</p>
      <a href="/admin/landings" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded">Manage</a>
    </div>

    <!-- Cars -->
    <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm hover:shadow-lg transition">
      <h3 class="font-semibold text-lg mb-2">Cars</h3>
      <p class="text-gray-600 mb-4">Add, edit, and remove cars.</p>
      <a href="/admin/cars" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded">Manage</a>
    </div>

    <!-- Blog -->
    <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm hover:shadow-lg transition">
      <h3 class="font-semibold text-lg mb-2">Blog</h3>
      <p class="text-gray-600 mb-4">Manage blog posts.</p>
      <a href="/admin/blogs" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded">Manage</a>
    </div>
  </div>

  <!-- Action Summary -->
  <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4">
    <div class="rounded-lg border border-amber-200 bg-amber-50 p-4 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-wide text-amber-700">Needs follow-up</p>
      <p class="mt-2 text-3xl font-bold text-amber-900"><%= metrics.followUpNeeded %></p>
      <p class="mt-1 text-sm text-amber-700">Leads already overdue</p>
    </div>
    <div class="rounded-lg border border-blue-200 bg-blue-50 p-4 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-wide text-blue-700">Due this week</p>
      <p class="mt-2 text-3xl font-bold text-blue-900"><%= metrics.dueThisWeek %></p>
      <p class="mt-1 text-sm text-blue-700">Follow-up tasks coming up</p>
    </div>
    <div class="rounded-lg border border-green-200 bg-green-50 p-4 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-wide text-green-700">New leads</p>
      <p class="mt-2 text-3xl font-bold text-green-900"><%= metrics.newLeads %></p>
      <p class="mt-1 text-sm text-green-700">Unreviewed enquiries</p>
    </div>
    <div class="rounded-lg border border-slate-200 bg-slate-50 p-4 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-700">Missing notes</p>
      <p class="mt-2 text-3xl font-bold text-slate-900"><%= metrics.noNotes %></p>
      <p class="mt-1 text-sm text-slate-700">Leads without internal notes</p>
    </div>
  </div>

  <!-- Metrics Cards Section -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <!-- Total Leads -->
    <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm flex items-center">
      <div class="shrink-0 bg-blue-500 text-white rounded-full p-3 mr-4">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2"
          viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
        </svg>
      </div>
      <div>
        <h4 class="text-gray-700 font-semibold">Total Leads</h4>
        <p class="text-2xl font-bold"><%= metrics.totalLeads %></p>
      </div>
    </div>

    <!-- Cars Added -->
    <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm flex items-center">
      <div class="shrink-0 bg-green-500 text-white rounded-full p-3 mr-4">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2"
          viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h2l3 8h8l3-8h2"></path>
        </svg>
      </div>
      <div>
        <h4 class="text-gray-700 font-semibold">Cars Added</h4>
        <p class="text-2xl font-bold"><%= metrics.totalCars %></p>
      </div>
    </div>

    <!-- Blog Posts -->
    <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm flex items-center">
      <div class="shrink-0 bg-red-500 text-white rounded-full p-3 mr-4">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2"
          viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 8h10M7 12h8m-8 4h6"></path>
        </svg>
      </div>
      <div>
        <h4 class="text-gray-700 font-semibold">Blog Posts</h4>
        <p class="text-2xl font-bold"><%= metrics.totalBlogs %></p>
      </div>
    </div>

    <!-- Page Views -->
    <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm flex items-center">
      <div class="shrink-0 bg-yellow-500 text-white rounded-full p-3 mr-4">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2"
          viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A2 2 0 0 1 22 9.618v4.764a2 2 0 0 1-2.447 1.894L15 14M4 6v12m0 0l6-6-6-6"></path>
        </svg>
      </div>
      <div>
        <h4 class="text-gray-700 font-semibold">Page Views</h4>
        <p class="text-2xl font-bold"><%= metrics.totalPageViews %></p>
      </div>
    </div>
  </div>

  <!-- Charts Section -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
    <!-- Line Chart -->
    <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm">
      <h3 class="text-lg font-semibold mb-4">Leads Over Time</h3>
      <canvas id="lineChart" class="w-full h-64"></canvas>
    </div>

    <!-- Heatmap Simulation -->
    <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm">
      <h3 class="text-lg font-semibold mb-4">Website Activity Heatmap</h3>
      <canvas id="heatmap" class="w-full h-64"></canvas>
    </div>
  </div>

  <!-- Follow-up Queue -->
  <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm">
    <div class="mb-4 flex items-center justify-between gap-3">
      <h3 class="text-lg font-semibold">Follow-up queue</h3>
      <a href="/admin/leads?filter=followup" class="text-sm font-medium text-blue-600 hover:text-blue-800">View all</a>
    </div>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Lead</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Vehicle</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Due</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% if (followUpQueue && followUpQueue.length) { %>
            <% followUpQueue.forEach(lead => { %>
              <tr class="hover:bg-gray-100">
                <td class="px-6 py-4 whitespace-nowrap"><%= lead.name %></td>
                <td class="px-6 py-4 whitespace-nowrap"><%= lead.car %></td>
                <td class="px-6 py-4 whitespace-nowrap"><span class="inline-flex rounded-full bg-blue-100 px-2 py-1 text-xs font-medium text-blue-700"><%= lead.status %></span></td>
                <td class="px-6 py-4 whitespace-nowrap"><%= new Date(lead.followUpAt).toLocaleDateString('en-GB') %></td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="4" class="px-6 py-4 text-center text-sm text-gray-500">No follow-up tasks scheduled.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Top Pages -->
  <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-lg font-semibold">Top Pages</h3>
      <span class="text-sm text-gray-500"><%= heatmapRangeLabel %></span>
    </div>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Page</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Views</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% if (topPages && topPages.length) { %>
            <% topPages.forEach(item => { %>
              <tr class="hover:bg-gray-100">
                <td class="px-6 py-4 whitespace-nowrap text-blue-600"><%= item.path %></td>
                <td class="px-6 py-4 whitespace-nowrap"><%= item.count %></td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="2" class="px-6 py-4 text-center text-sm text-gray-500">No recent page view data yet.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Recent Leads Table -->
  <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm">
    <div class="mb-4 flex items-center justify-between gap-3">
      <h3 class="text-lg font-semibold">Recent Leads</h3>
      <a href="/admin/leads" class="text-sm font-medium text-blue-600 hover:text-blue-800">View all leads</a>
    </div>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Car Interested</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% if (leads && leads.length) { %>
            <% leads.forEach(lead => {
              const displayDate = lead.date || lead.createdAt;
            %>
              <tr class="hover:bg-gray-100">
                <td class="px-6 py-4 whitespace-nowrap"><%= lead.name %></td>
                <td class="px-6 py-4 whitespace-nowrap"><%= lead.email %></td>
                <td class="px-6 py-4 whitespace-nowrap"><%= lead.car %></td>
                <td class="px-6 py-4 whitespace-nowrap"><%= displayDate ? new Date(displayDate).toLocaleDateString() : '' %></td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="4" class="px-6 py-4 text-center text-sm text-gray-500">No recent leads yet.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

</main>

<%- include('partials/footer') %>

<script id="lead-trend-data" type="application/json"><%- JSON.stringify(leadTrend || []) %></script>
<script id="heatmap-data" type="application/json"><%- JSON.stringify(heatmap || []) %></script>
<script>
  const rawLeadTrend = JSON.parse(document.getElementById('lead-trend-data').textContent);
  const lineLabels = rawLeadTrend.map(item => new Date(`${item.date}T00:00:00`).toLocaleDateString('en-GB', { month: 'short', day: 'numeric' }));
  const lineData = rawLeadTrend.map(item => item.count);

  const ctxLine = document.getElementById('lineChart').getContext('2d');
  new Chart(ctxLine, {
    type: 'line',
    data: {
      labels: lineLabels.length ? lineLabels : ['No leads yet'],
      datasets: [{
        label: 'New Leads',
        data: lineData.length ? lineData : [0],
        borderColor: '#3B82F6',
        backgroundColor: 'rgba(59, 130, 246, 0.2)',
        tension: 0.3,
        fill: true,
        pointRadius: 5,
        pointHoverRadius: 7
      }]
    },
    options: {
      responsive: true,
      plugins: { legend: { display: false } },
      scales: { y: { beginAtZero: true, precision: 0 } }
    }
  });

  // Heatmap from page view data
  const rawHeatmap = JSON.parse(document.getElementById('heatmap-data').textContent);
  const dayLabels = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
  const heatData = rawHeatmap.map(item => ({
    x: item.hour,
    y: item.dayIndex,
    r: Math.min(18, Math.max(4, item.count * 1.5))
  }));

  const ctxHeat = document.getElementById('heatmap').getContext('2d');
  new Chart(ctxHeat, {
    type: 'bubble',
    data: { datasets: [{ label: 'Page views', data: heatData, backgroundColor: 'rgba(59, 130, 246, 0.55)' }] },
    options: {
      responsive: true,
      plugins: { legend: { display: false } },
      scales: {
        x: { title: { display: true, text: 'Hour of Day' }, min: 0, max: 23, ticks: { stepSize: 2 } },
        y: {
          title: { display: true, text: 'Day of Week' },
          ticks: {
            callback: value => dayLabels[value] || value,
            stepSize: 1,
            min: 0,
            max: 6
          }
        }
      }
    }
  });
</script>

</body>
</html>
