<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= car.make %> <%= car.model %> | Auto Galleria</title>
  <meta name="description" content="Buy this <%= car.year %> <%= car.make %> <%= car.model %>. Explore detailed images, videos, and specs at Auto Galleria.">
  <!-- Tailwind -->
  <link href="/css/tailwind.css" rel="stylesheet">
  <!-- Swiper -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"/>
  <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer></script>
  <!-- LightGallery -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lightgallery@2.7.2/css/lightgallery-bundle.min.css">
  <script src="https://cdn.jsdelivr.net/npm/lightgallery@2.7.2/lightgallery.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/lightgallery@2.7.2/plugins/zoom/lg-zoom.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/lightgallery@2.7.2/plugins/thumbnail/lg-thumbnail.min.js" defer></script>
</head>
<body class="bg-gray-50 text-gray-900">
  <%- include('partials/navbar') %>

  <main class="max-w-6xl mx-auto p-4 pt-20">
    <!-- Car Title -->
    <h1 class="text-3xl font-bold mb-4"><%= car.year %> <%= car.make %> <%= car.model %></h1>
    <!-- Gallery -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <!-- Left: Swiper Gallery -->
      <div class="lg:col-span-7">
<div class="swiper mySwiper2 rounded-2xl overflow-hidden shadow-lg">
  <div class="swiper-wrapper" id="lightgallery">
    <% if (car.galleryImages && car.galleryImages.length) { %>
      <% car.galleryImages.forEach((img, index) => { %>
        <div class="swiper-slide" role="group" aria-label="Image <%= index + 1 %> of <%= car.galleryImages.length %>">
          <a
            href="<%= img.lightboxSrc || img.fallback %>"
            data-src="<%= img.lightboxSrc || img.fallback %>"
            data-lg-size="1200-900"
            data-sub-html="<h4><%= car.make %> <%= car.model %></h4><p><%= img.alt || 'Gallery image' %></p>"
            class="gallery-item block"
          >
            <picture>
              <source
                type="image/avif"
                srcset="<%= img.manifest.sources.avif.map(s => `${s.url} ${s.w}w`).join(', ') %>"
                sizes="(max-width: 600px) 300px, (max-width: 1200px) 600px, 1200px"
              >
              <source
                type="image/webp"
                srcset="<%= img.manifest.sources.webp.map(s => `${s.url} ${s.w}w`).join(', ') %>"
                sizes="(max-width: 600px) 300px, (max-width: 1200px) 600px, 1200px"
              >
              <img
                src="<%= img.fallback %>"
                srcset="<%= img.manifest.sources.jpg.map(s => `${s.url} ${s.w}w`).join(', ') %>"
                sizes="(max-width: 600px) 300px, (max-width: 1200px) 600px, 1200px"
                alt="<%= img.alt || `${car.make} ${car.model}` %>"
                class="w-full h-[400px] object-cover"
                loading="lazy"
                style="background:url('<%= img.placeholder %>') center / cover no-repeat;"
              >
            </picture>
          </a>
        </div>
      <% }) %>
    <% } else { %>
      <p class="text-gray-500 p-4">No images available for this car.</p>
    <% } %>
  </div>
  <!-- Arrows -->
  <div class="swiper-button-next"></div>
  <div class="swiper-button-prev"></div>
</div>


        <!-- Thumbnails -->
        <% if (car.galleryImages && car.galleryImages.length) { %>
          <div class="swiper mySwiper mt-4">
            <div class="swiper-wrapper">
              <% car.galleryImages.forEach(img => { %>
                <div class="swiper-slide cursor-pointer">
                  <picture>
                    <source
                      type="image/avif"
                      srcset="<%= img.manifest.sources.avif.map(s => `${s.url} ${s.w}w`).join(', ') %>"
                      sizes="96px"
                    >
                    <source
                      type="image/webp"
                      srcset="<%= img.manifest.sources.webp.map(s => `${s.url} ${s.w}w`).join(', ') %>"
                      sizes="96px"
                    >
                    <img
                      src="<%= img.fallback %>"
                      srcset="<%= img.manifest.sources.jpg.map(s => `${s.url} ${s.w}w`).join(', ') %>"
                      sizes="96px"
                      alt="Thumbnail <%= car.make %> <%= car.model %>"
                      class="w-full h-24 object-cover rounded-lg"
                      loading="lazy"
                      style="background:url('<%= img.placeholder %>') center / cover no-repeat;"
                    >
                  </picture>
                </div>
              <% }) %>
            </div>
          </div>
        <% } %>

        <% if (car.description) { %>
          <div class="bg-white rounded-3xl shadow-lg p-6 mt-6">
            <h2 class="text-xl font-semibold text-gray-900">Vehicle Description</h2>
            <p class="mt-3 text-lg leading-relaxed text-gray-700"><%= car.description %></p>
          </div>
        <% } %>

        <!-- Video -->
        <% if (car.video) { %>
          <div class="mt-8">
            <h2 class="text-2xl font-semibold mb-4">Car Video</h2>
            <div
              class="relative aspect-video overflow-hidden rounded-xl shadow-lg bg-gray-900"
              data-youtube-player
              data-youtube-embed="<%= car.video.embedUrl %>"
              data-youtube-title="<%= `${car.year} ${car.make} ${car.model} video`.replace(/"/g, '&quot;') %>"
            >
              <button
                type="button"
                class="group absolute inset-0 flex h-full w-full items-center justify-center overflow-hidden"
                data-youtube-trigger
                aria-label="Play vehicle video"
              >
                <img
                  src="<%= car.video.thumbnailUrl %>"
                  alt="<%= `${car.year} ${car.make} ${car.model} video preview` %>"
                  class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                  loading="lazy"
                >
                <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/25 to-black/10"></div>
                <div class="absolute inset-x-0 bottom-0 p-5 text-left text-white">
                  <p class="text-sm uppercase tracking-[0.2em] text-white/70">Video</p>
                  <p class="mt-1 text-xl font-semibold"><%= car.year %> <%= car.make %> <%= car.model %> walkaround</p>
                  <p class="mt-1 text-sm text-white/80">Click to load the privacy-enhanced YouTube player.</p>
                </div>
                <span class="absolute left-1/2 top-1/2 z-10 flex h-20 w-20 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-white/90 text-red-600 shadow-lg transition group-hover:scale-105 group-hover:bg-white">
                  <svg viewBox="0 0 24 24" fill="currentColor" class="h-10 w-10" aria-hidden="true">
                    <path d="M8 5v14l11-7z"></path>
                  </svg>
                </span>
              </button>
            </div>
          </div>
        <% } %>
      </div>
      <!-- Right: Car Info -->
      <div class="flex flex-col gap-4 lg:col-span-5 lg:sticky lg:top-24 lg:self-start lg:max-h-[calc(100vh-7rem)] lg:overflow-y-auto lg:pr-1">
        <div class="bg-white rounded-3xl shadow-lg p-6">
          <h2 class="text-xl font-semibold text-gray-900">Specifications</h2>
          <% 
            const conditionRaw = (car.condition || '').toString().trim();
            const conditionLower = conditionRaw.toLowerCase();
            const conditionMap = {
              excellent: 1,
              verygood: 2,
              good: 2,
              fair: 3,
              average: 3,
              poor: 5,
            };

            let conditionScore = null;
            const numericCondition = Number(conditionLower);

            if (Number.isInteger(numericCondition) && numericCondition >= 1 && numericCondition <= 5) {
              conditionScore = numericCondition;
            } else {
              const compact = conditionLower.replace(/[^a-z]/g, '');
              conditionScore = conditionMap[compact] || null;
            }

            const scoreColors = ['bg-emerald-500', 'bg-lime-500', 'bg-amber-500', 'bg-orange-500', 'bg-rose-500'];
          %>
          <ul class="mt-4 space-y-3 text-gray-700">
            <li><strong>Make:</strong> <%= car.make %></li>
            <li><strong>Model:</strong> <%= car.model %></li>
            <li><strong>Year:</strong> <%= car.year %></li>
            <li><strong>VIN:</strong> <%= car.vin %></li>
            <li><strong>Price:</strong> £<%= car.price.toFixed(2) %></li>
            <li><strong>Mileage:</strong> <%= car.mileage.toLocaleString() %> miles</li>
            <li class="flex flex-wrap items-center gap-2">
              <strong>Condition:</strong>
              <span><%= car.condition %></span>
              <% if (conditionScore) { %>
                <span
                  class="inline-flex h-6 w-6 items-center justify-center rounded-full border border-transparent text-xs font-semibold text-white <%= scoreColors[conditionScore - 1] %>"
                  aria-label="Condition score <%= conditionScore %> out of 5"
                >
                  <%= conditionScore %>
                </span>
              <% } %>
            </li>
          </ul>
        </div>

        <div class="bg-blue-600 text-white rounded-3xl shadow-lg p-6">
          <h2 class="text-xl font-semibold">Interested in this vehicle?</h2>
          <p class="mt-2 text-blue-50">Contact us for a viewing or more information.</p>
          <button class="mt-5 bg-white text-blue-700 px-6 py-3 rounded-xl shadow hover:bg-gray-100 transition w-fit">Enquire Now</button>
        </div>
      </div>
    </div>

    <% if (relatedCars && relatedCars.length) { %>
      <section class="mt-14">
        <div class="mb-5 flex flex-col items-start gap-3 sm:flex-row sm:items-end sm:justify-between">
          <h2 class="text-2xl font-bold text-gray-900">Other cars you might like</h2>
          <a
            href="/cars"
            class="inline-flex items-center rounded-full border border-blue-200 bg-blue-50 px-3 py-1.5 text-sm font-semibold text-blue-700 transition hover:border-blue-300 hover:bg-blue-100 hover:text-blue-800"
          >
            View all cars
          </a>
        </div>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3">
          <% relatedCars.forEach((relatedCar) => { %>
            <article class="group overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-xl">
              <a href="/car/<%= relatedCar.slug || relatedCar._id %>" class="block">
                <% const sources = relatedCar.image?.sources || {}; %>
                <% const avifSrcset = sources.avif?.map(src => `${src.url} ${src.w}w`).join(', '); %>
                <% const webpSrcset = sources.webp?.map(src => `${src.url} ${src.w}w`).join(', '); %>
                <% const jpgSrcset = sources.jpg?.map(src => `${src.url} ${src.w}w`).join(', '); %>
                <% const fallbackSrc = relatedCar.image?.fallback || sources.jpg?.[0]?.url || sources.webp?.[0]?.url || sources.avif?.[0]?.url; %>

                <% if (avifSrcset || webpSrcset || jpgSrcset) { %>
                  <picture>
                    <% if (avifSrcset) { %>
                      <source type="image/avif" srcset="<%= avifSrcset %>" sizes="(max-width: 768px) 100vw, (max-width: 1280px) 50vw, 33vw" />
                    <% } %>
                    <% if (webpSrcset) { %>
                      <source type="image/webp" srcset="<%= webpSrcset %>" sizes="(max-width: 768px) 100vw, (max-width: 1280px) 50vw, 33vw" />
                    <% } %>
                    <img
                      src="<%= fallbackSrc %>"
                      srcset="<%= jpgSrcset %>"
                      sizes="(max-width: 768px) 100vw, (max-width: 1280px) 50vw, 33vw"
                      alt="<%= relatedCar.image?.alt %>"
                      class="h-52 w-full object-cover transition duration-300 group-hover:scale-[1.03]"
                      loading="lazy"
                    />
                  </picture>
                <% } else { %>
                  <div class="flex h-52 items-center justify-center bg-slate-100 text-sm font-medium text-slate-500">
                    No image available
                  </div>
                <% } %>

                <div class="p-5">
                  <div class="mb-2 flex items-start justify-between gap-2">
                    <div>
                      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500"><%= relatedCar.year || 'In stock' %></p>
                      <h3 class="text-lg font-semibold text-slate-900"><%= relatedCar.make %> <%= relatedCar.model %></h3>
                    </div>
                    <% if (relatedCar.price) { %>
                      <span class="rounded-full bg-blue-50 px-3 py-1 text-sm font-semibold text-blue-700">£<%= Number(relatedCar.price).toLocaleString() %></span>
                    <% } %>
                  </div>

                  <div class="mt-3 flex flex-wrap gap-2 text-xs text-slate-600">
                    <% if (relatedCar.mileage) { %>
                      <span class="rounded-full bg-slate-100 px-3 py-1"><%= Number(relatedCar.mileage).toLocaleString() %> miles</span>
                    <% } %>
                    <% if (relatedCar.condition) { %>
                      <span class="rounded-full bg-slate-100 px-3 py-1"><%= relatedCar.condition %></span>
                    <% } %>
                  </div>
                </div>
              </a>
            </article>
          <% }) %>
        </div>
      </section>
    <% } %>
  </main>
    <%- include('partials/footer') %>
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const swiperThumbs = new Swiper(".mySwiper", {
        spaceBetween: 10,
        slidesPerView: 4,
        freeMode: true,
        watchSlidesProgress: true,
      });
      const swiperMain = new Swiper(".mySwiper2", {
        spaceBetween: 10,
        navigation: {
          nextEl: ".swiper-button-next",
          prevEl: ".swiper-button-prev",
        },
        thumbs: {
          swiper: swiperThumbs,
        },
      });
      lightGallery(document.getElementById("lightgallery"), {
        plugins: [lgZoom, lgThumbnail],
        selector: "a",
        download: false,
      });

      document.querySelectorAll("[data-youtube-player]").forEach((player) => {
        const trigger = player.querySelector("[data-youtube-trigger]");
        if (!trigger) return;

        trigger.addEventListener("click", () => {
          const iframe = document.createElement("iframe");
          iframe.className = "absolute inset-0 h-full w-full";
          iframe.src = player.dataset.youtubeEmbed;
          iframe.title = player.dataset.youtubeTitle || "Car video";
          iframe.loading = "lazy";
          iframe.referrerPolicy = "strict-origin-when-cross-origin";
          iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
          iframe.allowFullscreen = true;

          player.replaceChildren(iframe);
        }, { once: true });
      });
    });
  </script>
</body>
</html>