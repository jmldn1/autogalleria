          <source type="image/avif" srcset="/images/product3-1200.avif">
          <source type="image/webp" srcset="/images/product3-1200.webp">
          <img
            src="/images/product3-1200.jpg"
            alt="Custom website design and development service"
            class="w-full h-full object-cover"
            loading="lazy"
            decoding="async"
          >
        </picture>
      </div>

      <div>
        <p class="text-sm uppercase tracking-wide text-blue-600 font-semibold mb-3">More Than Templates</p>
