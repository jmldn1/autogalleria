        <source srcset="/images/hero-bg-800x1400.avif" type="image/avif" media="(max-width: 1024px)">
        <source srcset="/images/hero-bg-1600x900.avif" type="image/avif">

        <source srcset="/images/hero-bg-480x840.webp" type="image/webp" media="(max-width: 640px)">
        <source srcset="/images/hero-bg-800x1400.webp" type="image/webp" media="(max-width: 1024px)">
        <source srcset="/images/hero-bg-1600x900.webp" type="image/webp">

        <img src="/images/hero-bg-1600x900.jpg" 
             alt="Hero Background" 
             class="w-full h-full object-cover" 
             loading="eager" 
             fetchpriority="high">
      </picture>

      <div class="absolute inset-0 bg-black/50"></div>
    </div>
    <div class="relative z-10">
