      <h2 class="text-3xl font-bold">PC + Mobile</h2>
      <p class="text-sm text-slate-500">Fully responsive SEO friendly super fast web solutions.</p>
    </header>

<section class="relative flex justify-center items-center">
  <!-- Desktop / Laptop mockup -->
  <figure class="w-full max-w-3xl">
    <div class="relative bg-white rounded-2xl p-6 bezel">
      <div class="rounded-xl overflow-hidden border border-slate-100 shadow-inner">
        <div class="bg-black device-screen aspect-video">
          <picture class="w-full h-full block">
            <source type="image/avif" srcset="/images/hero-bg-480x840.avif 480w, /images/hero-bg-800x1400.avif 800w, /images/hero-bg-1600x900.avif 1600w" sizes="(max-width: 640px) 100vw, 75vw">
            <source type="image/webp" srcset="/images/hero-bg-480x840.webp 480w, /images/hero-bg-800x1400.webp 800w, /images/hero-bg-1600x900.webp 1600w" sizes="(max-width: 640px) 100vw, 75vw">
            <img id="pc-screenshot"
                 class="screenshot"
                 src="/images/hero-bg-1600x900.jpg"
                 srcset="/images/hero-bg-480x840.jpg 480w, /images/hero-bg-800x1400.jpg 800w, /images/hero-bg-1600x900.jpg 1600w"
                 sizes="(max-width: 640px) 100vw, 75vw"
                 alt="PC Screenshot"
                 width="1600"
                 height="900"
                 loading="lazy"
                 decoding="async" />
          </picture>
        </div>
      </div>
      <div class="mt-4 flex justify-center">
        <div class="w-48 h-2 bg-slate-200 rounded-full"></div>
      </div>
      <div class="mt-1 flex justify-center">
        <div class="w-24 h-3 bg-slate-300 rounded-t-lg"></div>
      </div>
    </div>
  </figure>

  <!-- Phone mockup, overlapping -->
  <figure class="absolute right-10 bottom-0 w-32 sm:w-44 md:w-56 lg:w-64 transform translate-y-8 drop-shadow-2xl">
    <div class="relative bg-white rounded-3xl p-4 bezel">
      <div class="rounded-2xl overflow-hidden border border-slate-100">
        <div class="flex justify-center items-center phone-notch bg-slate-50">
          <div class="w-14 h-2 rounded-full bg-slate-200"></div>
        </div>
        <!-- Phone screen with proper aspect ratio -->
        <div class="device-screen aspect-9/19">
          <picture class="w-full h-full block">
            <source type="image/avif" srcset="/images/hero-bg-480x840.avif 480w, /images/hero-bg-800x1400.avif 800w" sizes="(max-width: 640px) 100vw, 25vw">
            <source type="image/webp" srcset="/images/hero-bg-480x840.webp 480w, /images/hero-bg-800x1400.webp 800w" sizes="(max-width: 640px) 100vw, 25vw">
            <img id="phone-screenshot"
                 class="screenshot rounded-xl"
                 src="/images/hero-bg-480x840.jpg"
                 srcset="/images/hero-bg-480x840.jpg 480w, /images/hero-bg-800x1400.jpg 800w"
                 sizes="(max-width: 640px) 100vw, 25vw"
                 alt="Phone Screenshot"
                 width="480"
                 height="840"
                 loading="lazy"
                 decoding="async" />
          </picture>
        </div>
      </div>
      <div class="mt-4 flex justify-center">
        <div class="w-16 h-2 bg-slate-200 rounded-full"></div>
      </div>
    </div>
  </figure>
</section>

  </main>
<!-- Trusted By Section -->
<section class="py-16 px-6 bg-gray-50">
