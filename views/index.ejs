  </div> <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8 max-w-6xl mx-auto"> 
    <% const products = [ { title: 'Homepages', file: 'product1', link: '#' },
     { title: 'Landing Pages', file: 'product2', link: '#' }, { title: 'Complete Websites', file: 'product3', link: '#' } ]; %>
      <% products.forEach((p, index) => { %> <div class="bg-white rounded-2xl shadow hover:shadow-lg transition overflow-hidden"> 
        <picture> <!-- AVIF --> <source type="image/avif" srcset="/images/<%= p.file %>-400.avif" media="(max-width: 640px)"> 
          <source type="image/avif" srcset="/images/<%= p.file %>-600.avif 600w, /images/<%= p.file %>-800.avif 800w, /images/<%= p.file %>-1200.avif 1200w" sizes="(max-width: 1024px) 50vw, 33vw"> <!-- WebP --> 
          <source type="image/webp" srcset="/images/<%= p.file %>-400.webp" media="(max-width: 640px)"> 
          <source type="image/webp" srcset="/images/<%= p.file %>-600.webp 600w, /images/<%= p.file %>-800.webp 800w, /images/<%= p.file %>-1200.webp 1200w" sizes="(max-width: 1024px) 50vw, 33vw"> <!-- JPG fallback --> 
          <img src="/images/<%= p.file %>-1200.jpg" 
          srcset="/images/<%= p.file %>-400.jpg 400w, /images/<%= p.file %>-600.jpg 600w, /images/<%= p.file %>-800.jpg 800w, /images/<%= p.file %>-1200.jpg 1200w" 
          sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw" alt="<%= p.title %>" 
          class="w-full h-48 object-cover" loading="<%= index < 2 ? 'eager' : 'lazy' %>" fetchpriority="<%= index < 2 ? 'high' : 'auto' %>" 
          style="background: url('/images/<%= p.file %>-400.jpg') center/cover blur(20px);"> 
        </picture> <div class="p-6"> <h3 class="font-semibold text-lg mb-2"><%= p.title %></h3> 
          <a href="<%= p.link %>" class="inline-block mt-2 px-4 py-2 bg-blue-600 text-white rounded-xl hover:bg-blue-700 transition"> View Details </a> 
        </div> 
        </div> <% }) %> 
      </div> 
    </section>

