<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/seo-head', {
    title: 'Showroom Ideas (Working Draft) | Auto Galleria',
    description: 'Experimental showroom homepage layout — working draft, not linked from navigation.',
    robots: 'noindex, nofollow'
  }) %>
  <link rel="stylesheet" href="/css/tailwind.css" />
</head>
<body class="bg-slate-50 text-slate-900">

  <a class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-60 bg-black text-white px-4 py-2 rounded transition" href="#main-content">Skip to main content</a>

  <%- include('partials/navbar') %>

  <section class="relative overflow-hidden bg-slate-900">
    <div class="absolute inset-0 bg-linear-to-br from-slate-900 via-blue-900 to-slate-800"></div>
    <div class="absolute -top-24 -left-16 h-64 w-64 rounded-full bg-blue-500/30 blur-3xl"></div>
    <div class="absolute -bottom-24 right-0 h-72 w-72 rounded-full bg-cyan-400/20 blur-3xl"></div>

    <div class="relative mx-auto max-w-7xl px-4 pt-28 pb-20 text-white sm:px-6 sm:pt-32 sm:pb-24 lg:px-8">
      <p class="section-eyebrow text-blue-300">Auto Galleria Showroom</p>
      <h1 class="max-w-2xl text-4xl font-bold leading-tight sm:text-5xl lg:text-6xl">Quality used cars, ready to drive home.</h1>
      <p class="mt-6 max-w-xl text-lg text-slate-200">Every vehicle is hand-picked, fully inspected and photographed in detail so you know exactly what you're buying — before you even step in the showroom.</p>

      <div class="mt-8 flex flex-wrap gap-4">
        <a href="/cars" class="btn-primary">Browse all stock</a>
        <a href="/sell-your-car" class="btn-secondary">Get a free valuation</a>
      </div>
    </div>
  </section>

  <main id="main-content" class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">

    <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="section-eyebrow">Available now</p>
        <h2 class="text-3xl font-bold text-slate-900">Fresh to the showroom</h2>
      </div>
      <a href="/cars" class="font-semibold text-blue-700 hover:text-blue-800">View all stock &rarr;</a>
    </div>

    <% if (!cars.length) { %>
      <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center shadow-sm">
        <h3 class="text-xl font-semibold">No cars available right now</h3>
        <p class="mt-2 text-slate-600">Please check back soon for fresh stock.</p>
      </div>
    <% } else { %>
      <div class="grid gap-8 sm:grid-cols-2 xl:grid-cols-3">
        <% cars.forEach(car => { %>
          <%- include('partials/vehicle-card', { vehicle: car, compact: true }) %>
        <% }) %>
      </div>
    <% } %>

    <div class="mt-20">
      <p class="section-eyebrow">Why buy from us</p>
      <h2 class="text-3xl font-bold text-slate-900">A better way to buy your next car</h2>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">

        <div class="rounded-2xl border border-blue-100 bg-white p-6 transition hover:shadow-lg">
          <div class="mb-4 inline-flex h-11 w-11 items-center justify-center rounded-xl border border-blue-200 bg-blue-50 text-blue-700">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="h-5 w-5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
          </div>
          <h3 class="mb-2 font-semibold text-slate-900">Every car inspected</h3>
          <p class="text-sm text-slate-600">Full HPI check and multi-point inspection on every vehicle we list.</p>
        </div>

        <div class="rounded-2xl border border-amber-100 bg-white p-6 transition hover:shadow-lg">
          <div class="mb-4 inline-flex h-11 w-11 items-center justify-center rounded-xl border border-amber-200 bg-amber-50 text-amber-700">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="h-5 w-5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.75V12A2.25 2.25 0 0 1 4.5 9.75h15A2.25 2.25 0 0 1 21.75 12v.75m-19.5 0v4.5A2.25 2.25 0 0 0 4.5 19.5h15a2.25 2.25 0 0 0 2.25-2.25v-4.5m-19.5 0h19.5M6.75 9.75V6.75A2.25 2.25 0 0 1 9 4.5h6a2.25 2.25 0 0 1 2.25 2.25v3" /></svg>
          </div>
          <h3 class="mb-2 font-semibold text-slate-900">Transparent pricing</h3>
          <p class="text-sm text-slate-600">No hidden fees — the price you see is the price you pay.</p>
        </div>

        <div class="rounded-2xl border border-emerald-100 bg-white p-6 transition hover:shadow-lg">
          <div class="mb-4 inline-flex h-11 w-11 items-center justify-center rounded-xl border border-emerald-200 bg-emerald-50 text-emerald-700">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="h-5 w-5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.87H14.25M16.5 18.75h-2.25m0-11.177v11.177m0-11.177c0-.621-.504-1.125-1.125-1.125h-2.25c-.621 0-1.125.504-1.125 1.125m4.5 0v11.177m0-11.177L18 9m0 0h3.75M18 9V6.75" /></svg>
          </div>
          <h3 class="mb-2 font-semibold text-slate-900">Nationwide delivery</h3>
          <p class="text-sm text-slate-600">We deliver to your door, or collect in person at our showroom.</p>
        </div>

        <div class="rounded-2xl border border-rose-100 bg-white p-6 transition hover:shadow-lg">
          <div class="mb-4 inline-flex h-11 w-11 items-center justify-center rounded-xl border border-rose-200 bg-rose-50 text-rose-700">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="h-5 w-5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-3.99 8.25-8.906 8.25a9.735 9.735 0 0 1-3.211-.533l-3.55.987a.75.75 0 0 1-.92-.92l.987-3.55A9.735 9.735 0 0 1 3 12c0-4.556 3.99-8.25 8.906-8.25S21 7.444 21 12Z" /></svg>
          </div>
          <h3 class="mb-2 font-semibold text-slate-900">Real support</h3>
          <p class="text-sm text-slate-600">Chat with the team on WhatsApp or by phone throughout the process.</p>
        </div>

      </div>
    </div>

    <div class="mt-20 rounded-3xl border border-slate-200 bg-white p-8 text-center shadow-sm sm:p-10">
      <p class="section-eyebrow">Sell to us</p>
      <h2 class="text-2xl font-bold text-slate-900 sm:text-3xl">Got a car to sell? Get a free valuation today.</h2>
      <p class="mx-auto mt-3 max-w-xl text-slate-600">Quick offers, secure payment and nationwide collection — no need to list it yourself.</p>
      <a href="/sell-your-car" class="btn-primary mt-6">Get my free valuation</a>
    </div>

  </main>

  <%- include('partials/footer') %>
  <%- include('partials/whatsapp-float', { car: null }) %>

</body>
</html>
