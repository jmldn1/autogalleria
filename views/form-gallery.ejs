    /* Miniature previews below reproduce the demo app's own form screens at scale — not part of the brochure's type/color system. */
    .thumb { position: relative; height: 168px; overflow: hidden; }
    .thumb.dark-full { background: #0f172a; }
    .thumb-body { position: relative; height: 168px; }
    .thumb-real { position: relative; width: 320px; height: 200px; overflow: hidden; background: #0f172a; margin: 0 auto; }
