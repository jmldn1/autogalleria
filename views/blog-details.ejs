<%
  const pageTitle = blog.title || 'Auto Galleria Blog';
  const pageDescription = blog.excerpt || (typeof blog.content === 'string' ? blog.content.replace(/<[^>]*>/g, ' ').trim().slice(0, 160) : 'Read the latest insights from Auto Galleria.');
  const canonicalUrl = `${process.env.SITE_URL || 'https://autogalleria.co.uk'}/blog/${blog.slug || ''}`;
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle %> | Auto Galleria Blog</title>
  <meta name="description" content="<%= pageDescription %>">
  <link rel="canonical" href="<%= canonicalUrl %>" />
  <meta property="og:type" content="article" />
  <meta property="og:title" content="<%= pageTitle %> | Auto Galleria Blog" />
  <meta property="og:description" content="<%= pageDescription %>" />
  <meta property="og:url" content="<%= canonicalUrl %>" />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="stylesheet" href="/css/tailwind.css" />
</head>
<%
  const publishedDate = blog.createdAt ? new Date(blog.createdAt).toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric'
  }) : '';
  const readingTime = Math.max(1, Math.ceil(((blog.content || '').replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length || 180) / 180));
  const heroSources = blog.imageManifest?.sources;
  const heroAvifSrcset = heroSources?.avif?.map(src => `${src.url} ${src.w}w`).join(', ');
  const heroWebpSrcset = heroSources?.webp?.map(src => `${src.url} ${src.w}w`).join(', ');
  const heroJpgSrcset = heroSources?.jpg?.map(src => `${src.url} ${src.w}w`).join(', ');
  const heroJpgSrc = heroSources?.jpg?.[heroSources?.jpg?.length - 1]?.url || blog.coverImage;
%>
<body class="bg-slate-50 text-slate-800 antialiased">

  <%- include('partials/navbar') %>

  <main class="pb-16 pt-14 sm:pt-16">
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
        <a href="/blog" class="text-sm font-medium text-blue-700 transition hover:text-blue-900">Back to blog</a>
        <div class="mt-8 text-xs font-semibold uppercase tracking-[0.16em] text-slate-500">Auto Galleria Blog</div>
        <h1 class="mt-3 text-4xl font-semibold tracking-tight text-slate-950 sm:text-5xl lg:text-6xl"><%= blog.title %></h1>
        <% if (blog.excerpt) { %>
          <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-600 sm:text-xl"><%= blog.excerpt %></p>
        <% } %>
        <div class="mt-7 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-slate-500">
          <span><%= publishedDate %></span>
          <span aria-hidden="true" class="text-slate-300">|</span>
          <span><%= readingTime %> min read</span>
        </div>
      </div>
    </header>

    <% if (heroAvifSrcset || heroWebpSrcset || heroJpgSrc || blog.coverImage) { %>
      <div class="mx-auto max-w-7xl px-4 pt-8 sm:px-6 lg:px-8">
        <div class="aspect-video overflow-hidden rounded-lg bg-slate-200">
          <% if (heroAvifSrcset || heroWebpSrcset || heroJpgSrc) { %>
            <picture>
              <% if (heroAvifSrcset) { %>
                <source type="image/avif" srcset="<%= heroAvifSrcset %>" sizes="(max-width: 768px) 100vw, 1152px">
              <% } %>
              <% if (heroWebpSrcset) { %>
                <source type="image/webp" srcset="<%= heroWebpSrcset %>" sizes="(max-width: 768px) 100vw, 1152px">
              <% } %>
              <img src="<%= heroJpgSrc %>" srcset="<%= heroJpgSrcset %>" sizes="(max-width: 768px) 100vw, 1152px" alt="<%= blog.title %>" class="h-full w-full object-cover" />
            </picture>
          <% } else { %>
            <img src="<%= blog.coverImage %>" alt="<%= blog.title %>" class="h-full w-full object-cover" />
          <% } %>
        </div>
      </div>
    <% } %>

    <article class="mx-auto max-w-3xl px-4 pb-4 pt-10 sm:px-6 sm:pt-14 lg:px-8">
      <div class="prose prose-lg max-w-none prose-headings:scroll-mt-28 prose-headings:font-semibold prose-a:text-blue-700 hover:prose-a:underline prose-img:rounded-lg prose-p:leading-8 prose-li:leading-8">
        <%- blog.content %>
      </div>
    </article>

    <% if (relatedBlogs.length) { %>
      <section class="mx-auto mt-12 max-w-7xl border-t border-slate-200 px-4 pt-12 sm:px-6 lg:px-8">
        <h2 class="text-2xl font-semibold tracking-tight text-slate-950">Related posts</h2>
        <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <% relatedBlogs.forEach(r => { %>
          <%- include('partials/blog-card', { post: r, compact: true }) %>
        <% }) %>
        </div>
      </section>
    <% } %>
  </main>

  <%- include('partials/footer') %>

</body>
</html>