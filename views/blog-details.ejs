<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= blog.title %> | Auto Galleria Blog</title>
  <meta name="description" content="<%= blog.excerpt || blog.title %>">

  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 text-gray-800 antialiased">

  <!-- NAVBAR -->
  <%- include('partials/navbar') %>

  <!-- HERO -->
  <header class="relative bg-gray-900 text-white">
    <div class="max-w-5xl mx-auto px-4 py-24 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold mb-6">
        <%= blog.title %>
      </h1>
      <p class="max-w-2xl mx-auto text-lg text-gray-300">
        <%= blog.excerpt %>
      </p>
      <div class="mt-6 text-sm text-gray-400">
        Posted <%= blog.createdAt.toDateString() %> • by Auto Galleria
      </div>
    </div>
    <% if (blog.coverImage) { %>
      <img src="<%= blog.coverImage %>" alt="<%= blog.title %>" class="absolute inset-0 w-full h-full object-cover opacity-30" />
    <% } %>
  </header>

  <!-- BLOG CONTENT -->
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 bg-white rounded-xl shadow-sm -mt-12 relative z-10">
    <article class="prose prose-lg max-w-none prose-img:rounded-lg prose-headings:font-semibold prose-a:text-blue-600 hover:prose-a:underline">
      <%- blog.content %>
    </article>
  </main>

  <!-- RELATED POSTS -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <h2 class="text-2xl font-bold text-gray-900 mb-8">Related Posts</h2>
    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      <% relatedBlogs.forEach(r => { %>
        <a href="/blog/<%= r.slug %>" class="block bg-white rounded-xl shadow hover:shadow-md transition overflow-hidden">
          <% if (r.coverImage) { %>
            <img src="<%= r.coverImage %>" alt="<%= r.title %>" class="w-full h-48 object-cover" />
          <% } %>
          <div class="p-6">
            <h3 class="font-semibold text-lg mb-2"><%= r.title %></h3>
            <p class="text-gray-600 text-sm"><%= r.excerpt %></p>
          </div>
        </a>
      <% }) %>
    </div>
  </section>

  <!-- FOOTER -->
  <%- include('partials/footer') %>

</body>
</html>
