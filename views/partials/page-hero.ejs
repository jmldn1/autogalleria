<%
/*
  Simple dark hero for content pages (cars, blog, etc).
  Locals:
    eyebrow     - optional small label above the title
    title       - required heading text
    description - optional supporting paragraph
    align       - optional 'center' (default) or 'left'
*/
const heroAlign = typeof align !== 'undefined' && align === 'left' ? 'left' : 'center';
%>
<section class="bg-slate-900 text-white">
  <div class="mx-auto max-w-7xl px-4 pt-28 pb-16 sm:px-6 sm:pt-32 sm:pb-20 lg:px-8<%= heroAlign === 'center' ? ' text-center' : '' %>">
    <% if (typeof eyebrow !== 'undefined' && eyebrow) { %>
      <p class="section-eyebrow text-blue-300"><%= eyebrow %></p>
    <% } %>
    <h1 class="text-4xl font-bold sm:text-5xl<%= heroAlign === 'left' ? ' max-w-3xl' : '' %>"><%= title %></h1>
    <% if (typeof description !== 'undefined' && description) { %>
      <p class="mt-6 max-w-2xl text-lg text-slate-300<%= heroAlign === 'center' ? ' mx-auto' : '' %>"><%= description %></p>
    <% } %>
  </div>
</section>
