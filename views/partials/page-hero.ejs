<%
/*
  Simple dark hero for content pages (cars, blog, etc).
  Locals:
    eyebrow     - optional small label above the title
    title       - required heading text
    description - optional supporting paragraph
*/
%>
<section class="bg-slate-900 text-white">
  <div class="mx-auto max-w-7xl px-4 pt-28 pb-16 text-center sm:px-6 sm:pt-32 sm:pb-20 lg:px-8">
    <% if (typeof eyebrow !== 'undefined' && eyebrow) { %>
      <p class="mb-4 text-sm font-semibold uppercase tracking-[0.3em] text-blue-300"><%= eyebrow %></p>
    <% } %>
    <h1 class="text-4xl font-bold sm:text-5xl"><%= title %></h1>
    <% if (typeof description !== 'undefined' && description) { %>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-300"><%= description %></p>
    <% } %>
  </div>
</section>
