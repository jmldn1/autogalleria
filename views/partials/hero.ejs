<%
// Expecting heroImage: { sources: { avif, webp, jpg }, alt: string }
// heroImage.sources.avif/webp/jpg should each be an array matching the sizes in imageService.js
%>

<%
  const heroAlt = heroImage.alt || (typeof landing !== 'undefined' && landing ? `Photo of ${landing.make} ${landing.model}` : '');
  const heroFallback =
    (heroImage.sources && heroImage.sources.jpg && heroImage.sources.jpg[2]) ||
    (heroImage.sources && heroImage.sources.jpg && heroImage.sources.jpg[0]) ||
    (heroImage.sources && heroImage.sources.webp && heroImage.sources.webp[0]) ||
    (heroImage.sources && heroImage.sources.avif && heroImage.sources.avif[0]) ||
    null;
  const heroSrc = heroFallback ? heroFallback.url : heroImage.base;
  const heroWidth = heroFallback && heroFallback.w ? heroFallback.w : 1600;
  const heroHeight = heroFallback && heroFallback.h ? heroFallback.h : 900;
%>
<picture class="absolute inset-0 z-0">
  <!-- AVIF sources -->
  <% if (heroImage.sources.avif) { %>
    <source 
      type="image/avif" 
      srcset="<%= heroImage.sources.avif.map(img => `${img.url} ${img.w}w`).join(', ') %>"
      sizes="(max-width: 640px) 480px, (max-width: 1024px) 800px, (max-width: 1440px) 1200px, (max-width: 1920px) 1600px, 2400px">
  <% } %>

  <!-- WebP sources -->
  <% if (heroImage.sources.webp) { %>
    <source 
      type="image/webp" 
      srcset="<%= heroImage.sources.webp.map(img => `${img.url} ${img.w}w`).join(', ') %>"
      sizes="(max-width: 640px) 480px, (max-width: 1024px) 800px, (max-width: 1440px) 1200px, (max-width: 1920px) 1600px, 2400px">
  <% } %>

  <!-- Fallback JPG -->
  <img
    src="<%= heroSrc %>"
    srcset="<%= heroImage.sources.jpg.map(img => `${img.url} ${img.w}w`).join(', ') %>"
    sizes="(max-width: 640px) 480px, (max-width: 1024px) 800px, (max-width: 1440px) 1200px, (max-width: 1920px) 1600px, 2400px"
    width="<%= heroWidth %>"
    height="<%= heroHeight %>"
    alt="<%= heroAlt %>"
    aria-hidden="<%= heroAlt ? 'false' : 'true' %>"
    class="absolute inset-0 w-full h-full object-cover"
    loading="eager"
    fetchpriority="high">
</picture>
