<%
  const cardPost = post || {};
  const postHref = (typeof href !== 'undefined' && href) || `/blog/${cardPost.slug || cardPost._id || ''}`;
  const isCompact = Boolean(typeof compact !== 'undefined' && compact);
  const sources = cardPost.imageManifest?.sources;
  const avifSrcset = sources?.avif?.map(src => `${src.url} ${src.w}w`).join(', ');
  const webpSrcset = sources?.webp?.map(src => `${src.url} ${src.w}w`).join(', ');
  const jpgSrcset = sources?.jpg?.map(src => `${src.url} ${src.w}w`).join(', ');
  const fallbackSrc = sources?.jpg?.[sources.jpg.length - 1]?.url || cardPost.coverImage;
  const previewText = cardPost.excerpt || (typeof cardPost.content === 'string' ? cardPost.content.replace(/<[^>]*>/g, ' ').trim().slice(0, 120) : '');
  const postedDate = cardPost.createdAt ? new Date(cardPost.createdAt).toDateString() : 'Recently published';
%>
<a href="<%= postHref %>" class="card card-hover block">
  <% if (avifSrcset || webpSrcset || jpgSrcset) { %>
    <picture>
      <% if (avifSrcset) { %>
        <source type="image/avif" srcset="<%= avifSrcset %>" sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw" />
      <% } %>
      <% if (webpSrcset) { %>
        <source type="image/webp" srcset="<%= webpSrcset %>" sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw" />
      <% } %>
      <img
        src="<%= fallbackSrc %>"
        srcset="<%= jpgSrcset %>"
        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
        alt="<%= cardPost.title || 'Blog post' %>"
        class="h-48 w-full object-cover"
        loading="lazy"
      />
    </picture>
  <% } else if (cardPost.coverImage) { %>
    <img src="<%= cardPost.coverImage %>" alt="<%= cardPost.title || 'Blog post' %>" class="h-48 w-full object-cover" loading="lazy" />
  <% } %>
  <div class="<%= isCompact ? 'p-5' : 'p-6' %>">
    <h2 class="text-xl font-semibold text-slate-900"><%= cardPost.title || 'Untitled post' %></h2>
    <% if (previewText) { %>
      <p class="mt-2 text-sm leading-6 text-slate-600 line-clamp-3"><%= previewText %><%= previewText.length >= 120 ? '...' : '' %></p>
    <% } %>
    <% if (!isCompact) { %>
      <div class="mt-4 text-xs text-slate-400">Posted <%= postedDate %></div>
    <% } %>
  </div>
</a>
