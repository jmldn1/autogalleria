<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Auto Galleria Blog</title>
  <meta name="description" content="Read the latest car news, reviews, and guides from Auto Galleria.">
  <link rel="canonical" href="<%= (process.env.SITE_URL || 'https://autogalleria.co.uk') + '/blog' %>" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="Auto Galleria Blog" />
  <meta property="og:description" content="Read the latest car news, reviews, and guides from Auto Galleria." />
  <meta property="og:url" content="<%= (process.env.SITE_URL || 'https://autogalleria.co.uk') + '/blog' %>" />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="stylesheet" href="/css/tailwind.css" />
</head>
<body class="bg-slate-50 text-slate-800 antialiased">

  <!-- NAVBAR -->
  <%- include('partials/navbar') %>

  <!-- HERO -->
  <header class="bg-slate-900 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center">
      <h1 class="text-4xl sm:text-5xl font-bold mb-6">Auto Galleria Blog</h1>
      <p class="max-w-2xl mx-auto text-lg text-slate-300">
        Stay updated with car reviews, tips, and automotive insights.
      </p>
    </div>
  </header>

  <!-- BLOG LIST -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-3">
      <% blogs.forEach(blog => { %>
        <%- include('partials/blog-card', { post: blog }) %>
      <% }) %>
    </div>
  </main>

  <!-- FOOTER -->
  <%- include('partials/footer') %>

</body>
</html>
