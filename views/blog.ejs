<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Auto Galleria Blog</title>
  <meta name="description" content="Read the latest car news, reviews, and guides from Auto Galleria.">

  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 text-gray-800 antialiased">

  <!-- NAVBAR -->
  <%- include('partials/navbar') %>

  <!-- HERO -->
  <header class="bg-gray-900 text-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center">
      <h1 class="text-4xl sm:text-5xl font-bold mb-6">Auto Galleria Blog</h1>
      <p class="max-w-2xl mx-auto text-lg text-gray-300">
        Stay updated with car reviews, tips, and automotive insights.
      </p>
    </div>
  </header>

  <!-- BLOG LIST -->
  <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-3">
      <% blogs.forEach(blog => { %>
        <a href="/blog/<%= blog.slug %>" class="block bg-white rounded-xl shadow hover:shadow-lg transition overflow-hidden">
          <% if (blog.coverImage) { %>
            <img src="<%= blog.coverImage %>" alt="<%= blog.title %>" class="w-full h-48 object-cover" />
          <% } %>
          <div class="p-6">
            <h2 class="text-xl font-semibold text-gray-900 mb-2"><%= blog.title %></h2>
            <p class="text-gray-600 text-sm mb-4 line-clamp-3">
              <%= blog.excerpt || blog.content.substring(0, 120) %>...
            </p>
            <div class="text-xs text-gray-400">
              Posted <%= blog.createdAt.toDateString() %>
            </div>
          </div>
        </a>
      <% }) %>
    </div>
  </main>

  <!-- FOOTER -->
  <%- include('partials/footer') %>

</body>
</html>
