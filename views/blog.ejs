<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/seo-head', {
    title: 'Auto Galleria Blog',
    description: 'Read the latest car news, reviews, and guides from Auto Galleria.'
  }) %>

  <link rel="stylesheet" href="/css/tailwind.css" />
</head>
<body class="bg-slate-50 text-slate-800 antialiased">

  <!-- NAVBAR -->
  <%- include('partials/navbar') %>

  <!-- HERO -->
  <header class="bg-slate-900 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center">
      <h1 class="text-4xl sm:text-5xl font-bold mb-6">Auto Galleria Blog</h1>
      <p class="max-w-2xl mx-auto text-lg text-slate-300">
        Stay updated with car reviews, tips, and automotive insights.
      </p>
    </div>
  </header>

  <!-- BLOG LIST -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-3">
      <% blogs.forEach(blog => { %>
        <%- include('partials/blog-card', { post: blog }) %>
      <% }) %>
    </div>
  </main>

  <!-- FOOTER -->
  <%- include('partials/footer') %>

</body>
</html>
