<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Make an offer for <%= car.make %> <%= car.model %> at LHD Cars Wanted">
  <title>Make Offer | <%= car.make %> <%= car.model %> | LHD Cars Wanted</title>
  <link rel="stylesheet" href="/css/tailwind.css" />
  <link rel="stylesheet" href="/css/styles.css">

  <!-- JSON-LD structured data (Vehicle + BuyAction + FAQ) -->
  <script type="application/ld+json">
    ... your structured data here ...
  </script>
</head>
<body class="bg-gray-50 text-gray-800">
<%- include('partials/navbar', { activePage: 'cars' }) %>

<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
  <!-- Breadcrumb -->
  <nav class="text-sm mb-4" aria-label="Breadcrumb">
    <ol class="flex flex-wrap space-x-2 text-gray-600">
      <li><a href="/" class="hover:text-blue-600">Home</a> /</li>
      <li><a href="/cars" class="hover:text-blue-600">Cars For Sale</a> /</li>
      <li><a href="/cars/<%= car.slug %>" class="hover:text-blue-600"><%= car.make %> <%= car.model %></a> /</li>
      <li class="text-gray-900">Make Offer</li>
    </ol>
  </nav>

  <h1 class="text-2xl font-semibold mb-6">
    Make Your Offer for <%= car.year %> <%= car.make %> <%= car.model %>
  </h1>

  <div class="grid lg:grid-cols-12 gap-6">
    <!-- Car Summary -->
    <div class="lg:col-span-5">
      <div class="bg-white rounded-xl shadow">
        <img src="<%= car.galleryImagesMedRes[0] || '/images/default-car.webp' %>" 
             alt="<%= car.make %> <%= car.model %>" 
             class="w-full h-64 object-cover rounded-t-xl">
        <div class="p-4">
          <h2 class="text-xl font-semibold mb-1"><%= car.make %> <%= car.model %></h2>
          <p class="text-gray-600 mb-3">£<%= car.price.toLocaleString() %></p>
          <ul class="divide-y divide-gray-200 text-sm">
            <li class="py-1"><strong>Year:</strong> <%= car.year %></li>
            <li class="py-1"><strong>Mileage:</strong> <%= car.mileage.toLocaleString() %> miles</li>
            <li class="py-1"><strong>Engine:</strong> <%= car.engine %></li>
            <li class="py-1"><strong>Transmission:</strong> <%= car.transmission %></li>
            <li class="py-1">
              <strong>VIN:</strong>
              <% if (car.vin && car.vin.trim() !== '') { %>
                <% 
                  let displayVin;
                  if (car.vin.length >= 17) {
                    displayVin = car.vin.slice(0, car.vin.length - 6) + '******';
                  } else {
                    displayVin = car.vin; 
                  }
                %>
                <%= displayVin %>
              <% } else { %>
                N/A
              <% } %>
            </li>
          </ul>
          <a href="/cars/<%= car.slug %>" 
             class="mt-4 block text-center w-full rounded-lg border border-gray-300 py-2 text-gray-700 hover:bg-gray-100">
            Back to Details
          </a>
        </div>
      </div>
    </div>

    <!-- Offer Form -->
    <div class="lg:col-span-7">
      <div class="bg-white rounded-xl shadow p-6">
        <h2 class="text-xl font-semibold mb-4">Make Your Offer</h2>

        <% if (typeof success_msg !== 'undefined' && success_msg.length > 0) { %>
          <div class="mb-4 p-3 rounded bg-green-100 text-green-800"><%= success_msg %></div>
        <% } %>
        <% if (typeof error_msg !== 'undefined' && error_msg.length > 0) { %>
          <div class="mb-4 p-3 rounded bg-red-100 text-red-800"><%= error_msg %></div>
        <% } %>

        <form action="/cars/<%= car.slug %>/make-offer" method="POST" class="space-y-4">
          <input type="hidden" name="carId" value="<%= car._id %>">

          <div>
            <label for="offer" class="block text-sm font-medium">Your Offer (£)</label>
            <input type="number" id="offer" name="offer" required min="500"
                   class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500">
          </div>

          <div>
            <label for="name" class="block text-sm font-medium">Full Name</label>
            <input type="text" id="name" name="name" placeholder="John Doe" required
                   class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500">
          </div>

          <div>
            <label for="email" class="block text-sm font-medium">Email</label>
            <input type="email" id="email" name="email" placeholder="you@example.com" required
                   class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500">
          </div>

          <div>
            <label for="phone" class="block text-sm font-medium">Phone (optional)</label>
            <input type="tel" id="phone" name="phone" placeholder="07123 456789"
                   class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500">
          </div>

          <div>
            <label for="message" class="block text-sm font-medium">Message (optional)</label>
            <textarea id="message" name="message" rows="4" placeholder="Any additional details..."
                      class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500"></textarea>
          </div>

          <button type="submit" 
                  class="w-full flex items-center justify-center gap-2 bg-blue-600 text-white font-medium py-3 rounded-lg hover:bg-blue-700">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 16 16">
              <path d="M15.964.686a.5.5 0 0 0-.65-.65L.767 5.855H.766l-.452.18a.5.5 
              0 0 0-.082.887l.41.26.001.002 4.995 3.178 3.178 4.995.002.002.26.41a.5.5 
              0 0 0 .886-.083zm-1.833 1.89L6.637 10.07l-.215-.338a.5.5 
              0 0 0-.154-.154l-.338-.215 7.494-7.494 1.178-.471z"/>
            </svg>
            Submit Offer
          </button>
        </form>

        <!-- Trust / reassurance -->
        <div class="mt-6">
          <h5 class="font-medium">Why Make an Offer With Us?</h5>
          <ul class="mt-2 space-y-1 text-sm text-gray-700">
            <li>✅ No obligation – free to make an offer</li>
            <li>🔒 Secure & confidential process</li>
            <li>⭐ Trusted dealer with 5-star reviews</li>
            <li>🚗 All vehicles HPI checked</li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <!-- FAQ -->
  <section class="mt-10">
    <h3 class="text-xl font-semibold mb-4">Frequently Asked Questions</h3>
    <div class="space-y-3">
      <details class="bg-white rounded-lg shadow p-4">
        <summary class="font-medium cursor-pointer">Is my offer legally binding?</summary>
        <p class="mt-2 text-sm text-gray-600">
          No — your offer is simply an expression of interest. We’ll contact you to discuss further.
        </p>
      </details>
      <details class="bg-white rounded-lg shadow p-4">
        <summary class="font-medium cursor-pointer">Do I need to pay a deposit?</summary>
        <p class="mt-2 text-sm text-gray-600">
          No deposit is required to make an offer. Payment terms will be discussed if your offer is accepted.
        </p>
      </details>
      <details class="bg-white rounded-lg shadow p-4">
        <summary class="font-medium cursor-pointer">Can I arrange delivery after purchase?</summary>
        <p class="mt-2 text-sm text-gray-600">
          Yes, we can help arrange UK or international delivery at competitive rates.
        </p>
      </details>
    </div>
  </section>
</main>

<%- include('partials/footer') %>

<!-- Sticky Buttons (Mobile) -->
<div class="fixed bottom-0 inset-x-0 bg-white border-t shadow-inner p-3 flex justify-around md:hidden">
  <a href="https://wa.me/447447430488?text=I%20want%20to%20make%20an%20offer%20on%20<%= encodeURIComponent(car.make + ' ' + car.model + ' ' + car.year) %>" 
     target="_blank"
     class="flex items-center gap-2 bg-green-500 text-white rounded-lg px-4 py-2">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="currentColor" viewBox="0 0 16 16">
      <path d="M13.601 2.326A7.85 7.85 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399..."/>
    </svg>
    WhatsApp
  </a>
  <a href="mailto:<%= car.sellerEmail || 'sales@lhdcarswanted.co.uk' %>?subject=Offer%20for%20<%= encodeURIComponent(car.make + ' ' + car.model) %>" 
     class="flex items-center gap-2 bg-blue-600 text-white rounded-lg px-4 py-2">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="currentColor" viewBox="0 0 16 16">
      <path d="M.05 3.555A2 2 0 0 1 2 2h12a2 2..."/>
    </svg>
    Email
  </a>
</div>

<script src="/js/scroll-navbar.js" defer></script>
</body>
</html>
