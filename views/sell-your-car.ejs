<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/seo-head', {
    title: 'Sell Your Car | Auto Galleria',
    description: 'Tell Auto Galleria about the vehicle you would like to sell or send us any vehicle sale enquiry.'
  }) %>
  <link rel="stylesheet" href="/css/tailwind.css">
</head>
<body class="bg-slate-100 text-slate-800">
  <%- include('partials/navbar') %>

  <main>
    <%- include('partials/page-hero', {
      eyebrow: 'Vehicle sale enquiries',
      title: 'Sell your car to us.',
      description: 'Whether you are ready to sell or want a valuation we would love to hear from you',
      align: 'left'
    }) %>

    <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-16 lg:px-8">
      <div class="grid gap-8 lg:grid-cols-5 lg:items-start">
        <section class="rounded-3xl border border-blue-100 bg-blue-50 p-6 shadow-lg sm:p-8 lg:col-span-3" aria-labelledby="enquiry-heading">
          <div id="formAlerts" class="<% if (sent || error || rateLimited) { %>mb-6 space-y-3<% } %>">
            <% if (sent) { %>
              <div class="flex items-start gap-2 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-emerald-800" role="status">
                <svg class="mt-0.5 h-5 w-5 shrink-0 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span>Thank you. Your enquiry has been sent and we will be in touch shortly.</span>
              </div>
            <% } %>
            <% if (error) { %>
              <div class="rounded-2xl border border-rose-200 bg-rose-50 px-4 py-3 text-rose-800" role="alert">
                Please provide your name, a valid email address, and a message before sending.
              </div>
            <% } %>
            <% if (rateLimited) { %>
              <div class="rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-amber-800" role="alert">
                Too many attempts in a short time. Please wait a few minutes and try again.
              </div>
            <% } %>
          </div>

          <h2 id="enquiry-heading" class="text-xl font-semibold text-slate-900 sm:text-2xl">Send us the details</h2>

          <form class="mt-6 space-y-5 sm:mt-8" action="/sell-your-car" method="POST">
            <div class="hidden" aria-hidden="true">
              <label for="companyWebsite">Company website</label>
              <input id="companyWebsite" name="companyWebsite" type="text" tabindex="-1" autocomplete="off">
            </div>

            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="name" class="mb-2 block text-sm font-medium text-slate-700">Name</label>
                <div class="relative">
                  <input id="name" name="name" type="text" required autocomplete="name" class="w-full rounded-xl border border-slate-300 bg-white py-3 px-4 text-slate-900 outline-none ring-blue-500 transition focus:ring-2" placeholder="Your full name">
                </div>
              </div>
              <div>
                <label for="email" class="mb-2 block text-sm font-medium text-slate-700">Email</label>
                <div class="relative">
                  <input id="email" name="email" type="email" required autocomplete="email" class="w-full rounded-xl border border-slate-300 bg-white py-3 px-4 text-slate-900 outline-none ring-blue-500 transition focus:ring-2" placeholder="you@example.com">
                </div>
              </div>
            </div>

            <div>
              <label for="registration" class="mb-2 block text-sm font-medium text-slate-700">
                Registration number <span class="font-normal text-slate-500">(optional — leave blank if imported)</span>
              </label>
              <div class="inline-flex w-full max-w-55 overflow-hidden rounded-lg border-2 border-slate-900 shadow-sm">
                <span class="flex w-8 shrink-0 items-center justify-center bg-blue-700 text-[10px] font-bold tracking-wide text-white" aria-hidden="true">UK</span>
                <input
                  id="registration"
                  name="registration"
                  type="text"
                  autocomplete="off"
                  autocapitalize="characters"
                  spellcheck="false"
                  maxlength="8"
                  class="w-full bg-[#FFD204] py-3 px-2 text-center font-mono text-lg font-extrabold uppercase tracking-[0.15em] text-slate-900 outline-none placeholder:text-slate-900/40 focus:outline-none focus:ring-2 focus:ring-blue-600"
                  placeholder="AB12 CDE"
                >
              </div>
              <p id="regLookupStatus" class="mt-2 text-sm text-slate-500" aria-live="polite">We'll try to identify your car automatically — totally optional.</p>
            </div>

            <div>
              <label for="enquiryType" class="mb-2 block text-sm font-medium text-slate-700">How can we help?</label>
              <div class="relative">
                <select id="enquiryType" name="enquiryType" class="w-full rounded-xl border border-slate-300 bg-white py-3 px-4 text-slate-900 outline-none ring-blue-500 transition focus:ring-2">
                  <option value="Sell my car">I would like to sell my car</option>
                  <option value="Vehicle valuation">I would like a valuation</option>
                  <option value="General question">I have a general question</option>
                  <option value="Collection or paperwork">Collection or paperwork query</option>
                </select>
              </div>
            </div>

            <div>
              <label for="message" class="mb-2 block text-sm font-medium text-slate-700">Your message</label>
              <div class="relative">
                <textarea id="message" name="message" rows="5" required class="w-full rounded-xl border border-slate-300 bg-white py-3 px-4 text-slate-900 outline-none ring-blue-500 transition focus:ring-2" placeholder="Tell us what you would like help with, or simply say hello."></textarea>
              </div>
              <p id="messageHint" class="mt-2 text-sm text-slate-500">A sentence or two is plenty. We can talk through the rest with you.</p>
            </div>

            <button type="button" id="moreFieldsToggle" class="text-sm font-medium text-blue-600 transition hover:text-blue-700">
              + Add phone or vehicle details <span class="font-normal text-slate-500">(optional)</span>
            </button>

            <div id="moreFields" class="hidden space-y-5">
              <div class="grid gap-5 sm:grid-cols-2">
                <div>
                  <label for="phone" class="mb-2 block text-sm font-medium text-slate-700">Phone <span class="font-normal text-slate-500">(optional)</span></label>
                  <div class="relative">
                    <input id="phone" name="phone" type="tel" autocomplete="tel" class="w-full rounded-xl border border-slate-300 bg-white py-3 px-4 text-slate-900 outline-none ring-blue-500 transition focus:ring-2" placeholder="+44 ...">
                  </div>
                </div>
                <div>
                  <label for="vehicle" class="mb-2 block text-sm font-medium text-slate-700">Vehicle details <span class="font-normal text-slate-500">(optional)</span></label>
                  <div class="relative">
                    <input id="vehicle" name="vehicle" type="text" autocomplete="off" class="w-full rounded-xl border border-slate-300 bg-white py-3 px-4 text-slate-900 outline-none ring-blue-500 transition focus:ring-2" placeholder="For example, 2017 BMW X5, 80,000 miles">
                  </div>
                </div>
              </div>
            </div>

            <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
              <button type="submit" class="btn-primary w-full sm:w-auto">Start a conversation</button>
              <% if (adminWhatsAppNumber) { %>
                <a
                  href="https://wa.me/<%= adminWhatsAppNumber %>?text=<%= encodeURIComponent('Hi Auto Galleria, I am interested in selling my car and would like to discuss it.') %>"
                  target="_blank"
                  rel="noopener"
                  class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-[#25D366] bg-white px-5 py-3 font-semibold text-[#128C4A] transition hover:bg-[#25D366]/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#25D366]/50 sm:w-auto"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="h-5 w-5" aria-hidden="true">
                    <path d="M13.601 2.326A7.96 7.96 0 0 0 8.003 0C3.58 0 .035 3.54.035 7.907c0 1.394.372 2.75 1.076 3.94L0 16l4.263-1.106a8.047 8.047 0 0 0 3.74.949h.003c4.422 0 7.968-3.539 7.968-7.906a7.868 7.868 0 0 0-2.373-5.611ZM8.003 14.5a6.64 6.64 0 0 1-3.386-.926l-.242-.143-2.53.654.675-2.464-.158-.253a6.542 6.542 0 0 1-.999-3.46c0-3.605 2.956-6.54 6.597-6.54a6.576 6.576 0 0 1 4.678 1.933 6.506 6.506 0 0 1 1.92 4.607c0 3.604-2.957 6.542-6.575 6.542Zm3.605-4.879c-.197-.098-1.172-.578-1.353-.644-.18-.066-.313-.099-.445.099-.132.198-.511.644-.625.777-.115.132-.23.148-.428.049-.198-.098-.838-.31-1.596-.99-.59-.525-.988-1.174-1.104-1.373-.115-.198-.012-.305.086-.403.088-.088.198-.23.297-.345.099-.116.132-.198.198-.33.066-.132.033-.248-.017-.347-.049-.099-.445-1.072-.61-1.47-.16-.39-.323-.337-.445-.343-.115-.006-.248-.007-.38-.007s-.347.049-.53.248c-.182.198-.695.678-.695 1.654 0 .975.712 1.917.812 2.05.099.132 1.4 2.14 3.393 3.002.474.204.843.326 1.131.417.475.151.908.13 1.25.079.381-.057 1.172-.479 1.338-.942.165-.462.165-.858.116-.942-.049-.083-.18-.132-.377-.23Z"/>
                  </svg>
                  Message on WhatsApp
                </a>
              <% } %>
            </div>
            <p class="text-sm text-slate-500">Your enquiry goes directly to our buyer. We usually reply within one working day.</p>
          </form>
        </section>

        <aside class="space-y-5 lg:col-span-2">
          <section class="overflow-hidden rounded-3xl border border-slate-200 bg-linear-to-b from-blue-50 to-white shadow-sm">
            <div class="flex items-center justify-center px-6 pt-6">
              <svg viewBox="0 0 320 170" class="h-auto w-full max-w-65" aria-hidden="true">
                <line x1="16" y1="150" x2="304" y2="150" stroke="#CBD5E1" stroke-width="2" stroke-linecap="round" />

                <path d="M180,150 L180,128 C180,120 186,116 194,114 L206,100 C210,96 216,94 222,94 L262,94 C270,94 276,98 280,106 L288,116 C296,118 300,122 300,128 L300,150 Z" fill="#DBEAFE" stroke="#2563EB" stroke-width="2.5" stroke-linejoin="round" />
                <line x1="222" y1="97" x2="222" y2="150" stroke="#2563EB" stroke-width="1.5" />

                <circle cx="200" cy="150" r="13" fill="white" stroke="#1E293B" stroke-width="2.5" />
                <circle cx="200" cy="150" r="4" fill="#1E293B" />
                <circle cx="278" cy="150" r="13" fill="white" stroke="#1E293B" stroke-width="2.5" />
                <circle cx="278" cy="150" r="4" fill="#1E293B" />

                <line x1="88" y1="116" x2="107" y2="116" stroke="#94A3B8" stroke-width="6" stroke-linecap="round" />
                <path d="M70,106 C50,106 40,124 40,150 L100,150 C100,124 90,106 70,106 Z" fill="#94A3B8" />
                <circle cx="70" cy="90" r="16" fill="#94A3B8" />

                <line x1="122" y1="116" x2="107" y2="116" stroke="#2563EB" stroke-width="6" stroke-linecap="round" />
                <path d="M140,104 C120,104 110,122 110,150 L170,150 C170,122 160,104 140,104 Z" fill="#2563EB" />
                <circle cx="140" cy="88" r="16" fill="#2563EB" />

                <circle cx="107" cy="113" r="5" fill="none" stroke="#F59E0B" stroke-width="2.5" />
                <line x1="111" y1="117" x2="119" y2="125" stroke="#F59E0B" stroke-width="2.5" stroke-linecap="round" />
                <line x1="115" y1="121" x2="112" y2="124" stroke="#F59E0B" stroke-width="2" stroke-linecap="round" />
              </svg>
            </div>
            <p class="px-6 pt-2 pb-5 text-center text-sm text-slate-600">A friendly handover — we talk you through every step in person.</p>
          </section>
          <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-blue-50 text-blue-700" aria-hidden="true">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 9h7.5M8.25 12h5.25m-8.25 8.25 2.37-2.37A2.25 2.25 0 0 1 8.46 17.25h7.29A4.5 4.5 0 0 0 20.25 12V7.5A4.5 4.5 0 0 0 15.75 3h-7.5a4.5 4.5 0 0 0-4.5 4.5V12a4.5 4.5 0 0 0 3.75 4.43" />
                </svg>
              </span>
              <h2 class="text-lg font-semibold text-slate-900">A personal first step</h2>
            </div>
            <p class="mt-4 text-sm leading-relaxed text-slate-600">There is no instant automated offer to accept here. We read every enquiry and speak with you about the car, your expectations and the best next step.</p>
          </section>
          <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
            <h2 class="text-lg font-semibold text-slate-900">What happens next</h2>
            <ol class="mt-4 text-sm text-slate-600">
              <li class="relative flex gap-3 pb-4">
                <span class="relative z-10 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-blue-600 text-xs font-semibold text-white">1</span>
                <h3 class="pt-1">We review your message and vehicle details.</h3>
                <span class="absolute left-3.5 top-7 h-full w-px bg-blue-100" aria-hidden="true"></span>
              </li>
              <li class="relative flex gap-3 pb-4">
                <span class="relative z-10 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-blue-600 text-xs font-semibold text-white">2</span>
                <h3 class="pt-1">We contact you by email or phone.</h3>
                <span class="absolute left-3.5 top-7 h-full w-px bg-blue-100" aria-hidden="true"></span>
              </li>
              <li class="flex gap-3">
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-blue-600 text-xs font-semibold text-white ring-4 ring-blue-100">3</span>
                <h3 class="pt-1">We discuss valuation, collection and paperwork.</h3>
              </li>
            </ol>
          </section>
        </aside>
      </div>
    </section>
  </main>

  <script>
    const enquiryType = document.getElementById('enquiryType');
    const messageHint = document.getElementById('messageHint');
    const message = document.getElementById('message');

    const enquiryGuidance = {
      'Sell my car': 'A sentence or two is plenty. We can talk through the rest with you.',
      'Vehicle valuation': 'Tell us anything you know about the car and what you would like to understand about its value.',
      'General question': 'Ask your question in your own words. We will point you in the right direction.',
      'Collection or paperwork': 'Tell us what you need to arrange and, if relevant, where the vehicle is located.',
    };

    enquiryType.addEventListener('change', () => {
      messageHint.textContent = enquiryGuidance[enquiryType.value] || enquiryGuidance['Sell my car'];
      message.focus();
    });

    const moreFieldsToggle = document.getElementById('moreFieldsToggle');
    const moreFields = document.getElementById('moreFields');
    moreFieldsToggle.addEventListener('click', () => {
      moreFields.classList.remove('hidden');
      moreFieldsToggle.classList.add('hidden');
      document.getElementById('phone').focus();
    });

    const registration = document.getElementById('registration');
    const regLookupStatus = document.getElementById('regLookupStatus');
    const vehicle = document.getElementById('vehicle');
    let lastCheckedReg = '';

    registration.addEventListener('input', () => {
      registration.value = registration.value.toUpperCase();
    });

    registration.addEventListener('blur', async () => {
      const reg = registration.value.replace(/\s+/g, '');
      if (!reg || reg.length < 2 || reg === lastCheckedReg) return;
      lastCheckedReg = reg;

      try {
        const res = await fetch('/api/lookup', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ reg }),
        });
        const data = await res.json();
        if (!res.ok || !data || data.source === 'manual') return;

        const summary = [data.year, data.make, data.model].filter(Boolean).join(' ');
        if (!summary) return;

        regLookupStatus.textContent = `✓ ${summary} identified — you can edit the details below.`;

        if (!vehicle.value.trim()) {
          vehicle.value = [summary, data.color, data.fuelType].filter(Boolean).join(', ');
        }
        moreFields.classList.remove('hidden');
        moreFieldsToggle.classList.add('hidden');
      } catch (err) {
        // Optional field — foreign plates, typos and lookup failures should stay silent, not read as errors.
      }
    });

    const formAlerts = document.getElementById('formAlerts');
    if (formAlerts && formAlerts.children.length) {
      formAlerts.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  </script>

  <%- include('partials/footer') %>
</body>
</html>
