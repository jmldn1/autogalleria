<!-- SELL ENQUIRY FORM -->
<section id="lead-form" class="relative min-h-screen flex items-center justify-center p-6 text-white overflow-hidden">

  <% if (landing.imageManifest) { %>
    <%- include('partials/hero', { heroImage: landing.imageManifest }) %>
  <% } else { %>
    <div class="absolute inset-0 bg-gray-900"></div>
  <% } %>

  <!-- Dark overlay -->
  <div class="absolute inset-0 bg-black/60 z-10"></div>

  <div class="relative z-20 w-full max-w-md">

    <!-- Header -->
    <div class="mb-8 text-center">
      <div class="inline-flex items-center justify-center w-14 h-14 rounded-xl bg-gradient-to-br from-blue-500 to-cyan-500 mb-4">
        💰
      </div>
      <h2 class="text-4xl font-bold mb-2 drop-shadow-lg">Your Details</h2>
      <p class="text-gray-200">We'll be in touch with your offer</p>
    </div>

    <!-- Vehicle summary pill (populated by JS) -->
    <div id="lf-vehicle-pill" class="hidden mb-6 flex items-center gap-3 px-4 py-3 rounded-xl bg-white/10 backdrop-blur border border-white/20">
      <div class="w-8 h-8 rounded-lg bg-emerald-500/30 border border-emerald-500/40 flex items-center justify-center flex-shrink-0">
        <svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
        </svg>
      </div>
      <div>
        <p id="lf-vehicle-name" class="text-white font-semibold text-sm"></p>
        <p id="lf-vehicle-sub" class="text-gray-400 text-xs font-mono"></p>
      </div>
    </div>

    <!-- Divider -->
    <div class="flex items-center gap-3 mb-6">
      <div class="flex-1 h-px bg-white/20"></div>
      <span class="text-gray-400 text-xs font-semibold uppercase tracking-wider">Contact Details</span>
      <div class="flex-1 h-px bg-white/20"></div>
    </div>

    <!-- Form -->
    <form id="leadForm" class="space-y-4" novalidate>

      <!-- Full Name -->
      <div>
        <label class="block text-gray-300 text-xs font-semibold uppercase tracking-wider mb-1.5">Full Name</label>
        <div class="relative">
          <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </span>
          <input
            id="lf-name"
            type="text"
            placeholder="Jane Smith"
            autocomplete="name"
            class="lf-input w-full pl-10 pr-4 py-3 rounded-xl bg-white/10 backdrop-blur border-2 border-white/30 text-white placeholder-gray-400 focus:outline-none focus:border-blue-400 focus:ring-2 focus:ring-blue-400 transition duration-200 text-sm font-medium"
          />
        </div>
        <p class="lf-error hidden mt-1 text-red-400 text-xs" id="err-name"></p>
      </div>

      <!-- Email -->
      <div>
        <label class="block text-gray-300 text-xs font-semibold uppercase tracking-wider mb-1.5">Email Address</label>
        <div class="relative">
          <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </span>
          <input
            id="lf-email"
            type="email"
            placeholder="jane@example.com"
            autocomplete="email"
            class="lf-input w-full pl-10 pr-4 py-3 rounded-xl bg-white/10 backdrop-blur border-2 border-white/30 text-white placeholder-gray-400 focus:outline-none focus:border-blue-400 focus:ring-2 focus:ring-blue-400 transition duration-200 text-sm font-medium"
          />
        </div>
        <p class="lf-error hidden mt-1 text-red-400 text-xs" id="err-email"></p>
      </div>

      <!-- Phone -->
      <div>
        <label class="block text-gray-300 text-xs font-semibold uppercase tracking-wider mb-1.5">
        Phone Number</label>
        <div class="relative">
          <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
          </span>
          <input
            id="lf-phone"
            type="tel"
            placeholder="+44 7700 900000"
            autocomplete="tel"
            class="lf-input w-full pl-10 pr-4 py-3 rounded-xl bg-white/10 backdrop-blur border-2 border-white/30 text-white placeholder-gray-400 focus:outline-none focus:border-blue-400 focus:ring-2 focus:ring-blue-400 transition duration-200 text-sm font-medium"
          />
        </div>
        <p class="lf-error hidden mt-1 text-red-400 text-xs" id="err-phone"></p>
      </div>

      <!-- Privacy note -->
      <p class="text-gray-500 text-xs text-center pt-1">
        Your details are used solely to respond to this enquiry and won't be shared with third parties.
      </p>

      <!-- Submit -->
      <button
        type="submit"
        id="lf-submit"
        class="w-full py-4 rounded-xl bg-gradient-to-r from-blue-600 to-cyan-500 hover:from-blue-500 hover:to-cyan-400 text-white font-bold text-base tracking-wide shadow-lg transition-all duration-300 flex items-center justify-center gap-2"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
        </svg>
        <span id="lf-submit-label">Submit Enquiry</span>
      </button>

    </form>

    <!-- Confirmation (hidden until submit) -->
    <div id="lf-confirmation" class="hidden text-center space-y-5">

      <div class="flex flex-col items-center gap-3 py-6">
        <div class="relative">
          <div class="w-20 h-20 rounded-full bg-gradient-to-br from-emerald-500 to-teal-400 flex items-center justify-center shadow-xl">
            <svg class="w-9 h-9 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 3l14 9-14 9V3z" />
            </svg>
          </div>
        </div>
        <div>
          <h2 class="text-3xl font-bold text-white">Enquiry Sent!</h2>
          <p class="text-gray-300 text-sm mt-1">We'll be in touch with your offer shortly</p>
        </div>
      </div>

      <!-- Summary card -->
      <div class="rounded-xl bg-white/10 backdrop-blur border border-white/20 overflow-hidden text-left">
        <div class="px-5 py-3 bg-black/20 border-b border-white/10">
          <p class="text-gray-400 text-xs font-semibold uppercase tracking-wider">Enquiry Summary</p>
        </div>
        <div class="p-5 space-y-3">
          <div id="conf-vehicle-pill" class="flex items-center gap-3 px-4 py-3 rounded-xl bg-white/10 border border-white/20">
            <div class="w-8 h-8 rounded-lg bg-emerald-500/30 border border-emerald-500/40 flex items-center justify-center flex-shrink-0">
              <svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
            </div>
            <div>
              <p id="conf-vehicle-name" class="text-white font-semibold text-sm"></p>
              <p id="conf-vehicle-sub" class="text-gray-400 text-xs font-mono"></p>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-3 pt-1">
            <div>
              <p class="text-gray-400 text-xs font-semibold uppercase tracking-wide mb-1">Name</p>
              <p id="conf-name" class="text-white text-sm font-medium"></p>
            </div>
            <div>
              <p class="text-gray-400 text-xs font-semibold uppercase tracking-wide mb-1">Enquiry</p>
              <p class="text-white text-sm font-medium">Selling</p>
            </div>
            <div class="col-span-2">
              <p class="text-gray-400 text-xs font-semibold uppercase tracking-wide mb-1">Email</p>
              <p id="conf-email" class="text-white text-sm font-medium break-all"></p>
            </div>
            <div id="conf-phone-row" class="hidden col-span-2">
              <p class="text-gray-400 text-xs font-semibold uppercase tracking-wide mb-1">Phone</p>
              <p id="conf-phone" class="text-white text-sm font-medium"></p>
            </div>
          </div>
        </div>
      </div>

      <!-- Reference number -->
      <div class="px-4 py-3 rounded-xl bg-white/10 backdrop-blur border border-white/20 flex items-center justify-between">
        <span class="text-gray-400 text-xs font-semibold uppercase tracking-wider">Reference</span>
        <span id="conf-ref" class="font-mono text-sm font-bold text-cyan-300 tracking-widest"></span>
      </div>

      <button
        id="lf-restart"
        class="w-full py-3 rounded-xl bg-white/10 hover:bg-white/20 text-white font-semibold transition duration-200"
      >
        Start a New Search
      </button>

    </div>

  </div>
</section>

<script>
(function () {

  // ── State passed from the reg lookup section ──────────────────────────────
  // The continueBtn in the reg section calls scrollIntoView; we also store
  // the looked-up vehicle so we can display it in the pill here.
  let currentVehicle = null; // { year, make, model, color, reg }

  function formatVehicleTitle(data) {
    if (!data) return 'Vehicle details unavailable';
    const parts = [data.year, data.make, data.model].filter(Boolean);
    return parts.length ? parts.join(' ') : data.reg || 'Vehicle details unavailable';
  }

  function formatVehicleSubtitle(data) {
    if (!data) return '';
    return [data.reg, data.color].filter(Boolean).join(' · ');
  }

  // Expose a setter so the reg lookup script can hand off vehicle data.
  window.setLeadVehicle = function (data) {
    currentVehicle = data;
    populatePill(
      document.getElementById('lf-vehicle-name'),
      document.getElementById('lf-vehicle-sub'),
      data
    );
    document.getElementById('lf-vehicle-pill').classList.remove('hidden');
  };

  function populatePill(nameEl, subEl, data) {
    if (!data || !nameEl || !subEl) return;
    nameEl.textContent = formatVehicleTitle(data);
    subEl.textContent  = formatVehicleSubtitle(data);
  }

  // ── Validation ────────────────────────────────────────────────────────────
  function showError(id, msg) {
    const el = document.getElementById(id);
    el.textContent = msg;
    el.classList.remove('hidden');
    // Highlight corresponding input border
    const input = document.getElementById(id.replace('err-', 'lf-'));
    if (input) input.classList.add('border-red-500');
  }

  function clearErrors() {
    document.querySelectorAll('.lf-error').forEach(el => el.classList.add('hidden'));
    document.querySelectorAll('.lf-input').forEach(el => el.classList.remove('border-red-500'));
  }

  function validate(name, email, phone) {
    let valid = true;
    if (!name.trim()) { showError('err-name', 'Name is required'); valid = false; }
    if (!email.trim()) { showError('err-email', 'Email is required'); valid = false; }
    else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { showError('err-email', 'Enter a valid email address'); valid = false; }
    if (phone.trim() && !/^[\d\s+\-()\u00B7]{7,}$/.test(phone)) { showError('err-phone', 'Enter a valid phone number'); valid = false; }
    return valid;
  }

  // ── Submit ────────────────────────────────────────────────────────────────
  const leadForm     = document.getElementById('leadForm');
  const confirmation = document.getElementById('lf-confirmation');
  const submitBtn    = document.getElementById('lf-submit');
  const submitLabel  = document.getElementById('lf-submit-label');

  leadForm.addEventListener('submit', async function (e) {
    e.preventDefault();
    clearErrors();

    const name  = document.getElementById('lf-name').value;
    const email = document.getElementById('lf-email').value;
    const phone = document.getElementById('lf-phone').value;

    if (!validate(name, email, phone)) return;

    // Loading state
    submitBtn.disabled = true;
    submitLabel.textContent = 'Submitting…';

    try {
      const res = await fetch('/api/enquiry', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name,
          email,
          phone,
          reg: currentVehicle ? currentVehicle.reg : '',
        }),
      });
      const data = await res.json();
      if (!data.success) throw new Error(data.message || 'Submission failed');
    } catch (err) {
      submitBtn.disabled = false;
      submitLabel.textContent = 'Submit Enquiry';
      showError('err-phone', err.message || 'Something went wrong. Please try again.');
      return;
    }

    // Populate confirmation
    const ref = 'ENQ-' + Math.random().toString(36).slice(2, 8).toUpperCase();
    document.getElementById('conf-name').textContent  = name;
    document.getElementById('conf-email').textContent = email;
    document.getElementById('conf-ref').textContent   = ref;

    document.getElementById('conf-phone').textContent = phone;
    document.getElementById('conf-phone-row').classList.remove('hidden');

    populatePill(
      document.getElementById('conf-vehicle-name'),
      document.getElementById('conf-vehicle-sub'),
      currentVehicle
    );

    leadForm.classList.add('hidden');
    document.getElementById('lf-vehicle-pill').classList.add('hidden');
    document.querySelector('#lead-form .flex.items-center.gap-3.mb-6').classList.add('hidden'); // divider
    document.querySelector('#lead-form .mb-8').classList.add('hidden'); // header
    confirmation.classList.remove('hidden');
  });

  // ── Restart ───────────────────────────────────────────────────────────────
  document.getElementById('lf-restart').addEventListener('click', function () {
    // Scroll back to top / reg lookup
    window.scrollTo({ top: 0, behavior: 'smooth' });
    // Reset form fields
    leadForm.reset();
    clearErrors();
    currentVehicle = null;
    submitBtn.disabled = false;
    submitLabel.textContent = 'Submit Enquiry';
    // Re-show form, hide confirmation
    leadForm.classList.remove('hidden');
    confirmation.classList.add('hidden');
    document.getElementById('lf-vehicle-pill').classList.add('hidden');
    document.querySelector('#lead-form .flex.items-center.gap-3.mb-6').classList.remove('hidden');
    document.querySelector('#lead-form .mb-8').classList.remove('hidden');
  });

})();
</script>
