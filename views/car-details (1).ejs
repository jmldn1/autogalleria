<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= car.make %> <%= car.model %> | Auto Galleria</title>

  <meta name="description" content="Buy this <%= car.year %> <%= car.make %> <%= car.model %>. Explore detailed images, videos, and specs at Auto Galleria.">

  <!-- Tailwind -->
  <link rel="preload" href="/css/tailwind.css" as="style">
  <link href="/css/tailwind.css" rel="stylesheet">

  <!-- LightGallery (async to avoid render blocking) -->
  <link rel="preload" href="https://cdn.jsdelivr.net/npm/lightgallery@2.7.2/css/lightgallery-bundle.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lightgallery@2.7.2/css/lightgallery-bundle.min.css">
  </noscript>

  <script src="https://cdn.jsdelivr.net/npm/lightgallery@2.7.2/lightgallery.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/lightgallery@2.7.2/plugins/zoom/lg-zoom.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/lightgallery@2.7.2/plugins/thumbnail/lg-thumbnail.min.js" defer></script>

  <style>
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

    /* Sticky sidebar */
    .sticky-sidebar {
      position: sticky;
      top: 80px; /* clears the fixed navbar */
      align-self: flex-start;
    }

    /* Thumbnail active state */
    .thumb-btn.active {
      border-color: #2563eb;
    }

    /* Spec row divider */
    .spec-row + .spec-row {
      border-top: 1px solid #f1f5f9;
    }

    /* Image counter pill */
    .img-counter {
      position: absolute;
      bottom: 12px;
      right: 12px;
      background: rgba(0,0,0,0.55);
      color: #fff;
      font-size: 12px;
      padding: 3px 10px;
      border-radius: 99px;
      pointer-events: none;
      letter-spacing: 0.03em;
    }
  </style>

</head>

<body class="bg-gray-50 text-gray-900 pt-14">

  <%- include('partials/navbar') %>

  <main class="max-w-7xl mx-auto px-4 py-6">

    <!-- Breadcrumb -->
    <nav class="text-sm text-gray-400 mb-4" aria-label="Breadcrumb">
      <a href="/cars" class="hover:text-blue-600 transition">Cars</a>
      <span class="mx-2">/</span>
      <span class="text-gray-700"><%= car.year %> <%= car.make %> <%= car.model %></span>
    </nav>

    <!-- Page title -->
    <h1 class="text-3xl font-bold mb-6">
      <%= car.year %> <%= car.make %> <%= car.model %>
    </h1>

    <!-- Main layout: wide gallery + sticky sidebar -->
    <div class="flex flex-col lg:flex-row gap-8">

      <!-- LEFT: Gallery (65%) -->
      <div class="w-full lg:w-[65%]">

        <!-- Main carousel -->
        <div id="lightgallery" class="relative">

          <% if (car.galleryImages && car.galleryImages.length) { %>

            <div
              id="gallery-scroll"
              class="flex overflow-x-auto snap-x snap-mandatory scroll-smooth no-scrollbar rounded-2xl shadow-md gallery-scroll"
            >

              <% car.galleryImages.forEach((img, index) => { %>

                <div
                  class="min-w-full snap-center"
                  role="group"
                  aria-label="Image <%= index + 1 %> of <%= car.galleryImages.length %>"
                >

                  <a
                    href="<%= img.lightboxSrc || img.fallback %>"
                    data-src="<%= img.lightboxSrc || img.fallback %>"
                    data-lg-size="1200-900"
                    data-sub-html="<h4><%= car.make %> <%= car.model %></h4><p><%= img.alt || 'Gallery image' %></p>"
                    class="gallery-item block group"
                  >

                    <picture>

                      <source
                        type="image/avif"
                        srcset="<%= img.manifest.sources.avif.map(s => `${s.url} ${s.w}w`).join(', ') %>"
                        sizes="(max-width: 640px) 100vw, 65vw"
                      >

                      <source
                        type="image/webp"
                        srcset="<%= img.manifest.sources.webp.map(s => `${s.url} ${s.w}w`).join(', ') %>"
                        sizes="(max-width: 640px) 100vw, 65vw"
                      >

                      <img
                        src="<%= img.fallback %>"
                        srcset="<%= img.manifest.sources.jpg.map(s => `${s.url} ${s.w}w`).join(', ') %>"
                        sizes="(max-width: 640px) 100vw, 65vw"
                        alt="<%= img.alt || `${car.make} ${car.model}` %>"
                        class="w-full aspect-[4/3] object-cover transition-transform duration-500 group-hover:scale-105"
                        loading="<%= index === 0 ? 'eager' : 'lazy' %>"
                        fetchpriority="<%= index === 0 ? 'high' : 'auto' %>"
                        style="background:url('<%= img.placeholder %>') center / cover no-repeat;"
                      >

                    </picture>

                  </a>

                </div>

              <% }) %>

            </div>

            <!-- Image counter -->
            <div class="img-counter" id="img-counter" aria-live="polite">
              1 / <%= car.galleryImages.length %>
            </div>

          <% } else { %>

            <p class="text-gray-500 p-4">No images available for this car.</p>

          <% } %>

        </div>

        <!-- Thumbnails -->
        <% if (car.galleryImages && car.galleryImages.length) { %>

          <div class="flex gap-2 mt-4 overflow-x-auto no-scrollbar pb-1">

            <% car.galleryImages.forEach((img, index) => { %>

              <button
                onclick="scrollToImage(<%= index %>)"
                class="thumb-btn flex-shrink-0 w-20 h-20 rounded-lg overflow-hidden border-2 border-transparent hover:border-blue-400 transition <%= index === 0 ? 'active' : '' %>"
                aria-label="View image <%= index + 1 %>"
              >

                <picture>

                  <source
                    type="image/avif"
                    srcset="<%= img.manifest.sources.avif.map(s => `${s.url} ${s.w}w`).join(', ') %>"
                  >

                  <source
                    type="image/webp"
                    srcset="<%= img.manifest.sources.webp.map(s => `${s.url} ${s.w}w`).join(', ') %>"
                  >

                  <img
                    src="<%= img.fallback %>"
                    alt="Thumbnail <%= index + 1 %>"
                    class="w-full h-full object-cover"
                    loading="lazy"
                  >

                </picture>

              </button>

            <% }) %>

          </div>

        <% } %>

        <!-- Video (below gallery on all screens) -->
        <% if (car.youtubeUrl) { %>

          <div class="mt-8">
            <h2 class="text-xl font-semibold mb-3">Video</h2>
            <div class="relative w-full aspect-video rounded-xl overflow-hidden shadow-md">
              <iframe
                class="absolute inset-0 w-full h-full"
                src="<%= car.youtubeUrl.replace('watch?v=', 'embed/') %>"
                title="Car video"
                frameborder="0"
                allowfullscreen
                loading="lazy"
              ></iframe>
            </div>
          </div>

        <% } %>

      </div>

      <!-- RIGHT: Sticky sidebar (35%) -->
      <div class="w-full lg:w-[35%]">
        <div class="sticky-sidebar bg-white rounded-2xl shadow-md border border-gray-100 overflow-hidden">

          <!-- Price header -->
          <div class="px-6 py-5 border-b border-gray-100">
            <p class="text-sm text-gray-400 uppercase tracking-wide mb-1">Asking price</p>
            <p class="text-3xl font-bold text-gray-900">£<%= car.price.toLocaleString('en-GB', { minimumFractionDigits: 0, maximumFractionDigits: 0 }) %></p>
          </div>

          <!-- Specs -->
          <div class="px-6 py-4">

            <div class="spec-row flex justify-between py-3 text-sm">
              <span class="text-gray-500">Make</span>
              <span class="font-medium text-gray-900"><%= car.make %></span>
            </div>

            <div class="spec-row flex justify-between py-3 text-sm">
              <span class="text-gray-500">Model</span>
              <span class="font-medium text-gray-900"><%= car.model %></span>
            </div>

            <div class="spec-row flex justify-between py-3 text-sm">
              <span class="text-gray-500">Year</span>
              <span class="font-medium text-gray-900"><%= car.year %></span>
            </div>

            <div class="spec-row flex justify-between py-3 text-sm">
              <span class="text-gray-500">Mileage</span>
              <span class="font-medium text-gray-900"><%= car.mileage.toLocaleString() %> miles</span>
            </div>

            <div class="spec-row flex justify-between py-3 text-sm">
              <span class="text-gray-500">Condition</span>
              <span class="font-medium text-gray-900"><%= car.condition %></span>
            </div>

            <div class="spec-row flex justify-between py-3 text-sm">
              <span class="text-gray-500">VIN</span>
              <span class="font-medium text-gray-900 font-mono text-xs"><%= car.vin %></span>
            </div>

          </div>

          <!-- Description -->
          <% if (car.description) { %>
            <div class="px-6 pb-4 text-sm text-gray-600 leading-relaxed border-t border-gray-100 pt-4">
              <%= car.description %>
            </div>
          <% } %>

          <!-- CTA -->
          <div class="px-6 pb-6">
            <a
              href="mailto:info@autogalleria.com?subject=Enquiry: <%= car.year %> <%= car.make %> <%= car.model %>"
              class="block w-full bg-blue-600 hover:bg-blue-700 active:scale-[0.98] text-white text-center font-semibold py-3 rounded-xl shadow transition"
            >
              Enquire Now
            </a>
          </div>

        </div>
      </div>

    </div>

  </main>

  <script>

    const galleryScroll = document.getElementById('gallery-scroll');
    const counter = document.getElementById('img-counter');
    const thumbBtns = document.querySelectorAll('.thumb-btn');
    const totalImages = <%= car.galleryImages ? car.galleryImages.length : 0 %>;

    function scrollToImage(index) {
      const width = galleryScroll.clientWidth;
      galleryScroll.scrollTo({ left: width * index, behavior: 'smooth' });
    }

    // Update counter + active thumbnail on scroll
    if (galleryScroll) {
      galleryScroll.addEventListener('scroll', () => {
        const index = Math.round(galleryScroll.scrollLeft / galleryScroll.clientWidth);
        if (counter) counter.textContent = `${index + 1} / ${totalImages}`;
        thumbBtns.forEach((btn, i) => btn.classList.toggle('active', i === index));
      }, { passive: true });
    }

    document.addEventListener('DOMContentLoaded', () => {
      lightGallery(document.getElementById('lightgallery'), {
        plugins: [lgZoom, lgThumbnail],
        selector: 'a',
        download: false,
      });
    });

  </script>

</body>
</html>
