<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/seo-head', {
      title: (title || 'Cars') + ' | Auto Galleria',
      description: 'Browse our current stock of premium used cars. Every listing includes detailed information and high-quality responsive images.'
    }) %>
    <link href="/css/tailwind.css" rel="stylesheet" />
  </head>
  <body class="bg-slate-50 text-slate-900">
    <%- include('partials/navbar') %>

    <main class="flex min-h-screen flex-col">
      <%- include('partials/page-hero', {
        eyebrow: 'Inventory',
        title: 'Current stock',
        description: 'Browse our hand-picked vehicles, ready for viewing.'
      }) %>

      <div class="mx-auto flex w-full max-w-7xl flex-col px-4 py-16 sm:px-6 lg:px-8">
      <% if (!cars.length) { %>
        <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center shadow-sm">
          <h2 class="text-xl font-semibold">No cars available right now</h2>
          <p class="mt-2 text-slate-600">Please check back soon for fresh stock.</p>
        </div>
      <% } else { %>
        <section class="grid gap-8 md:grid-cols-2 xl:grid-cols-3">
          <% cars.forEach(car => { %>
            <%- include('partials/vehicle-card', { vehicle: car }) %>
          <% }) %>
        </section>
      <% } %>
      </div>
    </main>

    <%- include('partials/footer') %>
  </body>
</html>
