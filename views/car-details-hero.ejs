<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/seo-head', {
    title: car.make + ' ' + car.model + ' | Auto Galleria',
    description: 'Buy this ' + car.year + ' ' + car.make + ' ' + car.model + '. Explore detailed images, videos, and specs at Auto Galleria.'
  }) %>
  <!-- Tailwind -->
  <link href="/css/tailwind.css" rel="stylesheet">
  <!-- Preload the LCP (first gallery) image so it's discoverable immediately -->
  <% if (car.galleryImages && car.galleryImages.length) { %>
    <% const lcpImg = car.galleryImages[0]; %>
    <% if (lcpImg.manifest.heroMobileSources?.avif?.length) { %>
      <link
        rel="preload"
        as="image"
        href="<%= lcpImg.manifest.heroMobileSources.jpg[lcpImg.manifest.heroMobileSources.jpg.length - 1].url %>"
        imagesrcset="<%= lcpImg.manifest.heroMobileSources.avif.map(s => `${s.url} ${s.w}w`).join(', ') %>"
        imagesizes="100vw"
        media="(max-width: 639.98px)"
        type="image/avif"
      >
    <% } %>
    <link
      rel="preload"
      as="image"
      href="<%= lcpImg.manifest.heroSources.jpg[lcpImg.manifest.heroSources.jpg.length - 1].url %>"
      imagesrcset="<%= lcpImg.manifest.heroSources.avif.map(s => `${s.url} ${s.w}w`).join(', ') %>"
      imagesizes="100vw"
      media="(min-width: 640px)"
      type="image/avif"
    >
  <% } %>
  <!-- Swiper (self-hosted, core + Navigation/FreeMode/Thumbs only) -->
  <link rel="stylesheet" href="/vendor/swiper/swiper.min.css?v=<%= vendorVersion %>"/>
  <link rel="stylesheet" href="/vendor/swiper/navigation.min.css?v=<%= vendorVersion %>"/>
  <link rel="stylesheet" href="/vendor/swiper/free-mode.min.css?v=<%= vendorVersion %>"/>
  <!-- LightGallery (self-hosted) -->
  <!-- Only needed once the lightbox opens, so load without blocking initial render -->
  <link rel="stylesheet" href="/vendor/lightgallery/css/lightgallery.min.css?v=<%= vendorVersion %>" media="print" onload="this.media='all'">
  <link rel="stylesheet" href="/vendor/lightgallery/css/lg-zoom.min.css?v=<%= vendorVersion %>" media="print" onload="this.media='all'">
  <link rel="stylesheet" href="/vendor/lightgallery/css/lg-thumbnail.min.css?v=<%= vendorVersion %>" media="print" onload="this.media='all'">
  <script src="/vendor/lightgallery/lightgallery.min.js?v=<%= vendorVersion %>" defer></script>
  <script src="/vendor/lightgallery/plugins/zoom/lg-zoom.min.js?v=<%= vendorVersion %>" defer></script>
  <script src="/vendor/lightgallery/plugins/thumbnail/lg-thumbnail.min.js?v=<%= vendorVersion %>" defer></script>
</head>
<body class="bg-slate-50 text-slate-900">
  <%- include('partials/navbar') %>

  <!-- Hero gallery: full-bleed main image with title/price overlaid -->
  <section class="relative isolate w-full">
    <div class="swiper mySwiper2 relative z-0 w-full aspect-4/5 max-h-[85vh] overflow-hidden sm:aspect-video">
      <div class="swiper-wrapper" id="lightgallery">
        <% if (car.galleryImages && car.galleryImages.length) { %>
          <% car.galleryImages.forEach((img, index) => { %>
            <div class="swiper-slide" role="group" aria-label="Image <%= index + 1 %> of <%= car.galleryImages.length %>">
              <a
                href="<%= img.lightboxSrc || img.fallback %>"
                data-src="<%= img.lightboxSrc || img.fallback %>"
                data-lg-size="<%= img.lightboxSize || '1200-900' %>"
                data-sub-html="<h4><%= car.make %> <%= car.model %></h4><p><%= img.alt || 'Gallery image' %></p>"
                class="gallery-item block h-full w-full"
              >
                <picture>
                  <% if (img.manifest.heroMobileSources?.avif?.length) { %>
                    <source
                      media="(max-width: 639px)"
                      type="image/avif"
                      srcset="<%= img.manifest.heroMobileSources.avif.map(s => `${s.url} ${s.w}w`).join(', ') %>"
                      sizes="100vw"
                    >
                    <source
                      media="(max-width: 639px)"
                      type="image/webp"
                      srcset="<%= img.manifest.heroMobileSources.webp.map(s => `${s.url} ${s.w}w`).join(', ') %>"
                      sizes="100vw"
                    >
                    <source
                      media="(max-width: 639px)"
                      type="image/jpeg"
                      srcset="<%= img.manifest.heroMobileSources.jpg.map(s => `${s.url} ${s.w}w`).join(', ') %>"
                      sizes="100vw"
                    >
                  <% } %>
                  <source
                    type="image/avif"
                    srcset="<%= img.manifest.heroSources.avif.map(s => `${s.url} ${s.w}w`).join(', ') %>"
                    sizes="100vw"
                  >
                  <source
                    type="image/webp"
                    srcset="<%= img.manifest.heroSources.webp.map(s => `${s.url} ${s.w}w`).join(', ') %>"
                    sizes="100vw"
                  >
                  <img
                    src="<%= img.manifest.heroSources.jpg[img.manifest.heroSources.jpg.length - 1].url %>"
                    srcset="<%= img.manifest.heroSources.jpg.map(s => `${s.url} ${s.w}w`).join(', ') %>"
                    sizes="100vw"
                    alt="<%= img.alt || `${car.make} ${car.model}` %>"
                    class="h-full w-full object-cover"
                    <% if (index === 0) { %>loading="eager" fetchpriority="high"<% } else { %>loading="lazy"<% } %>
                    style="background:url('<%= img.placeholder %>') center / cover no-repeat;"
                  >
                </picture>
              </a>
            </div>
          <% }) %>
        <% } else { %>
          <div class="flex h-full items-center justify-center text-slate-300">No images available for this car.</div>
        <% } %>
      </div>
      <!-- Arrows -->
      <div class="swiper-button-next"></div>
      <div class="swiper-button-prev"></div>
    </div>

    <!-- Overlay: gradient + breadcrumb/title. pointer-events-none so gallery arrows stay clickable underneath. -->
    <div class="pointer-events-none absolute inset-0 z-10 bg-gradient-to-t from-black/80 via-black/10 to-transparent"></div>
    <div class="pointer-events-none absolute inset-x-0 bottom-0 z-10 p-5 sm:p-8">
      <div class="pointer-events-auto mx-auto max-w-7xl">
        <nav aria-label="Breadcrumb" class="mb-2 text-sm text-white/75">
          <ol class="flex flex-wrap items-center gap-2">
            <li><a href="/" class="transition hover:text-white">Home</a></li>
            <li aria-hidden="true">/</li>
            <li><a href="/cars" class="transition hover:text-white">Cars</a></li>
            <li aria-hidden="true">/</li>
            <li class="text-white"><%= car.make %> <%= car.model %></li>
          </ol>
        </nav>
        <h1 class="text-3xl font-bold tracking-tight text-white drop-shadow-lg sm:text-5xl"><%= car.year %> <%= car.make %> <%= car.model %></h1>
      </div>
    </div>
  </section>

  <main class="max-w-7xl mx-auto p-4">
    <div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-12">
      <!-- Left: thumbnails + description + video -->
      <div class="lg:col-span-7">
        <!-- Thumbnails -->
        <% if (car.galleryImages && car.galleryImages.length) { %>
          <div class="swiper mySwiper">
            <div class="swiper-wrapper">
              <% car.galleryImages.forEach(img => { %>
                <div class="swiper-slide cursor-pointer">
                  <picture>
                    <source
                      type="image/avif"
                      srcset="<%= img.manifest.sources.avif.map(s => `${s.url} ${s.w}w`).join(', ') %>"
                      sizes="(min-width: 1024px) 170px, 24vw"
                    >
                    <source
                      type="image/webp"
                      srcset="<%= img.manifest.sources.webp.map(s => `${s.url} ${s.w}w`).join(', ') %>"
                      sizes="(min-width: 1024px) 170px, 24vw"
                    >
                    <img
                      src="<%= img.fallback %>"
                      srcset="<%= img.manifest.sources.jpg.map(s => `${s.url} ${s.w}w`).join(', ') %>"
                      sizes="(min-width: 1024px) 170px, 24vw"
                      alt="Thumbnail <%= car.make %> <%= car.model %>"
                      class="aspect-4/3 w-full object-cover rounded-lg"
                      loading="lazy"
                      style="background:url('<%= img.placeholder %>') center / cover no-repeat;"
                    >
                  </picture>
                </div>
              <% }) %>
            </div>
          </div>
        <% } %>

        <% if (car.description) { %>
          <div class="bg-white rounded-3xl shadow-lg p-6 mt-6">
            <h2 class="text-xl font-semibold text-slate-900">Vehicle Description</h2>
            <p class="mt-3 text-lg leading-relaxed text-slate-700"><%= car.description %></p>
          </div>
        <% } %>

        <!-- Video -->
        <% if (car.video) { %>
          <div class="mt-8">
            <h2 class="text-xl font-semibold mb-4">Car Video</h2>
            <div
              class="relative aspect-video overflow-hidden rounded-xl shadow-lg bg-slate-900"
              data-youtube-player
              data-youtube-embed="<%= car.video.embedUrl %>"
              data-youtube-title="<%= `${car.year} ${car.make} ${car.model} video`.replace(/"/g, '&quot;') %>"
            >
              <button
                type="button"
                class="group absolute inset-0 flex h-full w-full items-center justify-center overflow-hidden"
                data-youtube-trigger
                aria-label="Play vehicle video"
              >
                <img
                  src="<%= car.video.thumbnailUrl %>"
                  alt="<%= `${car.year} ${car.make} ${car.model} video preview` %>"
                  class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.02]"
                  loading="lazy"
                >
                <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/25 to-black/10"></div>
                <div class="absolute inset-x-0 bottom-0 p-5 text-left text-white">
                  <p class="text-sm uppercase tracking-[0.2em] text-white/70">Video</p>
                  <p class="mt-1 text-xl font-semibold"><%= car.year %> <%= car.make %> <%= car.model %> walkaround</p>
                  <p class="mt-1 text-sm text-white/80">Click to load the privacy-enhanced YouTube player.</p>
                </div>
                <span class="absolute left-1/2 top-1/2 z-10 flex -translate-x-1/2 -translate-y-1/2 items-center justify-center transition group-hover:opacity-90" aria-hidden="true">
                  <svg class="h-20 w-20 drop-shadow-2xl" viewBox="0 0 68 48" fill="none">
                    <path d="M66.52 7.74c-0.78-2.93-2.49-5.41-5.42-6.19C55.79 0.13 34 0 34 0S12.21 0.13 6.9 1.55C3.97 2.33 2.27 4.81 1.48 7.74 0.06 13.05 0 24 0 24s0.06 10.95 1.48 16.26c0.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-0.13 27.1-1.55c2.93-0.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24S67.94 13.05 66.52 7.74z" fill="#FF0000"></path>
                    <path d="M45 24 27 14 27 34" fill="#FFFFFF"></path>
                  </svg>
                </span>
              </button>
            </div>
          </div>
        <% } %>
      </div>

      <!-- Right: Car Info -->
      <div class="flex flex-col gap-4 lg:col-span-5 lg:sticky lg:top-24 lg:self-start lg:max-h-[calc(100vh-7rem)] lg:overflow-y-auto lg:pr-1">
        <div class="bg-white rounded-3xl shadow-lg p-6">
          <h2 class="text-xl font-semibold text-slate-900">Specifications</h2>
          <%
            const conditionRaw = (car.condition || '').toString().trim();
            const conditionLower = conditionRaw.toLowerCase();
            const conditionMap = {
              excellent: 1,
              verygood: 2,
              good: 2,
              fair: 3,
              average: 3,
              poor: 5,
            };

            let conditionScore = null;
            const numericCondition = Number(conditionLower);

            if (Number.isInteger(numericCondition) && numericCondition >= 1 && numericCondition <= 5) {
              conditionScore = numericCondition;
            } else {
              const compact = conditionLower.replace(/[^a-z]/g, '');
              conditionScore = conditionMap[compact] || null;
            }

            const scoreColors = ['bg-emerald-500', 'bg-lime-500', 'bg-amber-500', 'bg-orange-500', 'bg-rose-500'];
          %>
          <ul class="mt-4 space-y-3 text-slate-700">
            <li><strong>Make:</strong> <%= car.make %></li>
            <li><strong>Model:</strong> <%= car.model %></li>
            <li><strong>Year:</strong> <%= car.year %></li>
            <li><strong>VIN:</strong> <%= car.vin %></li>
            <li><strong>Price:</strong> £<%= car.price.toFixed(2) %></li>
            <li><strong>Mileage:</strong> <%= car.mileage.toLocaleString() %> miles</li>
            <li class="flex flex-wrap items-center gap-2">
              <strong>Condition:</strong>
              <span><%= car.condition %></span>
              <% if (conditionScore) { %>
                <span
                  class="inline-flex h-6 w-6 items-center justify-center rounded-full border border-transparent text-xs font-semibold text-white <%= scoreColors[conditionScore - 1] %>"
                  aria-label="Condition score <%= conditionScore %> out of 5"
                >
                  <%= conditionScore %>
                </span>
              <% } %>
            </li>
          </ul>
        </div>

        <div class="bg-gray-100 rounded-3xl shadow-lg p-6">
          <div id="enquiry-form-wrap">
            <h2 class="text-xl font-semibold text-slate-900">Interested in this vehicle?</h2>
            <p class="mt-2 text-sm text-slate-600">Send an enquiry about this <%= car.make %> <%= car.model %> and we'll get back to you shortly.</p>

            <form id="enquiry-form" class="mt-5 space-y-3" novalidate>
              <div class="hidden" aria-hidden="true">
                <label for="enq-company">Company website</label>
                <input id="enq-company" name="companyWebsite" type="text" tabindex="-1" autocomplete="off">
              </div>

              <div>
                <label for="enq-name" class="sr-only">Full name</label>
                <input
                  id="enq-name" name="name" type="text" placeholder="Full name" autocomplete="name"
                  class="enq-input w-full rounded-lg bg-white border border-slate-300 px-4 py-2.5 text-sm text-slate-900 placeholder-slate-400 transition focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/30"
                  aria-describedby="enq-err-name"
                >
                <p class="enq-error hidden mt-1 text-xs text-rose-600" id="enq-err-name" role="alert"></p>
              </div>

              <div>
                <label for="enq-email" class="sr-only">Email address</label>
                <input
                  id="enq-email" name="email" type="email" placeholder="Email address" autocomplete="email"
                  class="enq-input w-full rounded-lg bg-white border border-slate-300 px-4 py-2.5 text-sm text-slate-900 placeholder-slate-400 transition focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/30"
                  aria-describedby="enq-err-email"
                >
                <p class="enq-error hidden mt-1 text-xs text-rose-600" id="enq-err-email" role="alert"></p>
              </div>

              <div>
                <label for="enq-phone" class="sr-only">Phone number (optional)</label>
                <input
                  id="enq-phone" name="phone" type="tel" inputmode="tel" placeholder="Phone (optional)" autocomplete="tel"
                  class="enq-input w-full rounded-lg bg-white border border-slate-300 px-4 py-2.5 text-sm text-slate-900 placeholder-slate-400 transition focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/30"
                  aria-describedby="enq-err-phone"
                >
                <p class="enq-error hidden mt-1 text-xs text-rose-600" id="enq-err-phone" role="alert"></p>
              </div>

              <div>
                <label for="enq-message" class="sr-only">Message (optional)</label>
                <textarea
                  id="enq-message" name="message" rows="3" placeholder="Anything you'd like us to know? (optional)"
                  class="enq-input w-full resize-none rounded-lg bg-white border border-slate-300 px-4 py-2.5 text-sm text-slate-900 placeholder-slate-400 transition focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/30"
                ></textarea>
              </div>

              <p id="enq-form-error" class="hidden text-xs text-rose-600" role="alert"></p>

              <div class="flex items-center gap-4 pt-1">
                <button
                  type="submit"
                  id="enq-submit"
                  class="rounded-xl bg-blue-600 px-6 py-2.5 text-sm font-semibold text-white shadow transition hover:bg-blue-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600/50 disabled:cursor-not-allowed disabled:opacity-60"
                >
                  <span id="enq-submit-label">Send Enquiry</span>
                </button>
              </div>
            </form>
          </div>

          <div id="enquiry-confirmation" class="hidden" aria-hidden="true" role="status" aria-live="polite">
            <div class="flex items-center gap-3">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-emerald-100">
                <svg class="h-5 w-5 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <h2 class="text-lg font-semibold text-slate-900">Enquiry sent</h2>
                <p class="mt-0.5 text-sm text-slate-600">We'll be in touch about this vehicle shortly.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <% if (relatedCars && relatedCars.length) { %>
      <section class="mt-14">
        <div class="mb-5 flex flex-col items-start gap-3 sm:flex-row sm:items-end sm:justify-between">
          <h2 class="text-2xl font-bold text-slate-900">Other cars you might like</h2>
          <a
            href="/cars"
            class="inline-flex items-center rounded-full border border-blue-200 bg-blue-50 px-3 py-1.5 text-sm font-semibold text-blue-700 transition hover:border-blue-300 hover:bg-blue-100 hover:text-blue-800"
          >
            View all cars
          </a>
        </div>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3">
          <% relatedCars.forEach((relatedCar) => { %>
            <%- include('partials/vehicle-card', { vehicle: relatedCar }) %>
          <% }) %>
        </div>
      </section>
    <% } %>
  </main>
  <%- include('partials/whatsapp-float', { car }) %>
    <%- include('partials/footer') %>
  <script type="module">
    import Swiper from "/vendor/swiper/swiper.min.mjs?v=<%= vendorVersion %>";
    import Navigation from "/vendor/swiper/modules/navigation.min.mjs?v=<%= vendorVersion %>";
    import Thumbs from "/vendor/swiper/modules/thumbs.min.mjs?v=<%= vendorVersion %>";
    import FreeMode from "/vendor/swiper/modules/free-mode.min.mjs?v=<%= vendorVersion %>";

    document.addEventListener("DOMContentLoaded", () => {
      const swiperThumbs = new Swiper(".mySwiper", {
        modules: [FreeMode],
        spaceBetween: 8,
        slidesPerView: 3.5,
        freeMode: true,
        watchSlidesProgress: true,
        breakpoints: {
          640: {
            slidesPerView: 4,
            spaceBetween: 10,
          },
        },
      });
      const swiperMain = new Swiper(".mySwiper2", {
        modules: [Navigation, Thumbs],
        spaceBetween: 10,
        navigation: {
          nextEl: ".swiper-button-next",
          prevEl: ".swiper-button-prev",
        },
        thumbs: {
          swiper: swiperThumbs,
        },
      });
      lightGallery(document.getElementById("lightgallery"), {
        plugins: [lgZoom, lgThumbnail],
        selector: "a",
        download: false,
      });

      document.querySelectorAll("[data-youtube-player]").forEach((player) => {
        const trigger = player.querySelector("[data-youtube-trigger]");
        if (!trigger) return;

        trigger.addEventListener("click", () => {
          const iframe = document.createElement("iframe");
          iframe.className = "absolute inset-0 h-full w-full";
          iframe.src = player.dataset.youtubeEmbed;
          iframe.title = player.dataset.youtubeTitle || "Car video";
          iframe.loading = "lazy";
          iframe.referrerPolicy = "strict-origin-when-cross-origin";
          iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
          iframe.allowFullscreen = true;

          player.replaceChildren(iframe);
        }, { once: true });
      });

      const formWrap = document.getElementById("enquiry-form-wrap");
      const confirmation = document.getElementById("enquiry-confirmation");
      const form = document.getElementById("enquiry-form");

      if (formWrap && confirmation && form) {
        function showConfirmation() {
          formWrap.classList.add("hidden");
          formWrap.setAttribute("aria-hidden", "true");
          confirmation.classList.remove("hidden");
          confirmation.setAttribute("aria-hidden", "false");
        }

        function showFieldError(id, message) {
          const errorEl = document.getElementById(id);
          if (!errorEl) return;
          errorEl.textContent = message;
          errorEl.classList.remove("hidden");
          const input = document.getElementById(id.replace("enq-err-", "enq-"));
          if (input) input.classList.add("border-rose-300");
        }

        function clearErrors() {
          form.querySelectorAll(".enq-error").forEach((el) => el.classList.add("hidden"));
          form.querySelectorAll(".enq-input").forEach((el) => el.classList.remove("border-rose-300"));
          document.getElementById("enq-form-error")?.classList.add("hidden");
        }

        function validate(name, email, phone) {
          let valid = true;
          if (!name.trim()) { showFieldError("enq-err-name", "Name is required"); valid = false; }
          if (!email.trim()) { showFieldError("enq-err-email", "Email is required"); valid = false; }
          else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { showFieldError("enq-err-email", "Enter a valid email address"); valid = false; }
          if (phone.trim() && !/^[\d\s+\-()·]{7,}$/.test(phone)) { showFieldError("enq-err-phone", "Enter a valid phone number"); valid = false; }
          return valid;
        }

        const submitBtn = document.getElementById("enq-submit");
        const submitLabel = document.getElementById("enq-submit-label");

        form.addEventListener("submit", async (e) => {
          e.preventDefault();
          clearErrors();

          const name = document.getElementById("enq-name").value;
          const email = document.getElementById("enq-email").value;
          const phone = document.getElementById("enq-phone").value;
          const message = document.getElementById("enq-message").value;
          const companyWebsite = document.getElementById("enq-company").value;

          if (!validate(name, email, phone)) return;

          submitBtn.disabled = true;
          submitLabel.textContent = "Sending…";

          try {
            const res = await fetch("/car/<%= car.slug %>/enquire", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ name, email, phone, message, companyWebsite }),
            });
            const data = await res.json();
            if (!data.success) throw new Error(data.message || "Something went wrong. Please try again.");

            showConfirmation();
            form.reset();
          } catch (err) {
            const formError = document.getElementById("enq-form-error");
            formError.textContent = err.message || "Something went wrong. Please try again.";
            formError.classList.remove("hidden");
          } finally {
            submitBtn.disabled = false;
            submitLabel.textContent = "Send Enquiry";
          }
        });
      }
    });
  </script>
</body>
</html>
