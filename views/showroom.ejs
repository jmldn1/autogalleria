<!DOCTYPE html>
<html lang="en">
  <%
    const heroEyebrow = showroom.eyebrow || 'Auto Galleria Showroom';
    const heroHeading = showroom.heading || 'Quality used cars, ready to drive home.';
    const heroDescription = showroom.description || "Every vehicle is hand-picked, fully inspected and photographed in detail so you know exactly what you're buying - before you even step in the showroom.";
    const primaryCtaLabel = showroom.primaryCtaLabel || 'Browse all stock';
    const primaryCtaUrl = showroom.primaryCtaUrl || '/cars';
    const secondaryCtaLabel = showroom.secondaryCtaLabel || 'Get a free valuation';
    const secondaryCtaUrl = showroom.secondaryCtaUrl || '/sell-your-car';
  %>
  <head>
    <%- include('partials/seo-head', {
      title: title || 'Find Your Next Car | Auto Galleria',
      description: description || 'Browse hand-picked used cars with transparent pricing, detailed photos and nationwide delivery.',
      ogImage: heroImage?.sources?.jpg?.[heroImage.sources.jpg.length - 1]?.url || null,
      ogImageAlt: heroImage?.alt || null
    }) %>
    <link href="/css/tailwind.css" rel="stylesheet" />
  </head>
  <body class="bg-slate-50 text-slate-900">
    <%- include('partials/navbar') %>

    <main>
      <!-- HERO -->
      <section class="relative isolate overflow-hidden bg-slate-900 text-white">
        <div class="relative flex min-h-160 items-end pt-24 sm:min-h-180">
          <% if (heroImage) { %>
            <%- include('partials/hero', { heroImage: heroImage }) %>
          <% } else { %>
            <div class="absolute inset-0 z-0 bg-[radial-gradient(circle_at_top,rgba(37,99,235,0.35),transparent_55%)]"></div>
          <% } %>
          <div class="absolute inset-0 z-10 bg-linear-to-t from-slate-950/75 via-slate-950/40 to-transparent"></div>

          <div class="relative z-20 mx-auto w-full max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
            <p class="section-eyebrow text-blue-300"><%= heroEyebrow %></p>
            <h1 class="max-w-2xl text-4xl font-bold leading-tight sm:text-5xl lg:text-6xl">
              <%= heroHeading %>
            </h1>
            <p class="mt-6 max-w-xl text-lg text-slate-200">
              <%= heroDescription %>
            </p>

            <div class="mt-8 flex flex-wrap gap-4">
              <a href="<%= primaryCtaUrl %>" class="btn-primary"><%= primaryCtaLabel %></a>
              <a href="<%= secondaryCtaUrl %>" class="btn-secondary"><%= secondaryCtaLabel %></a>
            </div>
          </div>
        </div>
      </section>

      <!-- AVAILABLE CARS -->
      <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <h2 class="text-3xl font-bold text-slate-900">Available cars</h2>
          </div>
          <a href="/cars" class="font-semibold text-blue-700 hover:text-blue-800">View all stock &rarr;</a>
        </div>

        <% if (!cars.length) { %>
          <div class="mt-10 rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center shadow-sm">
            <h3 class="text-xl font-semibold">No cars available right now</h3>
            <p class="mt-2 text-slate-600">Please check back soon for fresh stock.</p>
          </div>
        <% } else { %>
          <div class="mt-10 grid gap-8 sm:grid-cols-2 xl:grid-cols-3">
            <% cars.slice(1).forEach(car => { %>
              <%- include('partials/vehicle-card', { vehicle: car, compact: true }) %>
            <% }) %>
          </div>
        <% } %>
      </section>

      <!-- FEATURED VEHICLE -->
      <% if (cars.length) { %>
        <%
          const spotlight = cars[0];
          const spotlightName = [spotlight.year, spotlight.make, spotlight.model].filter(Boolean).join(' ');
          const spotlightHref = `/car/${spotlight.slug || spotlight._id || ''}`;
          const spotlightBlurb = spotlight.description
            ? (spotlight.description.length > 160 ? spotlight.description.slice(0, 157).trim() + '…' : spotlight.description)
            : 'Hand-picked, fully inspected and ready to view at our showroom or delivered to your door.';
        %>
        <section class="bg-slate-900 py-16 text-white sm:py-20">
          <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-2 lg:items-center lg:gap-16 lg:px-8">
            <a href="<%= spotlightHref %>" class="group block overflow-hidden rounded-2xl">
              <% if (spotlight.image?.sources?.jpg?.length) { %>
                <picture>
                  <% if (spotlight.image.sources.avif?.length) { %>
                    <source type="image/avif" srcset="<%= spotlight.image.sources.avif.map(s => `${s.url} ${s.w}w`).join(', ') %>" sizes="(max-width: 1024px) 100vw, 50vw" />
                  <% } %>
                  <% if (spotlight.image.sources.webp?.length) { %>
                    <source type="image/webp" srcset="<%= spotlight.image.sources.webp.map(s => `${s.url} ${s.w}w`).join(', ') %>" sizes="(max-width: 1024px) 100vw, 50vw" />
                  <% } %>
                  <img
                    src="<%= spotlight.image.fallback %>"
                    srcset="<%= spotlight.image.sources.jpg.map(s => `${s.url} ${s.w}w`).join(', ') %>"
                    sizes="(max-width: 1024px) 100vw, 50vw"
                    alt="<%= spotlight.image.alt || spotlightName %>"
                    class="aspect-4/3 w-full object-cover transition duration-500 group-hover:scale-105"
                    loading="lazy"
                  />
                </picture>
              <% } %>
            </a>
            <div>
              <p class="section-eyebrow text-blue-300">Featured this week</p>
              <h2 class="text-3xl font-bold sm:text-4xl"><%= spotlightName %></h2>
              <p class="mt-4 max-w-lg text-slate-300"><%= spotlightBlurb %></p>

              <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm text-slate-300">
                <% if (spotlight.mileage) { %><span><%= Number(spotlight.mileage).toLocaleString() %> miles</span><% } %>
                <% if (spotlight.condition) { %><span><%= spotlight.condition %></span><% } %>
                <% if (Number.isFinite(Number(spotlight.price))) { %><span class="font-semibold text-white">£<%= Number(spotlight.price).toLocaleString() %></span><% } %>
              </div>

              <a href="<%= spotlightHref %>" class="btn-primary mt-8 inline-flex">View this car</a>
            </div>
          </div>
        </section>
      <% } %>

      <!-- WHY CHOOSE US -->
      <section class="bg-white py-16">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <p class="section-eyebrow">Why buy from us</p>
          <h2 class="text-3xl font-bold text-slate-900">A better way to buy your next car</h2>

          <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            <div class="card p-6">
              <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-6 w-6"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
              </div>
              <h3 class="mt-4 font-semibold text-slate-900">Every car inspected</h3>
              <p class="mt-2 text-sm text-slate-600">Full HPI check and multi-point inspection on every vehicle we list.</p>
            </div>
            <div class="card p-6">
              <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-6 w-6"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.75V12A2.25 2.25 0 0 1 4.5 9.75h15A2.25 2.25 0 0 1 21.75 12v.75m-19.5 0v4.5A2.25 2.25 0 0 0 4.5 19.5h15a2.25 2.25 0 0 0 2.25-2.25v-4.5m-19.5 0h19.5M6.75 9.75V6.75A2.25 2.25 0 0 1 9 4.5h6a2.25 2.25 0 0 1 2.25 2.25v3" /></svg>
              </div>
              <h3 class="mt-4 font-semibold text-slate-900">Transparent pricing</h3>
              <p class="mt-2 text-sm text-slate-600">No hidden fees &mdash; the price you see is the price you pay.</p>
            </div>
            <div class="card p-6">
              <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-6 w-6"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.87H14.25M16.5 18.75h-2.25m0-11.177v11.177m0-11.177c0-.621-.504-1.125-1.125-1.125h-2.25c-.621 0-1.125.504-1.125 1.125m4.5 0v11.177m0-11.177L18 9m0 0h3.75M18 9V6.75" /></svg>
              </div>
              <h3 class="mt-4 font-semibold text-slate-900">Nationwide delivery</h3>
              <p class="mt-2 text-sm text-slate-600">We deliver to your door, or collect in person at our showroom.</p>
            </div>
            <div class="card p-6">
              <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-6 w-6"><path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-3.99 8.25-8.906 8.25a9.735 9.735 0 0 1-3.211-.533l-3.55.987a.75.75 0 0 1-.92-.92l.987-3.55A9.735 9.735 0 0 1 3 12c0-4.556 3.99-8.25 8.906-8.25S21 7.444 21 12Z" /></svg>
              </div>
              <h3 class="mt-4 font-semibold text-slate-900">Real support</h3>
              <p class="mt-2 text-sm text-slate-600">Chat with the team on WhatsApp or by phone throughout the process.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- HOW IT WORKS -->
      <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
        <p class="section-eyebrow">How it works</p>
        <h2 class="text-3xl font-bold text-slate-900">Buying with us is simple</h2>

        <div class="mt-10 grid gap-8 md:grid-cols-3">
          <div>
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-blue-600 font-semibold text-white">1</span>
            <h3 class="mt-4 font-semibold text-slate-900">Browse the stock</h3>
            <p class="mt-2 text-sm text-slate-600">Filter by make, model and budget to find a car that fits.</p>
          </div>
          <div>
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-blue-600 font-semibold text-white">2</span>
            <h3 class="mt-4 font-semibold text-slate-900">Reserve online</h3>
            <p class="mt-2 text-sm text-slate-600">Message us on WhatsApp or send an enquiry to hold your car.</p>
          </div>
          <div>
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-blue-600 font-semibold text-white">3</span>
            <h3 class="mt-4 font-semibold text-slate-900">Collect or delivered</h3>
            <p class="mt-2 text-sm text-slate-600">Pick it up from our showroom or have it delivered to your door.</p>
          </div>
        </div>
      </section>

      <!-- SELL YOUR CAR CTA -->
      <section class="bg-slate-900 py-16 text-white">
        <div class="mx-auto flex max-w-7xl flex-col items-start gap-6 px-4 sm:px-6 lg:flex-row lg:items-center lg:justify-between lg:px-8">
          <div>
            <p class="section-eyebrow text-blue-300">Sell to us</p>
            <h2 class="text-3xl font-bold">Got a car to sell? Get a free valuation today.</h2>
            <p class="mt-3 max-w-xl text-slate-300">Quick offers, secure payment and nationwide collection &mdash; no need to list it yourself.</p>
          </div>
          <a href="/sell-your-car" class="btn-primary whitespace-nowrap">Get my free valuation</a>
        </div>
      </section>

      <!-- TESTIMONIALS -->
      <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
        <p class="section-eyebrow">What customers say</p>
        <h2 class="text-3xl font-bold text-slate-900">Trusted by drivers across the UK</h2>

        <div class="mt-10 grid gap-6 md:grid-cols-3">
          <blockquote class="card p-6">
            <p class="text-slate-700">&ldquo;Really smooth process from browsing to delivery. The car was exactly as described.&rdquo;</p>
            <footer class="mt-4 text-sm font-semibold text-slate-900">&mdash; Sarah M.</footer>
          </blockquote>
          <blockquote class="card p-6">
            <p class="text-slate-700">&ldquo;Sold my old car in a day with a fair offer and free collection. Couldn't be easier.&rdquo;</p>
            <footer class="mt-4 text-sm font-semibold text-slate-900">&mdash; James T.</footer>
          </blockquote>
          <blockquote class="card p-6">
            <p class="text-slate-700">&ldquo;Great photos and detail on every listing, so there were no surprises when I collected it.&rdquo;</p>
            <footer class="mt-4 text-sm font-semibold text-slate-900">&mdash; Priya K.</footer>
          </blockquote>
        </div>
      </section>
    </main>

    <%- include('partials/footer') %>
    <%- include('partials/whatsapp-float', { car: null }) %>
  </body>
</html>
