<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sell Your <%= landing.make %> <%= landing.model %> | Auto Galleria</title>
  <meta name="description" content="<%= landing.metaDescription || 'Sell your ' + landing.make + ' ' + landing.model + ' quickly with top offers and free pickup from Auto Galleria.' %>">
  <link rel="canonical" href="<%= process.env.SITE_URL %>/sell-your-<%= landing.slug %>">
  <meta property="og:type" content="website">
  <meta property="og:title" content="Sell Your <%= landing.make %> <%= landing.model %> | Auto Galleria">
  <meta property="og:description" content="<%= landing.metaDescription || 'Sell your ' + landing.make + ' ' + landing.model + ' quickly with top offers and free pickup from Auto Galleria.' %>">
  <meta property="og:url" content="<%= process.env.SITE_URL %>/sell-your-<%= landing.slug %>">
  <meta name="twitter:card" content="summary_large_image">
  <% const ogImage = landing.imageManifest && landing.imageManifest.sources && (landing.imageManifest.sources.webp && landing.imageManifest.sources.webp[0] ? landing.imageManifest.sources.webp[0].url : landing.imageManifest.sources.jpg && landing.imageManifest.sources.jpg[0] ? landing.imageManifest.sources.jpg[0].url : landing.imageManifest.base); %>
  <% if (ogImage) { %>
    <meta property="og:image" content="<%= ogImage %>">
    <meta property="og:image:alt" content="<%= landing.heroAltText || landing.make + ' ' + landing.model %>">
  <% } %>
  <link rel="stylesheet" href="/css/tailwind.css">
  
  <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How quickly can I sell my <%= landing.make %> <%= landing.model %>?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We can provide an instant offer for your <%= landing.make %> <%= landing.model %> and arrange free collection within 24 hours."
      }
    },
    {
      "@type": "Question",
      "name": "How quickly will I get paid?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We process full payment before collecting your vehicle."
      }
    },
    {
      "@type": "Question",
      "name": "Do you buy non UK registration <%= landing.make %> <%= landing.model %>?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, we can buy non UK registration <%= landing.make %> <%= landing.model %> and handle import formalities."
      }
    },
    {
      "@type": "Question",
      "name": "Do you buy non-running <%= landing.make %> cars?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, we purchase <%= landing.make %> vehicles even if they are damaged or not running, and collection is always free."
      }
    }
  ]
}
</script>

</head>
<body class="text-gray-800 antialiased bg-gray-100">

  <!-- NAVBAR -->
<%- include('partials/navbar') %>

  <a class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 bg-black text-white px-4 py-2 rounded transition" href="#main-content">Skip to main content</a>
  <main id="main-content" role="main">
    <!-- REG LOOKUP HERO -->
    <section aria-labelledby="lookupHeading" class="relative min-h-[80vh] lg:min-h-[78vh] flex items-center justify-center p-6 text-white overflow-hidden">

  <% if (landing.imageManifest) { %>
    <%- include('partials/hero', { heroImage: landing.imageManifest }) %>
  <% } else { %>
    <div class="absolute inset-0 bg-gray-900" aria-hidden="true"></div>
  <% } %>

  <!-- Dark overlay -->
  <div class="absolute inset-0 bg-black/60 z-10"></div>

  <div class="relative z-20 w-full max-w-md">

    <!-- Header -->
    <div class="mb-8 text-center">
      <h1 id="lookupHeading" class="text-4xl font-bold mb-4 drop-shadow-lg leading-tight">
  Sell Your
  <span class="text-cyan-400"><%= landing.make %> <%= landing.model %></span>
</h1>
      
      <p id="lookupSubtitle" class="text-gray-200">Enter your registration number</p>
    </div>

    <!-- Form -->
    <form id="regForm" class="mb-6">
      <div class="relative">
        <label for="regInput" class="sr-only">Vehicle registration number</label>
        <input
          id="regInput"
          name="reg"
          type="text"
          placeholder="AB12ABC"
          autocomplete="off"
          class="w-full px-6 py-4 rounded-xl bg-white/10 backdrop-blur border-2 border-white/30 text-white uppercase tracking-widest font-semibold focus:outline-none focus:border-blue-400 focus:ring-2 focus:ring-blue-400"
        />
        <button
          type="submit"
          id="submitBtn"
          class="absolute right-2 top-1/2 -translate-y-1/2 w-10 h-10 rounded-lg bg-gradient-to-br from-blue-500 to-cyan-500 text-white"
          aria-label="Lookup registration"
        >
          →
        </button>
      </div>
    </form>
      <p id="lookupTrust" class="mt-2 text-xs text-gray-300 text-center flex items-center justify-center gap-1">
  🔒 Secure lookup • No data stored or shared
</p>
    <!-- Error -->
    <div id="errorBox" class="hidden mb-6 p-4 rounded-xl bg-red-500/20 border border-red-400 text-red-200 text-sm backdrop-blur" role="alert" aria-live="assertive"></div>

    <!-- Result -->
    <div id="resultBox" class="hidden space-y-4 animate-in slide-in-from-bottom fade-in duration-300" role="status" aria-live="polite">

      <div class="p-4 rounded-xl bg-emerald-500/20 border-2 border-emerald-500/30 backdrop-blur flex items-center gap-3">
        <svg class="w-5 h-5 text-emerald-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
        </svg>
        <p id="resultStatus" class="text-emerald-300 text-sm font-medium">Vehicle found</p>
      </div>
      <p id="lookupNotice" class="hidden text-yellow-100 text-sm bg-yellow-500/10 border border-yellow-500/20 rounded-xl p-3">
      </p>

      <div class="p-6 rounded-xl bg-white/10 backdrop-blur border border-white/20 space-y-4">
        <div class="space-y-1">
          <p class="text-slate-300 text-xs font-semibold uppercase tracking-wide">
            Vehicle Details
          </p>
          <h3 id="vehicleTitle" class="text-3xl font-bold text-white"></h3>
          <p id="vehicleModel" class="text-xl text-blue-300 font-semibold"></p>
        </div>

        <div class="grid grid-cols-2 gap-4 pt-4 border-t border-white/20 text-sm">
          <div>
            <p class="text-slate-400 text-xs font-semibold uppercase tracking-wide mb-1">Color</p>
            <p class="text-white font-medium" id="color"></p>
          </div>
          <div>
            <p class="text-slate-400 text-xs font-semibold uppercase tracking-wide mb-1">Fuel Type</p>
            <p class="text-white font-medium" id="fuel"></p>
          </div>
          <div>
            <p class="text-slate-400 text-xs font-semibold uppercase tracking-wide mb-1">Engine Size</p>
            <p class="text-white font-medium" id="engineSize"></p>
          </div>
          <div>
            <p class="text-slate-400 text-xs font-semibold uppercase tracking-wide mb-1">Registration</p>
            <p class="text-white font-mono font-bold text-lg" id="regOut"></p>
          </div>
        </div>
      </div>

      <button
        id="continueBtn"
        type="button"
        aria-controls="lead-form"
        aria-expanded="false"
        class="w-full py-3 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-semibold shadow-lg transition duration-200"
      >
        Continue to Get Offer
      </button>

      <button
        id="resetBtn"
        type="button"
        class="w-full py-3 rounded-lg bg-white/10 hover:bg-white/20 text-white font-semibold transition duration-200"
      >
        Search Again
      </button>
    </div>

  </div>
</section>

<script>
const form = document.getElementById('regForm');
const input = document.getElementById('regInput');
const errorBox = document.getElementById('errorBox');
const resultBox = document.getElementById('resultBox');

const title = document.getElementById('vehicleTitle');
const model = document.getElementById('vehicleModel');
const color = document.getElementById('color');
const fuel = document.getElementById('fuel');
const engineSize = document.getElementById('engineSize');
const regOut = document.getElementById('regOut');
const resultStatus = document.getElementById('resultStatus');
const lookupNotice = document.getElementById('lookupNotice');
const resetBtn = document.getElementById('resetBtn');
const lookupSubtitle = document.getElementById('lookupSubtitle');
const lookupTrust = document.getElementById('lookupTrust');

form.addEventListener('submit', async (e) => {
  e.preventDefault();

  const reg = input.value.toUpperCase().trim();
  errorBox.classList.add('hidden');
  resultBox.classList.add('hidden');

  try {
    const res = await fetch('/api/lookup', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ reg })
    });
    const data = await res.json();

    if (!res.ok) throw new Error(data.error);

    const vehicleTitle = [data.year, data.make].filter(Boolean).join(' ') || reg;
    title.textContent = vehicleTitle;

    if (data.model) {
      model.textContent = data.model;
      model.classList.remove('hidden');
    } else {
      model.textContent = '';
      model.classList.add('hidden');
    }

    if (data.color) {
      color.textContent = data.color;
      document.getElementById('color').closest('div').classList.remove('hidden');
    } else {
      color.textContent = '';
      document.getElementById('color').closest('div').classList.add('hidden');
    }

    if (data.fuelType) {
      fuel.textContent = data.fuelType;
      document.getElementById('fuel').closest('div').classList.remove('hidden');
    } else {
      fuel.textContent = '';
      document.getElementById('fuel').closest('div').classList.add('hidden');
    }

    if (data.engineSize) {
      engineSize.textContent = data.engineSize;
      document.getElementById('engineSize').closest('div').classList.remove('hidden');
    } else {
      engineSize.textContent = '';
      document.getElementById('engineSize').closest('div').classList.add('hidden');
    }

    regOut.textContent = reg;

    if (data.source === 'manual') {
      resultStatus.textContent = 'DVLA lookup unavailable — continue to submit for valuation';
      lookupNotice.textContent = data.message || 'We couldn\'t verify this registration with DVLA. Please continue and we\'ll value it manually.';
      lookupNotice.classList.remove('hidden');
    } else {
      resultStatus.textContent = 'Vehicle found';
      lookupNotice.classList.add('hidden');
    }

    resultBox.classList.remove('hidden');
    form.classList.add('hidden');
    lookupTrust.classList.add('hidden');
    lookupSubtitle.textContent = "Here's your vehicle";

    // Pass vehicle data to the lead form section below
    if (typeof window.setLeadVehicle === 'function') {
      window.setLeadVehicle({
        reg,
        year: data.year,
        make: data.make,
        model: data.model,
        color: data.color,
        engineSize: data.engineSize,
      });
    }

  } catch (err) {
    errorBox.textContent = err.message;
    errorBox.classList.remove('hidden');
  }
});

resetBtn.addEventListener('click', () => {
  input.value = '';
  form.classList.remove('hidden');
  lookupTrust.classList.remove('hidden');
  resultBox.classList.add('hidden');
  errorBox.classList.add('hidden');
  lookupSubtitle.textContent = 'Enter your registration number';
});

const continueBtn = document.getElementById('continueBtn');
if (continueBtn) {
  continueBtn.addEventListener('click', () => {
    // Hide the reg lookup section and reveal the lead form in its place
    const lookupSection = document.querySelector('section:first-of-type');
    lookupSection.classList.add('hidden');
    lookupSection.setAttribute('aria-hidden', 'true');

    const leadForm = document.getElementById('lead-form');
    leadForm.classList.remove('hidden');
    leadForm.setAttribute('aria-hidden', 'false');

    continueBtn.setAttribute('aria-expanded', 'true');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
}
</script>


<!-- ─────────────────────────────────────────────────────────────────────── -->
<!-- SELL ENQUIRY FORM                                                       -->
