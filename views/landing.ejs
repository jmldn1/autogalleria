 <section class="py-16 px-6 bg-gray-50">
  <div class="max-w-6xl mx-auto text-center mb-12">
    <h2 class="text-3xl font-bold"><%= relatedTitle || `Other ${landing.make || 'models'} models we buy` %></h2>
    <p class="text-gray-600"><%= relatedDescription || `Explore other ${landing.make ? landing.make.toLowerCase() : 'vehicles'} models we purchase.` %></p>
  </div>
  <div class="grid gap-8 max-w-6xl mx-auto <%= relatedGridClass %>">
    <% if (relatedItems.length) { %>
      <% relatedItems.forEach((item, index) => {
          const sources = item.imageManifest && item.imageManifest.sources;
          const avifSrcset = sources && sources.avif ? sources.avif.map(img => `${img.url} ${img.w}w`).join(', ') : '';
          const webpSrcset = sources && sources.webp ? sources.webp.map(img => `${img.url} ${img.w}w`).join(', ') : '';
          const fallbackImage =
            (sources && sources.webp && sources.webp[0]) ||
            (sources && sources.jpg && sources.jpg[0]) ||
            null;
          const fallbackUrl = fallbackImage ? fallbackImage.url : '/images/default-car.webp';
          const fallbackWidth = fallbackImage && fallbackImage.w ? fallbackImage.w : 300;
          const fallbackHeight = fallbackImage && fallbackImage.h ? fallbackImage.h : 225;
        %>
        <article class="w-full bg-white rounded-2xl shadow hover:shadow-lg transition overflow-hidden">
          <a href="/sell-your-<%= item.slug %>" class="block">
            <picture>
              <% if (avifSrcset) { %>
                <source type="image/avif" srcset="<%= avifSrcset %>" sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw">
              <% } %>
              <% if (webpSrcset) { %>
                <source type="image/webp" srcset="<%= webpSrcset %>" sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw">
              <% } %>
              <img src="<%= fallbackUrl %>" alt="Sell a <%= item.make %> <%= item.model %>" width="<%= fallbackWidth %>" height="<%= fallbackHeight %>" class="w-full h-48 object-cover" loading="lazy">
            </picture>
          </a>
          <div class="p-6">
            <h3 class="font-semibold text-lg mb-2"><%= item.make %> <%= item.model %></h3>
            <a href="/sell-your-<%= item.slug %>" class="inline-block mt-2 px-4 py-2 bg-blue-600 text-white rounded-xl hover:bg-blue-700 transition">Sell this model</a>
          </div>
        </article>
      <% }) %>
    <% } else { %>
      <div class="col-span-full bg-white rounded-2xl shadow p-8 text-center">
        <p class="text-gray-600">No other <%= landing.make ? landing.make.toLowerCase() : 'vehicles' %> landing pages available yet.</p>
      </div>
    <% } %>
  </div>
</section>
