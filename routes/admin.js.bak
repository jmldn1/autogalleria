const express = require('express');
const router = express.Router();
const { isAdmin } = require('../middleware/auth');
const Landing = require('../models/Landing');
const multer = require('multer');
const path = require('path');
const fs = require('fs');
const { processImage, SIZES } = require('../utils/imageService');
console.log("Imported SIZES:", SIZES); // Debug

// ---------------------- MULTER SETUP ----------------------
const storage = multer.diskStorage({
  destination: (req, file, cb) => cb(null, 'public/uploads'),
  filename: (req, file, cb) => cb(null, Date.now() + path.extname(file.originalname))
});
const upload = multer({ storage });

// ---------------------- DASHBOARD ----------------------
router.get('/dashboard', isAdmin, (req, res) => {
  res.render('admin/dashboard', { user: req.user });
});

// ---------------------- LANDINGS ----------------------
router.get('/landings', isAdmin, async (req, res) => {
  try {
    const landings = await Landing.find().sort({ createdAt: -1 });
    res.render('admin/landings', { user: req.user, landings });
  } catch (err) {
    console.error(err);
    res.redirect('/admin/dashboard');
  }
});

router.get('/landing/new', isAdmin, (req, res) => {
  res.render('admin/landing', {
    user: req.user,
    landing: { make: '', model: '', slug: '', imagePath: '', description: '' }
  });
});

router.post('/landing', isAdmin, upload.single('image'), async (req, res) => {
  try {
    const { make, model, slug, description } = req.body;
    const landing = new Landing({ make, model, slug, description });
    await landing.save();

    if (req.file) {
      const heroInput = req.file.path;
      const outDir = path.join('public/images/landing', landing._id.toString());
      fs.mkdirSync(outDir, { recursive: true });

      const result = await processImage(heroInput, outDir, 'hero', SIZES.hero);
      landing.imagePath = `/images/landing/${landing._id}/hero`;
      landing.placeholder = result.placeholder;
      await landing.save();

      console.log(`Processed image to ${outDir}, variants: ${result.variants.length}`);
      fs.unlinkSync(heroInput); // Delete original
    }

    res.redirect('/admin/landings');
  } catch (err) {
    console.error('Create landing error:', err);
    res.redirect('/admin/landing/new');
  }
});

router.get('/landing/:id/edit', isAdmin, async (req, res) => {
  try {
    const landing = await Landing.findById(req.params.id);
    if (!landing) return res.redirect('/admin/landings');
    res.render('admin/landing', { user: req.user, landing });
  } catch (err) {
    console.error(err);
    res.redirect('/admin/landings');
  }
});

router.post('/landing/:id', isAdmin, upload.single('image'), async (req, res) => {
  try {
    const { make, model, slug, description } = req.body;
    const landing = await Landing.findById(req.params.id);
    if (!landing) return res.redirect('/admin/landings');

    const updateData = { make, model, slug, description };

    if (req.file) {
      const heroInput = req.file.path;
      const outDir = path.join('public/images/landing', landing._id.toString());
      fs.mkdirSync(outDir, { recursive: true });

      // Clear old images
      fs.readdirSync(outDir).forEach(file => fs.unlinkSync(path.join(outDir, file)));

      const result = await processImage(heroInput, outDir, 'hero', SIZES.hero);
      updateData.imagePath = `/images/landing/${landing._id}/hero`;
      updateData.placeholder = result.placeholder;

      console.log(`Processed image to ${outDir}, variants: ${result.variants.length}`);
      fs.unlinkSync(heroInput); // Delete original
    }

    await Landing.findByIdAndUpdate(req.params.id, updateData);
    res.redirect('/admin/landings');
  } catch (err) {
    console.error('Update landing error:', err);
    res.redirect(`/admin/landing/${req.params.id}/edit`);
  }
});

router.get('/landing/:id/delete', isAdmin, async (req, res) => {
  try {
    await Landing.findByIdAndDelete(req.params.id);
    res.redirect('/admin/landings');
  } catch (err) {
    console.error(err);
    res.redirect('/admin/landings');
  }
});

router.get('/cars', isAdmin, async (req, res) => {
  const cars = []; // TODO: fetch cars from DB
  res.render('admin/cars', { user: req.user, cars });
});

router.get('/car/:id/edit', isAdmin, async (req, res) => {
  const car = {}; // TODO: fetch car by ID
  res.render('admin/car', { user: req.user, car });
});

router.get('/users', isAdmin, async (req, res) => {
  const users = []; // TODO: fetch users from DB
  res.render('admin/users', { user: req.user, users });
});

router.get('/user/:id/edit', isAdmin, async (req, res) => {
  const userData = {}; // TODO: fetch user by ID
  res.render('admin/user', { user: req.user, userData });
});

module.exports = router;